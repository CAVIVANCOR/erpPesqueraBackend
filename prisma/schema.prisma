// ============================================
// Percepcion
// Comprobante de Percepción recibido
// ============================================

model Percepcion {
  id                    BigInt      @id @default(autoincrement())
  
  // Documento - Estructura estándar
  empresaId             BigInt
  tipoDocumentoId       BigInt
  serieDocId            BigInt?
  numSerieDoc           String?     @db.VarChar(40)
  numCorreDoc           String?     @db.VarChar(40)
  numeroDocumento       String?     @db.VarChar(40)
  
  // Fechas
  fechaEmision          DateTime
  fechaCobro            DateTime
  
  // Proveedor (quien aplica la percepción)
  proveedorId           BigInt
  tipoDocProveedorId    BigInt
