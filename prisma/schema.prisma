  montoPercepcion           Decimal     @default(0) @db.Decimal(18, 2)  // ✅ AGREGADO
  porcentajePercepcion      Decimal?    @db.Decimal(5, 2)            // ✅ AGREGADO
  numeroComprobantePercepcion String?   @db.VarChar(50)              // ✅ AGREGADO: Comprobante de percepción
  fechaPercepcion           DateTime?                                // ✅ AGREGADO: Fecha de percepción
  
  // ========================================
