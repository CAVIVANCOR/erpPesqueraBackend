  // RELACIONES
  // ========================================
  inversion             InversionFinanciera     @relation(fields: [inversionFinancieraId], references: [id], onDelete: Cascade)
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  asientoContable       AsientoContable?        @relation(fields: [asientoContableId], references: [id])
  personalCreador       Personal?               @relation(fields: [creadoPor], references: [id])
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([inversionFinancieraId])
  @@index([fechaMovimiento])
  @@index([tipoMovimiento])
}

// ============================================
// MODELO: TIPO DE PRESTAMO
// ============================================

model TipoPrestamo {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACION
  // ========================================
  descripcion           String                  @db.VarChar(200)             // DESCRIPCION DEL TIPO DE PRESTAMO
  descripcionCorta      String?                 @db.VarChar(100)             // DESCRIPCION CORTA PARA INTERFAZ DE USUARIO
  
  // ========================================
  // CARACTERISTICAS
  // ========================================
  requiereGarantia      Boolean                 @default(false)              // SI REQUIERE GARANTIA OBLIGATORIA
  esComercioExterior    Boolean                 @default(false)              // SI ES PARA COMERCIO EXTERIOR (COMEX)
  esLeasing             Boolean                 @default(false)              // SI ES TIPO LEASING
  esFactoring           Boolean                 @default(false)              // SI ES FACTORING
  permiteRefinanciar    Boolean                 @default(true)               // SI PERMITE SER REFINANCIADO
  
  // ========================================
  // CONFIGURACION INTERFAZ DE USUARIO
  // ========================================
  severityColor         String?                 @db.VarChar(20)              // COLOR PARA TAG EN INTERFAZ DE USUARIO (INFO, SUCCESS, WARNING, ETCETERA)
  
  // ========================================
  // ESTADO
  // ========================================
  activo                Boolean                 @default(true)               // SI ESTA ACTIVO PARA USAR
  
  // ========================================
  // AUDITORIA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  personalCreador       Personal?               @relation("TipoPrestamoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("TipoPrestamoActualizador", fields: [actualizadoPor], references: [id])
  
  prestamos             PrestamoBancario[]      @relation("PrestamoBancarioTipoPrestamo")
  
  // ========================================
  // INDICES
  // ========================================
  @@index([activo])
  @@index([esComercioExterior])
}

// ============================================
// ENUMS PARA TESORERÍA AVANZADA
// ============================================

enum FrecuenciaPago {
  DIAS                  // Pagos diarios
  MENSUAL              // Pagos mensuales
  BIMESTRAL            // Cada 2 meses
  TRIMESTRAL           // Cada 3 meses
  CUATRIMESTRAL        // Cada 4 meses
  SEMESTRAL            // Cada 6 meses
  ANUAL                // Anual
}

enum TipoAmortizacion {
  FRANCES              // Cuotas fijas (más común)
  ALEMAN               // Amortización constante
  AMERICANO            // Solo intereses, capital al final
}

enum TipoGarantia {
  HIPOTECARIA          // Garantía hipotecaria
  PRENDARIA            // Garantía prendaria (vehículos, maquinaria)
  FIANZA               // Fianza personal o solidaria
  SIN_GARANTIA         // Sin garantía específica
}

enum EstadoPagoCuota {
  PENDIENTE            // Cuota pendiente de pago
  PAGADO               // Cuota pagada completamente
  VENCIDO              // Cuota vencida no pagada
  PARCIAL              // Cuota pagada parcialmente
}

enum TipoLineaCredito {
  REVOLVENTE           // Línea revolvente (se puede usar y devolver)
  CARTA_CREDITO        // Carta de crédito (comercio exterior)
  GARANTIA_BANCARIA    // Garantía bancaria
  SOBREGIRO            // Sobregiro bancario
}

enum TipoInversion {
  PLAZO_FIJO           // Depósito a plazo fijo
  FONDO_MUTUO          // Fondo mutuo
  BONOS                // Bonos corporativos o soberanos
  ACCIONES             // Acciones en bolsa
  CTS                  // CTS empresarial
}

enum TipoMovimientoInversion {
  INVERSION            // Inversión inicial o adicional
  RENDIMIENTO          // Rendimiento generado
  RETIRO               // Retiro parcial
  AJUSTE               // Ajuste de valor
  LIQUIDACION          // Liquidación total
}

enum TipoTasa {
  EFECTIVA_ANUAL       // Tasa efectiva anual (TEA)
  NOMINAL_ANUAL        // Tasa nominal anual (TNA)
  EFECTIVA_MENSUAL     // Tasa efectiva mensual (TEM)
  NOMINAL_MENSUAL      // Tasa nominal mensual (TNM)
  EFECTIVA_DIARIA      // Tasa efectiva diaria (TED)
}

enum PeriodicidadRendimiento {
  VENCIMIENTO          // Pago al vencimiento
  DIARIA               // Capitalizacion diaria
  SEMANAL              // Capitalizacion semanal
  QUINCENAL            // Capitalizacion quincenal
  MENSUAL              // Capitalizacion mensual
  BIMESTRAL            // Capitalizacion bimestral
  TRIMESTRAL           // Capitalizacion trimestral
  CUATRIMESTRAL        // Capitalizacion cuatrimestral
  SEMESTRAL            // Capitalizacion semestral
  ANUAL                // Capitalizacion anual
}

enum TipoDesembolso {
  TOTAL                // Desembolso total del prestamo
  PARCIAL              // Desembolso parcial
  PROGRAMADO           // Desembolso segun cronograma
}

enum TipoGarantiaReal {
  INMUEBLE             // Garantia inmobiliaria
  VEHICULO             // Garantia vehicular
  MAQUINARIA           // Garantia de maquinaria
  INVENTARIO           // Garantia de inventario
  CUENTAS_COBRAR       // Garantia de cuentas por cobrar
  DEPOSITO_PLAZO       // Garantia de deposito a plazo
  VALORES              // Garantia de valores mobiliarios
  OTROS                // Otras garantias reales
}

enum EstadoGarantia {
  VIGENTE              // Garantia vigente
  LIBERADA             // Garantia liberada
  EJECUTADA            // Garantia ejecutada
  VENCIDA              // Garantia vencida
  RENOVADA             // Garantia renovada
}

enum TipoCobro {
  CUOTA_NORMAL         // Cobro de cuota normal
  PREPAGO_PARCIAL      // Prepago parcial del prestamo
  PREPAGO_TOTAL        // Prepago total del prestamo
  MORA                 // Cobro de mora
  COMISION             // Cobro de comision
  SEGURO               // Cobro de seguro
}

enum MetodoPago {
  EFECTIVO             // Pago en efectivo
  TRANSFERENCIA        // Transferencia bancaria
  CHEQUE               // Pago con cheque
  DEBITO_AUTOMATICO    // Debito automatico
  TARJETA_CREDITO      // Tarjeta de credito
  TARJETA_DEBITO       // Tarjeta de debito
}

enum EstadoDesembolso {
  PENDIENTE            // Desembolso pendiente
  PROCESADO            // Desembolso procesado
  CONFIRMADO           // Desembolso confirmado
  RECHAZADO            // Desembolso rechazado
  ANULADO              // Desembolso anulado
}

enum TipoRenovacion {
  AUTOMATICA           // Renovacion automatica
  MANUAL               // Renovacion manual
  SIN_RENOVACION       // Sin renovacion
}