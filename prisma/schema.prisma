// ============================================
// MedioPago - Catálogo de medios de pago
// ============================================

model MedioPago {
  id                    BigInt      @id @default(autoincrement())
  codigo                String      @unique @db.VarChar(20)
  nombre                String      @db.VarChar(100)
  requiereBanco         Boolean     @default(false)
  requiereNumOperacion  Boolean     @default(false)
  activo                Boolean     @default(true)
  
  pagosCobrar           PagoCuentaPorCobrar[]
  pagosPagar            PagoCuentaPorPagar[]
    pagosLetra            PagoLetraCambio[]

  
  @@index([activo])
}


model OrdenCompra {
  id                   BigInt      @id @default(autoincrement())
  empresaId            BigInt
  tipoDocumentoId      BigInt
  serieDocId           BigInt?
  numSerieDoc          String?     @db.VarChar(40)
  numCorreDoc          String?     @db.VarChar(40)
  numeroDocumento      String?
  fechaDocumento       DateTime    @default(now())
  requerimientoCompraId BigInt?
  proveedorId          BigInt
  formaPagoId          BigInt?
  monedaId             BigInt?
  tipoCambio           Decimal?
  fechaEntrega         DateTime?
  fechaRecepcion       DateTime?
  solicitanteId        BigInt?
  aprobadoPorId        BigInt?
  estadoId             BigInt
  centroCostoId        BigInt?
  movIngresoAlmacenId  BigInt?
  observaciones        String?     @db.Text
  urlOrdenCompraPdf    String?
  creadoEn             DateTime    @default(now())
  actualizadoEn        DateTime    @updatedAt
  creadoPor            BigInt?
  actualizadoPor       BigInt?
  porcentajeIGV        Decimal?
  esExoneradoAlIGV     Boolean?    @default(false)
  
  // ========================================
  // ⭐ CAMPOS NUEVOS - DOCUMENTO FINAL (COMPROBANTE DEL PROVEEDOR)
  // Define qué comprobante se recibirá del proveedor
  // ========================================
  tipoDocumentoFinalId        BigInt?                                    // ⭐ NUEVO: Tipo recibido (01=Factura, 03=Boleta)
  numeroDocumentoFinal        String?     @db.VarChar(40)                // ⭐ NUEVO: Número completo del comprobante recibido (ej: "F001-00000456")
  numSerieDocFinal            String?     @db.VarChar(40)                // ⭐ NUEVO: Serie recibida (ej: "F001")
  numCorreDocFinal            String?     @db.VarChar(40)                // ⭐ NUEVO: Correlativo recibido (ej: "00000456")
  comprobanteRecibido         Boolean?    @default(false)                // ⭐ NUEVO: true = Ya se recibió el comprobante
  fechaRecepcionComprobante   DateTime?                                  // ⭐ NUEVO: Fecha de recepción del comprobante
  facturado                   Boolean?    @default(false)                // ⭐ NUEVO: true = Ya se generó CxP (Negra o Blanca)
  fechaFacturacion            DateTime?                                  // ⭐ NUEVO: Fecha de generación de CxP
  
  // ========================================
  // ⭐ CAMPOS NUEVOS - TIPO DE FACTURACIÓN Y PARTICIÓN
  // ========================================
  esGerencial                 Boolean?    @default(false)                // ⭐ NUEVO: true = Compra Negra (Gerencial/No SUNAT), false = Blanca (Formal/SUNAT)
  ordenCompraOrigenId         BigInt?                                    // ⭐ NUEVO: ID de la OC original si esta fue creada por partición
  esParticionada              Boolean     @default(false)                // ⭐ NUEVO: true = Esta OC fue partida en Blanca/Negra (se anula y crea 2 nuevas)

  direccionRecepcionAlmacenId BigInt?
  contactoProveedorId         BigInt?
  
  // ========================================
  // RELACIONES EXISTENTES
  // ========================================
  requerimientoCompra  RequerimientoCompra? @relation(fields: [requerimientoCompraId], references: [id])
  proveedor            EntidadComercial @relation("ProveedorOrdenCompra", fields: [proveedorId], references: [id])
  formaPago            FormaPago? @relation(fields: [formaPagoId], references: [id])
  tipoDocumento        TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc             SerieDoc? @relation(fields: [serieDocId], references: [id])
  empresa              Empresa @relation(fields: [empresaId], references: [id])
  moneda               Moneda? @relation(fields: [monedaId], references: [id])
  estado               EstadoMultiFuncion @relation(fields: [estadoId], references: [id])
  insumosOT            DetInsumosTareaOT[] @relation("OCInsumoOT")
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - COMPROBANTE DEL PROVEEDOR
  // ========================================
  tipoDocumentoFinal   TipoDocumento?          @relation("TipoDocumentoFinalOC", fields: [tipoDocumentoFinalId], references: [id])  // ⭐ NUEVO
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - PARTICIÓN
  // ========================================
  ordenCompraOrigen    OrdenCompra?            @relation("ParticionOrdenCompra", fields: [ordenCompraOrigenId], references: [id])  // ⭐ NUEVO: OC madre
  ordenesCompraHijas   OrdenCompra[]           @relation("ParticionOrdenCompra")                                                    // ⭐ NUEVO: OCs hijas (Blanca y Negra)
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - MÓDULO FINANCIERO
  // ========================================
  cuentaPorPagar       CuentaPorPagar?                                                                                              // ⭐ NUEVO: 1:1 - Cuenta por pagar generada
  
  percepciones         Percepcion[]
  datosAdicionales     DetDatosAdicionalesOrdenCompra[]
  detalles             DetalleOrdenCompra[]
  
  // ========================================
  // ÍNDICES EXISTENTES
  // ========================================
  @@index([empresaId, fechaDocumento])
  @@index([estadoId])
  @@index([proveedorId])
  @@index([requerimientoCompraId])
  @@index([comprobanteRecibido])                                         // YA EXISTE
  @@index([tipoDocumentoFinalId])                                        // YA EXISTE
  
  // ========================================
  // ⭐ ÍNDICES NUEVOS
  // ========================================
  @@index([facturado])                                                   // ⭐ NUEVO: Filtrar pendientes de facturar
  @@index([esGerencial])                                                 // ⭐ NUEVO: Filtrar Gerenciales (Negras) vs Formales (Blancas)
  @@index([ordenCompraOrigenId])                                         // ⭐ NUEVO: Trazabilidad de particiones
  @@index([esParticionada])                                              // ⭐ NUEVO: Filtrar OCs particionadas
}


// ============================================
// DetDatosAdicionalesOrdenCompra
// Almacena datos y documentos adicionales
// requeridos por entidades del estado
// ============================================
model DetDatosAdicionalesOrdenCompra {
  id                    BigInt      @id @default(autoincrement())
  ordenCompraId         BigInt
  
  // Identificación del dato
  nombreDato            String      @db.VarChar(200)         // "Guía de Remisión", "CLP", "Fecha de Cosecha"
  esDocumento           Boolean     @default(false)          // true = tiene archivo adjunto
  imprimirEnOC          Boolean     @default(false)          // true = se imprime en el PDF de la OC
  
  // Valor del dato
  valorDato             String?     @db.Text                 // Para datos de texto o fechas en formato string
  
  // Documento adjunto (si esDocumento = true)
  urlDocumento          String?                      // Ruta del archivo adjunto
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  actualizadoPor        BigInt?
  
  // Relación
  ordenCompra           OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  
  @@index([ordenCompraId])
  @@index([esDocumento])
  @@index([imprimirEnOC])
}




// ============================================
// FlujoCajaProyectado
// Proyección mensual de ingresos y egresos
// Se basa en CuentasPorCobrar/Pagar y proyecciones
// ============================================

model FlujoCajaProyectado {
  id                    BigInt      @id @default(autoincrement())
  empresaId             BigInt
  periodo               String      @db.VarChar(7)      // YYYY-MM
  fechaProyeccion       DateTime    @default(now())
  
  estadoId              BigInt      // BORRADOR, APROBADO, CERRADO
  aprobadoPor           BigInt?
  fechaAprobacion       DateTime?
  observaciones         String?     @db.Text
  
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  
  empresa               Empresa             @relation(fields: [empresaId], references: [id])
  estado                EstadoMultiFuncion  @relation(fields: [estadoId], references: [id])
  aprobador             Personal?           @relation(fields: [aprobadoPor], references: [id])
  
  detalles              DetalleFlujoCajaProyectado[]
  
  @@unique([empresaId, periodo])
  @@index([empresaId, periodo])
  @@index([estadoId])
}

// ============================================
// DetalleFlujoCajaProyectado
// Líneas de proyección
// ============================================

model DetalleFlujoCajaProyectado {
  id                    BigInt      @id @default(autoincrement())
  flujoCajaProyectadoId BigInt
  fecha                 DateTime
  tipoMovimiento        String      @db.VarChar(10)     // INGRESO, EGRESO
  concepto              String      @db.VarChar(200)
  monto                 Decimal     @db.Decimal(18, 2)
  monedaId              BigInt
  
  // Origen (opcional)
  cuentaPorCobrarId     BigInt?
  cuentaPorPagarId      BigInt?
  
  esRecurrente          Boolean     @default(false)
  observaciones         String?     @db.Text
  
  flujoCajaProyectado   FlujoCajaProyectado     @relation(fields: [flujoCajaProyectadoId], references: [id], onDelete: Cascade)
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  cuentaPorCobrar       CuentaPorCobrar?        @relation(fields: [cuentaPorCobrarId], references: [id])
  cuentaPorPagar        CuentaPorPagar?         @relation(fields: [cuentaPorPagarId], references: [id])
  
  @@index([flujoCajaProyectadoId])
  @@index([fecha])
}

// ============================================
// ConciliacionBancaria
// Conciliación mensual de cuentas bancarias
// Compara MovimientoCaja vs Estado de Cuenta Banco
// ============================================

model ConciliacionBancaria {
  id                    BigInt      @id @default(autoincrement())
  empresaId             BigInt
  cuentaCorrienteId     BigInt
  periodo               String      @db.VarChar(7)      // YYYY-MM
  fechaConciliacion     DateTime    @default(now())
  
