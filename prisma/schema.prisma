generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccesoInstalacion {
  id                          BigInt                     @id @default(autoincrement())
  sedeId                      BigInt
  areaDestinoVisitaId         BigInt?
  empresaId                   BigInt?
  tipoAccesoId                BigInt
  tipoPersonaId               BigInt?                    // ✅ YA EXISTE - Usa tu catálogo TipoPersona
  motivoId                    BigInt?
  tipoEquipoId                BigInt?
  fechaHora                   DateTime
  nombrePersona               String?
  tipoDocIdentidadId          BigInt?
  numeroDocumento             String?
  
  // ========================================
  // ⭐ CAMPO NUEVO - PERSONA QUE INGRESA
  // ========================================
  personalIngresoId           BigInt?                    // ⭐ NUEVO - ID del personal que ingresa (si trabaja en la empresa)
  // ========================================
  
  vehiculoNroPlaca            String?
  vehiculoMarca               String?
  equipoMarca                 String?
  equipoSerie                 String?
  
  // ========================================
  // ⭐ CAMPOS NUEVOS PARA DESTINO DE VISITA
  // ========================================
  personalDestinoId           BigInt?                    // ⭐ AHORA OPCIONAL - Solo para visitas a personal interno
  entidadComercialId          BigInt?                    // ⭐ NUEVO - Cliente/Arrendatario a visitar
  contactoEntidadId           BigInt?                    // ⭐ NUEVO - Contacto específico del cliente
  // ========================================
  
  personaFirmaDestinoVisitaId BigInt?
  observaciones               String?
  incidenteResaltante         Boolean                    @default(false)
  descripcionIncidente        String?
  imprimeTicketIng            Boolean                    @default(false)
  urlImpresionTicket          String?
  urlDocumentoVisitante       String?
  createdAt                   DateTime                   @default(now())
  vehiculoColor               String?
  vehiculoModelo              String?
  accesoSellado               Boolean                    @default(false)
  fechaHoraSalidaDefinitiva   DateTime?

  // ========================================
  // RELACIONES EXISTENTES
  // ========================================
  tipoAcceso         TipoAccesoInstalacion @relation(fields: [tipoAccesoId], references: [id])
  tipoPersona        TipoPersona?          @relation(fields: [tipoPersonaId], references: [id])
  motivoAcceso       MotivoAcceso?         @relation(fields: [motivoId], references: [id])
  tipoEquipo         TipoEquipo?           @relation(fields: [tipoEquipoId], references: [id])
  detalles           AccesoInstalacionDetalle[]
  
  // ========================================
  // ⭐ RELACIONES NUEVAS
  // ========================================
  personalIngreso    Personal?             @relation("AccesoPersonalIngreso", fields: [personalIngresoId], references: [id])
  personalDestino    Personal?             @relation("AccesoPersonalDestino", fields: [personalDestinoId], references: [id])
  entidadComercial   EntidadComercial?     @relation("AccesoEntidadComercial", fields: [entidadComercialId], references: [id])
  contactoEntidad    ContactoEntidad?      @relation("AccesoContactoEntidad", fields: [contactoEntidadId], references: [id])
  // ========================================
}

model AccesoInstalacionDetalle {
  id                   BigInt               @id @default(autoincrement())
  accesoInstalacionId  BigInt
  fechaHora            DateTime
  tipoMovimientoId     BigInt
  areaDestinoVisitaId  BigInt?
  observaciones        String?
  createdAt            DateTime             @default(now())

  accesoInstalacion    AccesoInstalacion @relation(fields: [accesoInstalacionId], references: [id])
  tipoMovimiento       TipoMovimientoAcceso @relation(fields: [tipoMovimientoId], references: [id])
}


model AccionesPreviasFaena {
  id                             BigInt                           @id @default(autoincrement())
  nombre                         String                           @db.VarChar(100)
  descripcion                    String?
  activo                         Boolean                          @default(true)
  paraPescaConsumo               Boolean                          @default(false)
  paraPescaIndustrial            Boolean                          @default(false)

  detalles    DetAccionesPreviasFaena[]
  detallesConsumo DetAccionesPreviasFaenaConsumo[]
}


model Activo {
  id                   BigInt                 @id @default(autoincrement())
  empresaId            BigInt
  tipoId               BigInt
  nombre               String
  descripcion          String?
  cesado               Boolean                @default(false)
  
  // ========================================
  // 🆕 CAMPOS PARA SALDOS INICIALES
  // ========================================
  fechaAdquisicion         DateTime?              // Fecha de compra del activo
  costoOriginal            Decimal?               @db.Decimal(18, 2)  // Costo de adquisición
  depreciacionAcumulada    Decimal?               @db.Decimal(18, 2)  // Depreciación acumulada al 31/12/2025
  vidaUtilAnios            Int?                   // Vida útil en años
  monedaId                 BigInt?                // Moneda del costo
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime

  tipo                          TipoActivo @relation(fields: [tipoId], references: [id])
  moneda                        Moneda?    @relation(fields: [monedaId], references: [id])  // 🆕 RELACIÓN
  permisos                      DetallePermisoActivo[]
  embarcacion                   Embarcacion?
  ordenesMantenimiento          OTMantenimiento[]
  contratosServicio             ContratoServicio[]    @relation("ContratoServicioActivo")
  detallesAsientosContables     DetalleAsientoContable[]
  contratistasOT                DetContratistasOT[] @relation("ActivoContratistaOT")
  movimientosActivoFijo         MovimientoActivoFijo[]  // 🆕 RELACIÓN
}

model AgrupacionEntidad {
  id               BigInt             @id @default(autoincrement())
  nombre           String             @db.VarChar(100)
  descripcion      String?
  esCliente        Boolean            @default(false)
  esProveedor      Boolean            @default(false)

  entidades   EntidadComercial[]
}

model TipoMovimientoActivoFijo {
  id                    BigInt                  @id @default(autoincrement())
  nombre                String                  @db.VarChar(50)
  descripcion           String?
  activo                Boolean                 @default(true)
  
  movimientos           MovimientoActivoFijo[]
}

model MovimientoActivoFijo {
  id                    BigInt    @id @default(autoincrement())
  empresaId             BigInt
  activoId              BigInt
  tipoMovimientoId      BigInt
  periodoContableId     BigInt    // 🆕 NUEVO CAMPO
  
  fechaMovimiento       DateTime
  fechaContable         DateTime?
  monto                 Decimal   @db.Decimal(18, 2)
  monedaId              BigInt
  
  depreciacionMensual   Decimal?  @db.Decimal(18, 2)
  depreciacionAcumulada Decimal?  @db.Decimal(18, 2)
  valorNeto             Decimal?  @db.Decimal(18, 2)
  
  observaciones         String?
  centroCostoId         BigInt?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  creadoPor             BigInt
  actualizadoPor        BigInt

  // Relaciones
  empresa             Empresa                     @relation(fields: [empresaId], references: [id])
  activo              Activo                      @relation(fields: [activoId], references: [id])
  tipoMovimiento      TipoMovimientoActivoFijo    @relation(fields: [tipoMovimientoId], references: [id])
  periodoContable     PeriodoContable             @relation(fields: [periodoContableId], references: [id])  // 🆕 NUEVA RELACIÓN
  moneda              Moneda                      @relation(fields: [monedaId], references: [id])
  centroCosto         CentroCosto?                @relation(fields: [centroCostoId], references: [id])
  asientosContables   AsientoContable[]           // Relación inversa - Asientos generados

  @@index([empresaId])
  @@index([activoId])
  @@index([periodoContableId])  // 🆕 NUEVO ÍNDICE
  @@index([fechaMovimiento])
}

/// Modelo centralizado para almacenar archivos adjuntos PDF de cualquier submódulo del ERP Megui.
/// Permite asociar cada archivo a un proceso origen (empresa, pesca, proveedor, etc.) mediante subModuloId.
model ArchivoAdjunto {
  id             BigInt   @id @default(autoincrement()) // Identificador único del archivo adjunto
  nombreArchivo  String   // Nombre físico del archivo almacenado (ej: permiso-2025-1623456789.pdf)
  rutaRelativa   String   // Ruta relativa de almacenamiento (ej: /uploads/adjuntos/empresa-23/permiso-2025-1623456789.pdf)
  fechaSubida    DateTime @default(now()) // Fecha y hora de subida del archivo
  empresaId      BigInt   // Identificador de la empresa a la que pertenece el archivo adjunto
  subModuloId    BigInt   // Identificador del submódulo o proceso origen (ej: id de pesca, id de empresa, id de proveedor, etc.)
  usuarioSubioId BigInt?  // Usuario que subió el archivo (opcional)
}

model AreaFisicaSede {
  id           BigInt       @id @default(autoincrement())
  sedeId       BigInt
  nombre       String
  descripcion  String?
  cesado       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime

  sede        SedesEmpresa @relation(fields: [sedeId], references: [id])
}

model AsientoContableInterfaz {
  id                    BigInt         @id @default(autoincrement())
  
  // ========================================
  // 🆕 ORIGEN GENÉRICO DEL ASIENTO
  // ========================================
  submoduloId           BigInt?        // 🆕 ID del submódulo origen
  procesoOrigenId       BigInt?        // 🆕 ID del registro origen
  
  // ========================================
  // DATOS CONTABLES
  // ========================================
  fechaContable         DateTime
  cuentaContable        String
  descripcion           String?
  debe                  Decimal
  haber                 Decimal
  monedaId              BigInt
  empresaId             BigInt
  
  // ========================================
  // 🆕 CENTRO DE COSTO
  // ========================================
  centroCostoId         BigInt?        // 🆕 Para trazabilidad contable
  
  // ========================================
  // REFERENCIAS ADICIONALES
  // ========================================
  referenciaExtId       String?
  medioPagoId           BigInt?
  
  // ========================================
  // WORKFLOW
  // ========================================
  estado                String         @default("PENDIENTE")
  fechaEnvio            DateTime?
  creadoEn              DateTime       @default(now())
  enviadoPorId          BigInt?
  mensajeError          String?        @db.Text
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                       @relation(fields: [empresaId], references: [id])
  moneda                Moneda                        @relation(fields: [monedaId], references: [id])
  centroCosto           CentroCosto?                  @relation(fields: [centroCostoId], references: [id])
  submoduloSistema      SubmoduloSistema?             @relation(fields: [submoduloId], references: [id])
  personalEnviador      Personal?                     @relation("AsientoContableEnviadoPorId", fields: [enviadoPorId], references: [id])
  medioPago             MedioPago? @relation(fields: [medioPagoId], references: [id])

  // ========================================
  // ÍNDICES
  // ========================================
  @@index([estado])
  @@index([fechaContable])
  @@index([submoduloId, procesoOrigenId])
  @@index([empresaId])
  @@index([enviadoPorId])
  @@index([centroCostoId])
}

