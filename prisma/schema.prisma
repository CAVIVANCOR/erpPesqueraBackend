  id               BigInt     @id @default(autoincrement())
  esMedidaMetrica  Boolean    @default(false)
  factorConversion Decimal?

  productos              Producto[]      @relation("UnidadMedidaToProducto")
  productosComerciales   Producto[]      @relation("UnidadMedidaComercialToProducto")  // ⭐ NUEVO: Productos que usan esta unidad para ventas
  // ========================================
  // ⭐ RELACIONES NUEVAS - MÓDULO FINANCIERO
  // ========================================
  detallesComprobante             DetalleComprobante[]
}

model Usuario {
  id                BigInt           @id @default(autoincrement())
  username          String           @unique
  passwordHash      String
  fechaCreacion     DateTime         @default(now())
  fechaUltimoAcceso DateTime?
  personalId        BigInt?          @unique
  empresaId         BigInt
  esAdmin           Boolean          @default(false)
  esSuperUsuario    Boolean          @default(false)
  esUsuario         Boolean          @default(true)
  activo            Boolean          @default(true)   // Estado del usuario en el sistema
  intentosFallidos  Int              @default(0)      // Seguridad: bloqueo por intentos
  bloqueadoHasta    DateTime?        // Seguridad: bloqueo temporal
  motivoInactivacion String?         // Razón de desactivación (opcional)
  inactivadoPor     BigInt?          // Quién desactivó (auditoría)
  fechaInactivacion DateTime?        // Cuándo se desactivó
  dashboardPorDefecto  String  @default("modular")  @db.VarChar(60)

  personal          Personal? @relation(fields: [personalId], references: [id])
  empresa           Empresa @relation(fields: [empresaId], references: [id])
  accesosUsuario    AccesosUsuario[]
  refreshTokens     RefreshToken[]
  notificaciones        Notificacion[]

  
  @@index([empresaId])
  @@index([personalId])
  @@index([activo])
  @@index([username])
}

model ContratoServicio {
  id                      BigInt                @id @default(autoincrement())
  
  // Relaciones Organizacionales
  empresaId               BigInt
  sedeId                  BigInt
  activoId                BigInt?
  almacenId               BigInt
  clienteId               BigInt
  contactoClienteId       BigInt?
  
  // Responsables
  responsableId           BigInt
  aprobadorId             BigInt?
  
  // Documento
  tipoDocumentoId         BigInt
  serieDocId              BigInt
  numeroSerie             String                @db.VarChar(10)
  numeroCorrelativo       Int
  numeroCompleto          String                @db.VarChar(20)
  
  // Fechas
  fechaCelebracion        DateTime
  fechaInicioContrato     DateTime
  fechaFinContrato        DateTime?
  fechaInicioCobro        DateTime
  periodicidadCobro       Int                   @default(1)
  
  // Contenido
  textoEsenciaContrato    String                @db.Text
  urlContratoPdf          String?               @db.VarChar(500)
  
  // Configuración de Luz
  incluyeLuz              Boolean               @default(false)
  porcentajeRecargoLuz    Decimal?              @db.Decimal(5, 2)
  costoPorKilovatio       Decimal?              @db.Decimal(10, 4)
  
  // Financiero
  monedaId                BigInt
  tipoCambio              Decimal               @db.Decimal(10, 4)
  estadoContratoId        BigInt
  
  // Auditoría
  creadoPor               BigInt?
  creadoEn                DateTime              @default(now())
  actualizadoPor          BigInt?
  actualizadoEn           DateTime              @updatedAt
  unidadNegocioId   BigInt?

  
  // Relaciones
  empresa                 Empresa               @relation("ContratoServicioEmpresa", fields: [empresaId], references: [id])
  sede                    SedesEmpresa          @relation("ContratoServicioSede", fields: [sedeId], references: [id])
  activo                  Activo?               @relation("ContratoServicioActivo", fields: [activoId], references: [id])
  almacen                 Almacen               @relation("ContratoServicioAlmacen", fields: [almacenId], references: [id])
  cliente                 EntidadComercial      @relation("ContratoServicioCliente", fields: [clienteId], references: [id])
  contactoCliente         ContactoEntidad?      @relation("ContratoServicioContacto", fields: [contactoClienteId], references: [id])
  responsable             Personal              @relation("ContratoServicioResponsable", fields: [responsableId], references: [id])
  aprobador               Personal?             @relation("ContratoServicioAprobador", fields: [aprobadorId], references: [id])
  tipoDocumento           TipoDocumento         @relation("ContratoServicioTipoDoc", fields: [tipoDocumentoId], references: [id])
  serieDoc                SerieDoc              @relation("ContratoServicioSerie", fields: [serieDocId], references: [id])
  moneda                  Moneda                @relation("ContratoServicioMoneda", fields: [monedaId], references: [id])
  estadoContrato          EstadoMultiFuncion    @relation("EstadoContratoServicio", fields: [estadoContratoId], references: [id])
  entregaARendir          EntregaARendirContratoServicios? @relation("EntregaRendirContrato")
  detallesServicios       DetServicioContrato[]
  prefacturas             PreFactura[]          @relation("PreFacturaContrato")
  unidadNegocio     UnidadNegocio? @relation(fields: [unidadNegocioId], references: [id])

  @@index([empresaId, clienteId])
  @@index([almacenId])
  @@index([estadoContratoId])
  @@index([fechaInicioCobro])
  @@index([responsableId])
  @@index([unidadNegocioId])

}

model DetServicioContrato {
  id                      BigInt                @id @default(autoincrement())
  contratoServicioId      BigInt
  productoServicioId      BigInt                // Producto que representa el servicio
  
  // Datos del Servicio
  cantidad                Decimal               @db.Decimal(18, 4)
  valorVentaUnitario      Decimal               @db.Decimal(18, 4)
  incluyeLuz              Boolean               @default(false)
  
  // Auditoría
  creadoPor               BigInt?
  creadoEn                DateTime              @default(now())
  actualizadoPor          BigInt?
  actualizadoEn           DateTime              @updatedAt
  
  // Relaciones
  contratoServicio        ContratoServicio      @relation(fields: [contratoServicioId], references: [id], onDelete: Cascade)
  productoServicio        Producto              @relation("ServicioContrato", fields: [productoServicioId], references: [id])
  
  @@index([contratoServicioId])
  @@index([productoServicioId])
}

model Videoconferencia {
  id                BigInt      @id @default(autoincrement())
  
  // Campos propios
  titulo            String
  descripcion       String?
  salaId            String      @unique
  fechaInicio       DateTime
  duracionMinutos   Int
  estado            EstadoReunion @default(PROGRAMADA)
  grabarSesion      Boolean     @default(false)
  salaEspera        Boolean     @default(true)
  permitirPantalla  Boolean     @default(true)
  
  // Auditoría
  fechaCreacion     DateTime    @default(now())
  fechaActualizacion DateTime?  @updatedAt
  creadoPor         BigInt?
  actualizadoPor    BigInt?
  
  // Claves foráneas
  organizadorId     BigInt
  
  // Relaciones
  organizador       Personal    @relation("OrganizadorReunion", fields: [organizadorId], references: [id])
  participantes     ParticipanteReunion[]
  grabaciones       GrabacionReunion[]
  
  // Índices
  @@index([organizadorId])
  @@index([fechaInicio])
  @@index([estado])
}

model ParticipanteReunion {
  id                BigInt      @id @default(autoincrement())
  
  // Campos propios
  rol               RolParticipante @default(PARTICIPANTE)
  confirmado        Boolean     @default(false)
  asistio           Boolean     @default(false)
  horaIngreso       DateTime?
  horaSalida        DateTime?
  
  // Claves foráneas
  videoconferenciaId BigInt
  personalId        BigInt
  
  // Relaciones
  videoconferencia  Videoconferencia @relation(fields: [videoconferenciaId], references: [id])
  personal          Personal    @relation(fields: [personalId], references: [id])
  
  // Índices y restricciones
  @@unique([videoconferenciaId, personalId])
  @@index([videoconferenciaId])
  @@index([personalId])
}

model GrabacionReunion {
  id                BigInt      @id @default(autoincrement())
  
  // Campos propios
  nombreArchivo     String
  rutaArchivo       String
  duracionSegundos  Int
  tamanoBytes       BigInt
  fechaGrabacion    DateTime    @default(now())
  
  // Claves foráneas
  videoconferenciaId BigInt
  
  // Relaciones
  videoconferencia  Videoconferencia @relation(fields: [videoconferenciaId], references: [id])
  
  // Índices
  @@index([videoconferenciaId])
}

enum EstadoReunion {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum RolParticipante {
  MODERADOR
  PARTICIPANTE
  INVITADO
}

// ============================================
// SISTEMA DE NOTIFICACIONES
// ============================================

model Notificacion {
  id                    BigInt   @id @default(autoincrement())
  usuarioId             BigInt
  tipo                  TipoNotificacion
  titulo                String   @db.VarChar(200)
  mensaje               String   @db.Text
  leida                 Boolean  @default(false)
  fechaLeida            DateTime?
  
  // Datos de referencia (para navegación)
  referenciaId          BigInt?
  referenciaTabla       String?  @db.VarChar(50)
  urlDestino            String?  @db.VarChar(500)
  
  // Metadata adicional (JSON)
  metadata              Json?
  
  // Auditoría
  fechaCreacion         DateTime @default(now())
  fechaExpiracion       DateTime?
  
  // Relaciones
  usuario               Usuario  @relation(fields: [usuarioId], references: [id])
  
  @@index([usuarioId, leida])
  @@index([fechaCreacion])
  @@map("notificacion")
}

enum TipoNotificacion {
  VIDEOCONFERENCIA_INVITACION
  VIDEOCONFERENCIA_RECORDATORIO_24H
  VIDEOCONFERENCIA_RECORDATORIO_1H
  VIDEOCONFERENCIA_INICIADA
  VIDEOCONFERENCIA_CANCELADA
  SISTEMA_GENERAL
  APROBACION_PENDIENTE
  DOCUMENTO_APROBADO
  DOCUMENTO_RECHAZADO
}




// ============================================
// MÓDULO FINANCIERO - CONTABILIDAD GENERAL
// MODELO 1.1: Plan de Cuentas Contable
// ============================================

model PlanCuentasContable {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  codigoCuenta          String                  @db.VarChar(20)      // "10", "101", "1011", "10111", "101110"
  nombreCuenta          String                  @db.VarChar(200)     // "Efectivo y Equivalentes de Efectivo"
  descripcion           String?                 @db.Text
  
  // ========================================
  // JERARQUÍA (5 niveles PCGE)
  // ========================================
  nivel                 NivelCuentaContable                          // CLASE | CUENTA | SUBCUENTA | DIVISIONARIA | SUBDIVISIONARIA
  cuentaPadreId         BigInt?                                      // Relación jerárquica
  
  // ========================================
  // NATURALEZA CONTABLE
  // ========================================
  naturaleza            NaturalezaCuenta                             // DEUDORA | ACREEDORA
  
  // ========================================
  // CONTROL DE USO
  // ========================================
  esImputable           Boolean                 @default(false)      // true = permite movimientos, false = solo agrupación
  requiereCentroCosto   Boolean                 @default(false)      // Obligatorio para cuentas de gastos
  requiereEntidad       Boolean                 @default(false)      // Obligatorio para cuentas de terceros (clientes/proveedores)
  requiereProyecto      Boolean                 @default(false)      // Para control de proyectos
  
  // ========================================
  // CLASIFICACIÓN
  // ========================================
  tipoCuenta            TipoCuentaContable?                          // ACTIVO | PASIVO | PATRIMONIO | INGRESO | GASTO
  esActivoCorriente     Boolean                 @default(false)
  esActivoNoCorriente   Boolean                 @default(false)
  esPasivoCorriente     Boolean                 @default(false)
  esPasivoNoCorriente   Boolean                 @default(false)
  
  // ========================================
  // ESTADO
  // ========================================
  activo                Boolean                 @default(true)       // true = activo, false = inactivo
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  

  // ========================================
  // RELACIONES
  // ========================================
  cuentaPadre           PlanCuentasContable?    @relation("JerarquiaCuentas", fields: [cuentaPadreId], references: [id])
  subcuentas            PlanCuentasContable[]   @relation("JerarquiaCuentas")
  
  detallesAsientos              DetalleAsientoContable[]
  lineasPresupuesto             LineaPresupuesto[]
  ejecucionesPresupuestales     EjecucionPresupuestal[]
  configuracionesDebe           ConfiguracionCuentaContable[]  @relation("CuentaDebe")
  configuracionesHaber          ConfiguracionCuentaContable[]  @relation("CuentaHaber")
  cuentasCorrientes             CuentaCorriente[]       @relation("CuentaCorrientePlanContable")
  // 🆕 RELACIONES CON TIPO ACTIVO
  tiposActivoActivo               TipoActivo[]  @relation("TipoActivoCuentaActivo")
  tiposActivoDepreciacion         TipoActivo[]  @relation("TipoActivoCuentaDepreciacion")
  tiposActivoDepreciacionAcum     TipoActivo[]  @relation("TipoActivoCuentaDepAcum")
  tiposDeudaTributaria            TipoDeudaTributaria[]     // 🆕 AGREGAR ESTA LÍNEA
  tiposDeudaPersonal    TipoDeudaPersonal[]     @relation("TipoDeudaPersonalToCuentaContable")  // ⭐ NUEVO: Tipos de deuda personal que usan esta cuenta
  centrosCosto          CentroCosto[]           @relation("CentroCostoToCuentaContable")        // ⭐ NUEVO
// ========================================
// 🆕 RELACIONES CON PRODUCTOS (INVENTARIO)
// ========================================
productosCompras      Producto[]              @relation("ProductoCuentaCompras")              // Productos que usan esta cuenta para COMPRAS (60)
productosInventario   Producto[]              @relation("ProductoCuentaInventario")           // Productos que usan esta cuenta para INVENTARIO (20)
productosCostoVentas  Producto[]              @relation("ProductoCuentaCostoVentas")          // Productos que usan esta cuenta para COSTO VENTAS (69)
productosVariacion    Producto[]              @relation("ProductoCuentaVariacion")            // Productos que usan esta cuenta para VARIACIÓN (61)

  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([codigoCuenta])
  @@index([codigoCuenta])
  @@index([nivel])
  @@index([esImputable])
  @@index([activo])
}

// ============================================
// ENUMS PARA PLAN DE CUENTAS
// ============================================

enum NivelCuentaContable {
  CLASE              // Nivel 1: "10" - Efectivo y Equivalentes
  CUENTA             // Nivel 2: "101" - Caja
  SUBCUENTA          // Nivel 3: "1011" - Caja MN
  DIVISIONARIA       // Nivel 4: "10111" - Caja MN Sede Principal
  SUBDIVISIONARIA    // Nivel 5: "101110" - Caja MN Sede Principal Turno Mañana
}

enum NaturalezaCuenta {
  DEUDORA            // Aumenta con DEBE, disminuye con HABER (Activos, Gastos)
  ACREEDORA          // Aumenta con HABER, disminuye con DEBE (Pasivos, Patrimonio, Ingresos)
}

enum TipoCuentaContable {
  ACTIVO             // Cuentas 10-19, 20-29, 30-39
  PASIVO             // Cuentas 40-49
  PATRIMONIO         // Cuentas 50-59
  INGRESO            // Cuentas 70-79
  GASTO              // Cuentas 60-69, 90-99
}



// ============================================
// MÓDULO FINANCIERO - CONTABILIDAD GENERAL
// MODELO 1.2: Período Contable
// ============================================

model PeriodoContable {
  id                    BigInt                  @id @default(autoincrement())
  empresaId             BigInt
  anio                  Int                                          // 2025
  mes                   Int                                          // 1-12 (Enero-Diciembre)
  nombrePeriodo         String                  @db.VarChar(50)      // "Enero 2025"
  fechaInicio           DateTime                                     // 2025-01-01 00:00:00
  fechaFin              DateTime                                     // 2025-01-31 23:59:59
  estadoId              BigInt
  fechaCierre           DateTime?
  cerradoPor            BigInt?
  
  // ========================================
  // REAPERTURA (EXCEPCIONAL)
  // ========================================
  fechaReapertura       DateTime?
  reabiertoPor          BigInt?
  motivoReapertura      String?                 @db.Text
  
  // ========================================
  // BLOQUEO DEFINITIVO
  // (Después de auditoría/declaración SUNAT)
  // ========================================
  fechaBloqueo          DateTime?
  bloqueadoPor          BigInt?
  motivoBloqueo         String?                 @db.Text             // "Declaración PDT 621 presentada - Período 01/2025"
  
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  personalCierre        Personal?               @relation("PeriodoCerradoPor", fields: [cerradoPor], references: [id])
  personalReapertura    Personal?               @relation("PeriodoReabiertoPor", fields: [reabiertoPor], references: [id])
  personalBloqueo       Personal?               @relation("PeriodoBloqueadoPor", fields: [bloqueadoPor], references: [id])
  
  asientosContables     AsientoContable[]
  movimientosActivoFijo MovimientoActivoFijo[]  // 🆕 NUEVA RELACIÓN
  cuentasPorCobrar      CuentaPorCobrar[]
  pagosCuentaPorCobrar  PagoCuentaPorCobrar[]
  cuentasPorPagar       CuentaPorPagar[]
  pagosCuentaPorPagar   PagoCuentaPorPagar[]
  preFacturas           PreFactura[]            // ✅ AGREGADO: Relación inversa
  ordenesCompra         OrdenCompra[]           // ✅ AGREGADO: Relación inversa
  deudasConPersonal     DeudaConPersonal[]        // 🆕 AGREGAR
  deudasTributarias     DeudaTributaria[]         // 🆕 AGREGAR
  detracciones          Detraccion[]

  @@unique([empresaId, anio, mes])
  @@index([empresaId])
  @@index([anio, mes])
  @@index([estadoId])
}



// ============================================
// MÓDULO FINANCIERO - CONTABILIDAD GENERAL
// MODELO 1.3: Asiento Contable (Cabecera)
// ============================================

model AsientoContable {
  id                    BigInt                  @id @default(autoincrement())
  empresaId             BigInt
  periodoContableId     BigInt
  numeroAsiento         String                  @db.VarChar(20)      // "ASI-2025-01-00001"
  correlativo           Int                                          // 1, 2, 3, ...
  fechaAsiento          DateTime                                     // Fecha contable
  glosa                 String                  @db.Text             // Descripción del asiento
  tipoLibro             TipoLibroContable                            // FISCAL | GERENCIAL
  
  // FISCAL = Operaciones blancas (visible para SUNAT)
  // GERENCIAL = Todas las operaciones (solo gerencia)
  
  origenAsiento         OrigenAsiento                                // MANUAL | AUTOMATICO
  submoduloOrigenId     BigInt?                                      // Si es automático, de qué módulo viene
  procesoOrigenId       BigInt?                                      // ID del registro origen (MovimientoCaja, ComprobanteVenta, etc)
  estadoId              BigInt
  
  totalDebe             Decimal                 @db.Decimal(18, 2)   // Suma de todos los DEBE
  totalHaber            Decimal                 @db.Decimal(18, 2)   // Suma de todos los HABER
  diferencia            Decimal                 @db.Decimal(18, 2)   // totalDebe - totalHaber (debe ser 0)
  estaCuadrado          Boolean                 @default(false)      // true si diferencia = 0
  monedaId              BigInt
  tipoCambio            Decimal?                @db.Decimal(10, 4)   // Si es moneda extranjera
  fechaAprobacion       DateTime?
  aprobadoPor           BigInt?
  fechaAnulacion        DateTime?
  anuladoPor            BigInt?
  motivoAnulacion       String?                 @db.Text
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?

  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  periodoContable       PeriodoContable         @relation(fields: [periodoContableId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  submoduloOrigen       SubmoduloSistema?       @relation(fields: [submoduloOrigenId], references: [id])
  personalAprobador     Personal?               @relation("AsientoAprobadoPor", fields: [aprobadoPor], references: [id])
  personalAnulador      Personal?               @relation("AsientoAnuladoPor", fields: [anuladoPor], references: [id])

  detalles              DetalleAsientoContable[]

// Nuevas relaciones con Tesorería Avanzada
  cuotasPrestamo        CuotaPrestamo[]
  inversionesLiquidadas InversionFinanciera[]
  movimientosInversion  MovimientoInversion[]
  prestamos             PrestamoBancario[]
  cuentasPorCobrar      CuentaPorCobrar[]       // Relación inversa
  cuentasPorPagar       CuentaPorPagar[]        // Relación inversa
  saldosCuentaCorriente SaldoCuentaCorriente[]  // 🆕 Relación inversa
  movimientosActivoFijo MovimientoActivoFijo[]  // 🆕 Relación
  deudasConPersonal     DeudaConPersonal[]      // 🆕 AGREGAR ESTA LÍNEA
  pagosDeudaPersonal    PagoDeudaPersonal[]     // 🆕 AGREGAR ESTA LÍNEA
  deudasTributarias     DeudaTributaria[]       // 🆕 AGREGAR ESTA LÍNEA
  pagosDeudaTributaria  PagoDeudaTributaria[]   // 🆕 AGREGAR ESTA LÍNEA
    // 🟢 AGREGAR ESTAS (7):
  preFacturas           PreFactura[]
  ordenesCompra         OrdenCompra[]
  pagoCuentasPorCobrar  PagoCuentaPorCobrar[]
  pagoCuentasPorPagar   PagoCuentaPorPagar[]
  movimientosCaja       MovimientoCaja[]
  movimientosAlmacen    MovimientoAlmacen[]
  detracciones          Detraccion[]           // ✅ AGREGAR ESTA LÍNEA

  // ========================================
  // ÍNDICES - CRÍTICO: índice en tipoLibro para filtrado rápido
  // ========================================
  @@unique([empresaId, periodoContableId, correlativo])
  @@index([empresaId])
  @@index([periodoContableId])
  @@index([numeroAsiento])
  @@index([fechaAsiento])
  @@index([estadoId])
  @@index([tipoLibro])                         // ⭐ CRÍTICO para filtrado SUNAT
  @@index([origenAsiento])
  @@index([submoduloOrigenId, procesoOrigenId])
  @@index([empresaId, tipoLibro, estadoId])    // ⭐ Índice compuesto para reportes SUNAT
}

// ============================================
// ENUMS PARA ASIENTO CONTABLE
// ============================================

enum TipoLibroContable {
  FISCAL              // Libro oficial para SUNAT (solo operaciones blancas)
  GERENCIAL           // Libro gerencial (todas las operaciones: blancas + negras)
}

enum OrigenAsiento {
  MANUAL              // Creado manualmente por contador
  AUTOMATICO          // Generado automáticamente por el sistema
}


// ============================================
// MÓDULO FINANCIERO - CONTABILIDAD GENERAL
// MODELO 1.4: Detalle Asiento Contable (Líneas)
// ============================================

model DetalleAsientoContable {
  id                    BigInt                  @id @default(autoincrement())
  asientoContableId     BigInt
  numeroLinea           Int                                          // 1, 2, 3, ... (orden dentro del asiento)
  planCuentaId          BigInt                                       // FK a PlanCuentasContable
  glosa                 String                  @db.Text             // Descripción específica de esta línea
  debe                  Decimal                 @db.Decimal(18, 2)   // Monto en el DEBE
  haber                 Decimal                 @db.Decimal(18, 2)   // Monto en el HABER  Regla: debe > 0 Y haber = 0  O  debe = 0 Y haber > 0, NO puede tener ambos con valor > 0
  monedaId              BigInt
  tipoCambio            Decimal?                @db.Decimal(10, 4)   // Si es moneda extranjera
  
  // Montos en moneda extranjera (si aplica)
  debeMonedaExtranjera  Decimal?                @db.Decimal(18, 2)
  haberMonedaExtranjera Decimal?                @db.Decimal(18, 2)
  
  // ========================================
  // DIMENSIONES CONTABLES (Análisis)
  // ========================================
  centroCostoId         BigInt?                                      // Centro de costo (obligatorio si la cuenta lo requiere)
  entidadComercialId    BigInt?                                      // Cliente/Proveedor (obligatorio si la cuenta lo requiere)
  proyectoId            BigInt?                                      // Proyecto (si aplica)
  activoId              BigInt?                                      // Activo relacionado a la línea (si aplica)

 // ========================================
  // 🆕 ORIGEN POLIMÓRFICO DE LA LÍNEA
  // ========================================
  submoduloOrigenLineaId    BigInt?       // submoduloOrigenLineaId → FK real a SubmoduloSistema (integridad)
  procesoOrigenLineaId      BigInt?       // procesoOrigenLineaId   → ID polimórfico (sin FK, resuelto vía SubmoduloSistema.nombreModeloOrigen)
  
  // ========================================
  // REFERENCIA AL DOCUMENTO COMERCIAL (desnormalizado para reportes/SUNAT)
  // ========================================
  tipoDocumentoOrigenId       BigInt?                                // Tipo: Factura, Boleta, NC, ND
  numeroDocumentoOrigen       String?    @db.VarChar(50)
  fechaDocumentoOrigen        DateTime?                              // Fecha emisión
  fechaVenceDocumentoOrigen   DateTime?                              // 🆕 Fecha vencimiento (CxC/CxP)
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  asientoContable       AsientoContable         @relation(fields: [asientoContableId], references: [id], onDelete: Cascade)
  planCuenta            PlanCuentasContable     @relation(fields: [planCuentaId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  centroCosto           CentroCosto?            @relation(fields: [centroCostoId], references: [id])
  entidadComercial      EntidadComercial?       @relation(fields: [entidadComercialId], references: [id])
  tipoDocumentoOrigen   TipoDocumento?          @relation(fields: [tipoDocumentoOrigenId], references: [id])
  submoduloOrigenLinea  SubmoduloSistema?       @relation("DetalleAsientoSubmodulo", fields: [submoduloOrigenLineaId], references: [id])  // 🆕
  activo                Activo?                 @relation(fields: [activoId], references: [id])

  // ========================================
  // ÍNDICES
  // ========================================
  @@index([asientoContableId])
  @@index([planCuentaId])
  @@index([centroCostoId])
  @@index([entidadComercialId])
  @@index([monedaId])
  @@index([submoduloOrigenLineaId, procesoOrigenLineaId])     // 🆕 Búsqueda polimórfica
  @@index([fechaVenceDocumentoOrigen])                        // 🆕 Reportes vencimientos
  @@index([activoId])                                         // Índice para búsquedas por activo
}

model FormaPago {
  id                BigInt             @id @default(autoincrement())
  nombre            String             @db.VarChar(50)
  descripcion       String?
  esCliente         Boolean            @default(false)
  esProveedor       Boolean            @default(false)
  activo            Boolean            @default(true)
