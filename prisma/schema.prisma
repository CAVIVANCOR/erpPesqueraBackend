  montoDetraccion           Decimal     @default(0) @db.Decimal(18, 2)  // ✅ AGREGADO
  porcentajeDetraccion      Decimal?    @db.Decimal(5, 2)            // ✅ AGREGADO
  numeroConstanciaDetraccion String?    @db.VarChar(50)              // ✅ AGREGADO: Número de constancia SUNAT
