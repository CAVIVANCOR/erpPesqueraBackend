  // ========================================
  fechaCreacion         DateTime    @default(now())                  // Fecha de creación del registro
  fechaActualizacion    DateTime?   @updatedAt                       // Fecha de última actualización
  creadoPor             BigInt?                                      // Usuario que creó el registro
  actualizadoPor        BigInt?                                      // Usuario que actualizó el registro
  refOperacionEspecializadaMovCaja  BigInt?

  // ========================================
  // RELACIONES
  // ========================================
  cuentaPorPagar        CuentaPorPagar      @relation(fields: [cuentaPorPagarId], references: [id])
  empresa               Empresa             @relation(fields: [empresaId], references: [id])  // ✅ AGREGADO
  monedaPago            Moneda              @relation("MonedaPagoCxP", fields: [monedaPagoId], references: [id])  // 🔄 MODIFICADO
  monedaDeuda           Moneda              @relation("MonedaDeudaCxP", fields: [monedaDeudaId], references: [id])  // ✅ AGREGADO
  medioPago             MedioPago           @relation(fields: [medioPagoId], references: [id])
  banco                 Banco?              @relation(fields: [bancoId], references: [id])
  cuentaBancaria        CuentaCorriente?    @relation(fields: [cuentaBancariaId], references: [id])
  movimientoCaja        MovimientoCaja?     @relation(fields: [movimientoCajaId], references: [id])
  periodoContable       PeriodoContable?    @relation(fields: [periodoContableId], references: [id])  // ✅ AGREGADO
  prestamoBancario      PrestamoBancario?   @relation(fields: [prestamoBancarioId], references: [id])
  asientosContables     AsientoContable[]  // Relación inversa

  // ========================================
  // ÍNDICES
  // ========================================
  @@index([cuentaPorPagarId])
  @@index([empresaId])                                               // ✅ AGREGADO
  @@index([fechaPago])
  @@index([movimientoCajaId])
  @@index([monedaPagoId])                                            // ✅ AGREGADO
  @@index([monedaDeudaId])                                           // ✅ AGREGADO
  @@index([periodoContableId])                                       // ✅ AGREGADO
  @@index([tieneDetraccion])                                         // ✅ AGREGADO
  @@index([tieneRetencion])                                          // ✅ AGREGADO
  @@index([tienePercepcion])                                         // ✅ AGREGADO
}


