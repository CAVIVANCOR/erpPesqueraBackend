  codigo                String      @unique @db.VarChar(10)     // "01", "02", "03"
  nombre                String      @db.VarChar(200)
  tipo                  String      @db.VarChar(15)             // RETENCION, PERCEPCION
  tasa                  Decimal     @db.Decimal(5, 2)           // 3.00, 2.00, 1.00
