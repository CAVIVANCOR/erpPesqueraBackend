  cuentaCorriente       CuentaCorriente     @relation(fields: [cuentaCorrienteId], references: [id])
  estado                EstadoMultiFuncion  @relation(fields: [estadoId], references: [id])
  conciliador           Personal?           @relation(fields: [conciliadoPor], references: [id])
  
  detalles              DetalleConciliacionBancaria[]
  
  @@unique([cuentaCorrienteId, periodo])
  @@index([empresaId, periodo])
  @@index([estadoId])
}

// ============================================
// DetalleConciliacionBancaria
// Partidas de conciliación
// ============================================

model DetalleConciliacionBancaria {
  id                        BigInt      @id @default(autoincrement())
  conciliacionBancariaId    BigInt
  fecha                     DateTime
  descripcion               String      @db.Text
  tipoMovimiento            String      @db.VarChar(10)     // INGRESO, EGRESO
  monto                     Decimal     @db.Decimal(18, 2)
  
  // Estado
  enLibros                  Boolean     @default(false)
  enBanco                   Boolean     @default(false)
  conciliado                Boolean     @default(false)
  
  // Referencias
  movimientoCajaId          BigInt?
  numeroOperacionBanco      String?     @db.VarChar(50)
  observaciones             String?     @db.Text
  
  conciliacionBancaria      ConciliacionBancaria    @relation(fields: [conciliacionBancariaId], references: [id], onDelete: Cascade)
  movimientoCaja            MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  
  @@index([conciliacionBancariaId])
  @@index([fecha])
  @@index([conciliado])
}


// ============================================
// ENUM TipoEndosoLetra
// Tipos de endoso según legislación
// ============================================

enum TipoEndosoLetra {
  PLENO           // Endoso en propiedad (transfiere todos los derechos)
  PROCURACION     // Endoso en procuración (para cobranza)
  GARANTIA        // Endoso en garantía (como garantía de otra obligación)
}

// ============================================
// UbicacionLetra
// Catálogo de ubicaciones físicas de letras
// ============================================

model UbicacionLetra {
  id                    BigInt      @id @default(autoincrement())
  codigo                String      @unique @db.VarChar(20)
  nombre                String      @db.VarChar(100)
  descripcion           String?     @db.Text
  esUbicacionBanco      Boolean     @default(false)
  bancoId               BigInt?
  responsableId         BigInt?
  activo                Boolean     @default(true)
  
  banco                 Banco?              @relation(fields: [bancoId], references: [id])
  responsable           Personal?           @relation(fields: [responsableId], references: [id])
  letras                LetraCambio[]
  
  @@index([activo])
  @@index([esUbicacionBanco])
}

// ============================================
// LetraCambio
// Letras de Cambio por Cobrar o Pagar
// ============================================

model LetraCambio {
  id                    BigInt      @id @default(autoincrement())
  
  // Tipo
  tipoLetra             String      @db.VarChar(10)     // COBRAR, PAGAR
  
  // Documento - Estructura estándar
  empresaId             BigInt
  tipoDocumentoId       BigInt
  serieDocId            BigInt?
  numSerieDoc           String?     @db.VarChar(40)
  numCorreDoc           String?     @db.VarChar(40)
  numeroDocumento       String?     @db.VarChar(40)
  
  // Fechas
  fechaEmision          DateTime
  fechaVencimiento      DateTime
  fechaAceptacion       DateTime?
  
  // Partes
  giradoId              BigInt
  beneficiarioId        BigInt
  avalId                BigInt?
  
  // Montos
  monedaId              BigInt
  montoOriginal         Decimal     @db.Decimal(18, 2)
  
  // Origen
  cuentaPorCobrarId     BigInt?
  cuentaPorPagarId      BigInt?
  
  // Estado
  estadoId              BigInt
  
  // Descuento bancario
  descontada            Boolean     @default(false)
  bancoDescontoId       BigInt?
  fechaDescuento        DateTime?
  montoDescuento        Decimal?    @db.Decimal(18, 2)
  tasaDescuento         Decimal?    @db.Decimal(5, 2)
  
  // Renovación
  renovada              Boolean     @default(false)
  letraRenovadaId       BigInt?
  
  // Protesto
  protestada            Boolean     @default(false)
  fechaProtesto         DateTime?
  motivoProtesto        String?     @db.Text
  
  // Ubicación física
  ubicacionLetraId      BigInt?
  
  observaciones         String?     @db.Text
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  actualizadoPor        BigInt?
  
  // Relaciones
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  tipoDocumento         TipoDocumento           @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc              SerieDoc?               @relation(fields: [serieDocId], references: [id])
  girado                EntidadComercial        @relation("LetraGirado", fields: [giradoId], references: [id])
  beneficiario          EntidadComercial        @relation("LetraBeneficiario", fields: [beneficiarioId], references: [id])
  aval                  EntidadComercial?       @relation("LetraAval", fields: [avalId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  cuentaPorCobrar       CuentaPorCobrar?        @relation(fields: [cuentaPorCobrarId], references: [id])
  cuentaPorPagar        CuentaPorPagar?         @relation(fields: [cuentaPorPagarId], references: [id])
  bancoDesconto         Banco?                  @relation(fields: [bancoDescontoId], references: [id])
  letraRenovada         LetraCambio?            @relation("RenovacionLetra", fields: [letraRenovadaId], references: [id])
  ubicacionLetra        UbicacionLetra?         @relation(fields: [ubicacionLetraId], references: [id])
  
  pagos                 PagoLetraCambio[]
  renovaciones          LetraCambio[]           @relation("RenovacionLetra")
  endosos               EndosoLetraCambio[]
  
  @@index([empresaId, fechaVencimiento])
  @@index([tipoLetra])
  @@index([estadoId])
  @@index([giradoId])
  @@index([beneficiarioId])
  @@index([fechaVencimiento])
  @@index([descontada])
  @@index([protestada])
  @@index([tipoDocumentoId])
  @@index([serieDocId])
  @@index([ubicacionLetraId])
}

// ============================================
// PagoLetraCambio
// Pagos realizados a letras de cambio
// ============================================

model PagoLetraCambio {
  id                    BigInt      @id @default(autoincrement())
  letraCambioId         BigInt
  
  fechaPago             DateTime
  montoPago             Decimal     @db.Decimal(18, 2)
  monedaId              BigInt
  
  // Medio de pago
  medioPagoId           BigInt
  numeroOperacion       String?     @db.VarChar(50)
  bancoId               BigInt?
  
  // Vinculación con caja
  movimientoCajaId      BigInt?
  
  observaciones         String?     @db.Text
  
  // Auditoría
  registradoPor         BigInt?
  creadoEn              DateTime    @default(now())
  refOperacionEspecializadaMovCaja  BigInt?

  // Relaciones
  letraCambio           LetraCambio         @relation(fields: [letraCambioId], references: [id])
  moneda                Moneda              @relation(fields: [monedaId], references: [id])
  medioPago             MedioPago           @relation(fields: [medioPagoId], references: [id])
  banco                 Banco?              @relation(fields: [bancoId], references: [id])
  movimientoCaja        MovimientoCaja?     @relation(fields: [movimientoCajaId], references: [id])
  registrador           Personal?           @relation(fields: [registradoPor], references: [id])
  
  @@index([letraCambioId])
  @@index([fechaPago])
  @@index([movimientoCajaId])
}


// ============================================
// EndosoLetraCambio
// Registro de endosos de letras
// ============================================

model EndosoLetraCambio {
  id                    BigInt              @id @default(autoincrement())
  letraCambioId         BigInt
  
  fechaEndoso           DateTime
  endosanteId           BigInt
  endosatarioId         BigInt
  tipoEndoso            TipoEndosoLetra     // ⭐ ENUM
  
  observaciones         String?             @db.Text
  
  // Auditoría
  registradoPor         BigInt?
  creadoEn              DateTime            @default(now())
  
  // Relaciones
  letraCambio           LetraCambio         @relation(fields: [letraCambioId], references: [id])
  endosante             EntidadComercial    @relation("Endosante", fields: [endosanteId], references: [id])
  endosatario           EntidadComercial    @relation("Endosatario", fields: [endosatarioId], references: [id])
  registrador           Personal?           @relation(fields: [registradoPor], references: [id])
  
  @@index([letraCambioId])
  @@index([fechaEndoso])
  @@index([tipoEndoso])
}




// ============================================
// TipoDetraccion
// Catálogo de tipos de detracción según SUNAT
// Tasas pueden variar según servicio/bien
// ============================================

model TipoDetraccion {
  id                    BigInt      @id @default(autoincrement())
  codigo                String      @unique @db.VarChar(10)     // "001", "004", "007", "019"
  nombre                String      @db.VarChar(200)            // "Azúcar", "Transporte de bienes", "Arrendamiento", "Intermediación laboral"
  tasa                  Decimal     @db.Decimal(5, 2)           // 4.00, 10.00, 12.00
  activo                Boolean     @default(true)
  
  // Relaciones inversas
  detracciones          Detraccion[]
  productos             Producto[]                              // 🆕 AGREGAR ESTA LÍNEA

  @@index([activo])
}

// ============================================
// Detraccion
// Constancia de Detracción recibida del cliente
// SIEMPRE se crea, incluso para casos simples
// ============================================

model Detraccion {
  id                    BigInt      @id @default(autoincrement())
  
  // Documento
  empresaId             BigInt
  numeroConstancia      String      @db.VarChar(50)             // DET-2026-001234 (número de constancia SUNAT)
  fechaDeposito         DateTime                                // Fecha en que cliente depositó en SUNAT
  
  // Cliente (quien deposita la detracción)
  clienteId             BigInt
  
  // Tipo de detracción
  tipoDetraccionId      BigInt?                                 // Opcional: tipo según catálogo SUNAT
  tasaDetraccion        Decimal     @db.Decimal(5, 2)           // 4.00, 10.00, etc.
  
  // Montos
  monedaId              BigInt
  importeTotal          Decimal     @db.Decimal(18, 2)          // Total de las facturas afectas
  importeDetraido       Decimal     @db.Decimal(18, 2)          // Monto depositado en cuenta SUNAT
  
  // Cuenta SUNAT destino
  cuentaSunatId         BigInt?                                 // Cuenta corriente SUNAT (CuentaCorriente)
  
  // Estado
  estadoId              BigInt                                  // DEPOSITADO, APLICADO, ANULADO
  
  // Aplicación como crédito fiscal
  aplicado              Boolean     @default(false)
  fechaAplicacion       DateTime?
  
  observaciones         String?     @db.Text
  
  // ========================================
  // INTEGRACIÓN CONTABLE
  // ========================================
  fechaContable         DateTime    @default(now())             // Fecha del período contable
  periodoContableId     BigInt?                                 // Período contable (para control de cierre)
  
  // ========================================
  // VINCULACIÓN CON OPERACIÓN ESPECIALIZADA
  // ========================================
  refOperacionEspecializadaMovCaja  BigInt?                     // Correlativo de operación de caja
  
  // ========================================
  // AUDITORÍA
  // ========================================
  fechaCreacion         DateTime    @default(now())
  fechaActualizacion    DateTime?   @updatedAt
  creadoPor             BigInt?
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                     @relation(fields: [empresaId], references: [id])
  cliente               EntidadComercial            @relation("ClienteDetraccion", fields: [clienteId], references: [id])
  tipoDetraccion        TipoDetraccion?             @relation(fields: [tipoDetraccionId], references: [id])
  moneda                Moneda                      @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion          @relation(fields: [estadoId], references: [id])
  cuentaSunat           CuentaCorriente?            @relation("CuentaSunatDetraccion", fields: [cuentaSunatId], references: [id])
  periodoContable       PeriodoContable?            @relation(fields: [periodoContableId], references: [id])
  
  // Relaciones inversas
  detalles              DetalleDetraccion[]
  pagosCuentaPorCobrar  PagoCuentaPorCobrar[]
  asientosContables     AsientoContable[]           // ✅ Asientos contables generados

  @@index([empresaId, fechaDeposito])
  @@index([clienteId])
  @@index([estadoId])
  @@index([aplicado])
  @@index([periodoContableId])
  @@index([numeroConstancia])
  @@index([refOperacionEspecializadaMovCaja])
}

// ============================================
// DetalleDetraccion
// Facturas/documentos afectos a la detracción
// Vincula Detraccion con PreFactura (origen de todos los documentos)
// ============================================

model DetalleDetraccion {
  id                    BigInt      @id @default(autoincrement())
  detraccionId          BigInt
  
  // ========================================
  // DOCUMENTO ORIGEN (PreFactura)
  // Todos los documentos (FAC, BOL, NC, ND, RxH) vienen de PreFactura
  // ========================================
  preFacturaOrigenId    BigInt                                  // Origen único de todos los documentos
  
  // ========================================
  // MONTOS
  // ========================================
  importeTotal          Decimal     @db.Decimal(18, 2)          // Monto total del documento
  importeDetraido       Decimal     @db.Decimal(18, 2)          // Monto detraído de este documento
  
  // ========================================
  // RELACIONES
  // ========================================
  detraccion            Detraccion          @relation(fields: [detraccionId], references: [id], onDelete: Cascade)
  preFacturaOrigen      PreFactura          @relation("PreFacturaDetraccion", fields: [preFacturaOrigenId], references: [id])
  
  @@index([detraccionId])
  @@index([preFacturaOrigenId])
}




// ============================================
// TipoRetencionPercepcion
// Catálogo de tipos según SUNAT
// Pueden cambiar tasas o agregarse nuevos tipos
// ============================================

model TipoRetencionPercepcion {
  id                    BigInt      @id @default(autoincrement())
  codigo                String      @unique @db.VarChar(10)     // "01", "02", "03"
  nombre                String      @db.VarChar(200)
  tipo                  String      @db.VarChar(15)             // RETENCION, PERCEPCION
  tasa                  Decimal     @db.Decimal(5, 2)           // 3.00, 2.00, 1.00
  activo                Boolean     @default(true)
  
  retenciones           Retencion[]
  percepciones          Percepcion[]
  
  @@index([tipo])
  @@index([activo])
}

// ============================================
// Retencion
// Comprobante de Retención emitido
// ============================================

model Retencion {
  id                    BigInt      @id @default(autoincrement())
  
  // Documento - Estructura estándar
  empresaId             BigInt
  tipoDocumentoId       BigInt                          // Tipo: Comprobante de Retención
  serieDocId            BigInt?
  numSerieDoc           String?     @db.VarChar(40)
  numCorreDoc           String?     @db.VarChar(40)
  numeroDocumento       String?     @db.VarChar(40)
  
  // Fechas
  fechaEmision          DateTime
  fechaPago             DateTime                        // Fecha del pago que origina la retención
  
  // Proveedor
  proveedorId           BigInt
  tipoDocProveedorId    BigInt
  numeroDocProveedor    String      @db.VarChar(20)
  razonSocialProveedor  String      @db.VarChar(255)
  
  // Tipo de retención
  tipoRetencionId       BigInt
  tasaRetencion         Decimal     @db.Decimal(5, 2)
  
  // Montos
  monedaId              BigInt
  importeTotal          Decimal     @db.Decimal(18, 2)  // Total del pago
  importeRetenido       Decimal     @db.Decimal(18, 2)  // Monto retenido
  importeNeto           Decimal     @db.Decimal(18, 2)  // Pagado al proveedor
  
  // Origen
  cuentaPorPagarId      BigInt?
  movimientoCajaId      BigInt?
  
  // Nubefact OSE
  nubefactEnviado       Boolean     @default(false)
  nubefactAceptado      Boolean?
  nubefactEnlacePDF     String?     @db.VarChar(500)
  nubefactEnlaceXML     String?     @db.VarChar(500)
  nubefactRespuesta     String?     @db.Text
  
  // Estado
  estadoId              BigInt                          // EMITIDA, ENVIADA_SUNAT, ACEPTADA, RECHAZADA
  
  // Declaración PDT 626
  periodoDeclaracion    String?     @db.VarChar(6)      // YYYYMM
  declarado             Boolean     @default(false)
  fechaDeclaracion      DateTime?
  
  observaciones         String?     @db.Text
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  
  // Relaciones
  empresa               Empresa                     @relation(fields: [empresaId], references: [id])
  tipoDocumento         TipoDocumento               @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc              SerieDoc?                   @relation(fields: [serieDocId], references: [id])
  proveedor             EntidadComercial            @relation(fields: [proveedorId], references: [id])
  tipoDocProveedor      TiposDocIdentidad           @relation(fields: [tipoDocProveedorId], references: [id])
  tipoRetencion         TipoRetencionPercepcion     @relation(fields: [tipoRetencionId], references: [id])
  moneda                Moneda                      @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion          @relation(fields: [estadoId], references: [id])
  cuentaPorPagar        CuentaPorPagar?             @relation(fields: [cuentaPorPagarId], references: [id])
  movimientoCaja        MovimientoCaja?             @relation(fields: [movimientoCajaId], references: [id])
  
  detalles              DetalleRetencion[]
  
  @@index([empresaId, fechaEmision])
  @@index([proveedorId])
  @@index([estadoId])
  @@index([periodoDeclaracion])
  @@index([declarado])
  @@index([nubefactEnviado])
}


// ============================================
// DetalleRetencion
