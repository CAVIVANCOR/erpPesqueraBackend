}


// ════════════════════════════════════════════════════════════
// CATÁLOGO: TIPOS DE DEUDA PERSONAL
// Ejemplos: Sueldos, Gratificaciones, CTS, Comisiones Pesca
// ════════════════════════════════════════════════════════════

model TipoDeudaPersonal {
  id                    BigInt                  @id @default(autoincrement())
  categoriaId           BigInt?                                               // Categoría a la que pertenece (FK a CategoriaTipoDeudaPersonal)
  nombre                String                  @db.VarChar(100)              // Nombre del tipo de deuda (ej: "Sueldos", "Comisiones Pesca")
  descripcion           String?                 @db.Text                      // Descripción detallada del tipo de deuda
  cuentaContableId      BigInt?                                               // ⭐ NUEVO: Cuenta contable asociada (FK a PlanCuentasContable: 41.1.1 Remuneraciones por Pagar, etc.)
  periodicidad          FrecuenciaPago?                                       // ⭐ NUEVO: Periodicidad del pago (MENSUAL, QUINCENAL, SEMANAL, etc.) - OPCIONAL
  activo                Boolean                 @default(true)                // Estado del tipo de deuda (true = activo, false = inactivo)
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())               // Fecha de creación del registro
  creadoPor             BigInt?                                               // Usuario que creó el registro
  actualizadoEn         DateTime                @updatedAt                    // Fecha de última actualización
  actualizadoPor        BigInt?                                               // Usuario que actualizó el registro
  
  // ========================================
  // RELACIONES
  // ========================================
  categoria             CategoriaTipoDeudaPersonal?  @relation(fields: [categoriaId], references: [id])
  cuentaContable        PlanCuentasContable?    @relation("TipoDeudaPersonalToCuentaContable", fields: [cuentaContableId], references: [id])  // ⭐ NUEVO
  
  // ========================================
  // RELACIONES INVERSAS
  // ========================================
  deudas                DeudaConPersonal[]                                    // Deudas asociadas a este tipo
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([categoriaId])                                                      // Filtro por categoría
  @@index([cuentaContableId])                                                 // ⭐ NUEVO: Búsqueda por cuenta contable
  @@index([periodicidad])                                                     // ⭐ NUEVO: Filtro por periodicidad
  @@index([activo])                                                           // Filtro por estado activo/inactivo
}


// ════════════════════════════════════════════════════════════
// DEUDAS CON PERSONAL
// Registro de deudas con trabajadores (sueldos, comisiones, etc.)
// Puede originarse de Planilla, Pesca u otros módulos
// Soporta pagos en negro (esGerencial = true)
// ════════════════════════════════════════════════════════════

model DeudaConPersonal {
  id                    BigInt                  @id @default(autoincrement())
  empresaId             BigInt                                                // Empresa que tiene la deuda
  personalId            BigInt                                                // Trabajador acreedor
  tipoDeudaId           BigInt                                                // Tipo de deuda (FK a TipoDeudaPersonal)
  
  // ========================================
  // ORIGEN DEL REGISTRO (PATRÓN MEGUI)
  // ========================================
  moduloOrigenId        BigInt?                                               // ID del módulo origen (Planilla, Pesca, etc.)
  origenId              BigInt?                                               // ID del registro origen (PlanillaId, ComisionPescaId, etc.)
  
  fecha                 DateTime                                              // Fecha de generación de la deuda
  fechaVencimiento      DateTime                                              // Fecha límite de pago
  numeroDocumento       String?                 @db.VarChar(40)               // Número de documento o código de referencia
  montoPagadoAnterior   Decimal                 @db.Decimal(18, 2)  @default(0)  // 🆕 Pagos anteriores al sistema (saldos iniciales)
  montoOriginal         Decimal                 @db.Decimal(18, 2)            // Monto original de la deuda
  montoPagado           Decimal                 @db.Decimal(18, 2)  @default(0)  // Monto pagado acumulado (se actualiza con cada pago)
  saldoPendiente        Decimal                 @db.Decimal(18, 2)            // Saldo pendiente (montoOriginal - montoPagado)
  monedaId              BigInt                                                // Moneda de la deuda (PEN, USD, EUR)
  estadoId              BigInt                                                // Estado (PENDIENTE, PAGADA, PARCIAL)
  esGerencial           Boolean                 @default(false)               // true = Pago en negro (sin declarar a SUNAT), false = Pago formal
  esSaldoInicial        Boolean                 @default(false)               // true = Saldo inicial de migración (sin origen), false = Deuda generada

  // ========================================
  // INTEGRACIÓN CONTABLE
  // ========================================
  fechaContable         DateTime?                                             // Fecha del asiento contable (para saldos iniciales: 31/12/2025)
  periodoContableId     BigInt?                                               // Período contable (para control de cierre)
  observaciones         String?                 @db.Text                      // Observaciones generales
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())               // Fecha de creación del registro
  creadoPor             BigInt?                                               // Usuario que creó el registro
  actualizadoEn         DateTime                @updatedAt                    // Fecha de última actualización
  actualizadoPor        BigInt?                                               // Usuario que actualizó el registro
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  personal              Personal                @relation(fields: [personalId], references: [id])
  tipoDeuda             TipoDeudaPersonal       @relation(fields: [tipoDeudaId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  periodoContable       PeriodoContable?        @relation(fields: [periodoContableId], references: [id])
  
  // ========================================
  // RELACIONES INVERSAS
  // ========================================
  pagos                 PagoDeudaPersonal[]                                   // Pagos realizados a esta deuda
  asientosContables     AsientoContable[]                                     // Asientos contables generados por esta deuda

  // ========================================
  // ÍNDICES PROFESIONALES
  // ========================================
  @@index([empresaId, fechaVencimiento])                                      // Búsqueda de deudas por vencimiento
  @@index([empresaId, personalId, estadoId])                                  // Búsqueda de deudas por empresa y trabajador
  @@index([personalId, estadoId])                                             // Deudas por trabajador
  @@index([fechaVencimiento, estadoId])                                       // Deudas vencidas
  @@index([estadoId])                                                         // Filtro por estado
  @@index([saldoPendiente])                                                   // Filtro por saldo pendiente
  @@index([periodoContableId])                                                // Control de cierre contable
  @@index([esGerencial])                                                      // Filtro deudas negras/blancas
  @@index([moduloOrigenId, origenId])                                         // Trazabilidad al origen
}



// ════════════════════════════════════════════════════════════
// PAGOS DE DEUDAS AL PERSONAL
// Registro de pagos realizados a trabajadores
// Genera MovimientoCaja (EGRESO) y actualiza saldo de deuda
// ════════════════════════════════════════════════════════════

model PagoDeudaPersonal {
  id                    BigInt                  @id @default(autoincrement())
  deudaConPersonalId    BigInt                                                // Deuda que se está pagando (FK a DeudaConPersonal)
  fechaPago             DateTime                                              // Fecha en que se realiza el pago
  montoPago             Decimal                 @db.Decimal(18, 2)            // Monto pagado en esta transacción
  medioPagoId           BigInt?                                               // Medio de pago (Efectivo, Transferencia, Cheque, etc.)
  numeroOperacion       String?                 @db.VarChar(40)               // Número de operación bancaria
  movimientoCajaId      BigInt?                                               // Movimiento de caja asociado (EGRESO)
  observaciones         String?                 @db.Text                      // Observaciones del pago
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())               // Fecha de creación del registro
  creadoPor             BigInt?                                               // Usuario que creó el registro
  actualizadoEn         DateTime                @updatedAt                    // Fecha de última actualización
  actualizadoPor        BigInt?                                               // Usuario que actualizó el registro
  refOperacionEspecializadaMovCaja  BigInt?

  // ========================================
  // RELACIONES
  // ========================================
  deudaConPersonal      DeudaConPersonal        @relation(fields: [deudaConPersonalId], references: [id])
  medioPago             MedioPago?              @relation(fields: [medioPagoId], references: [id])
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  
  // ========================================
  // RELACIONES INVERSAS
  // ========================================
  asientosContables     AsientoContable[]                                     // Asientos contables generados por este pago

  // ========================================
  // ÍNDICES
  // ========================================
  @@index([deudaConPersonalId])                                               // Búsqueda de pagos por deuda
  @@index([medioPagoId])                                                      // Filtro por medio de pago
  @@index([movimientoCajaId])                                                 // Vinculación con caja
  @@index([fechaPago])                                                        // Ordenar por fecha de pago
}



