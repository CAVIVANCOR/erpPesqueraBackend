  @@index([refOperacionEspecializadaMovCaja])                        // ✅ AGREGAR ESTE
  @@index([tieneRetencion])                                          // ✅ AGREGADO
  @@index([tienePercepcion])                                         // ✅ AGREGADO
}

// ============================================
// CuentaPorPagar
// Registro de deudas con proveedores
// Puede originarse de OrdenCompra o ser saldo inicial
// ============================================

model CuentaPorPagar {
  id                    BigInt      @id @default(autoincrement())
  
  // ========================================
  // ORIGEN DEL DOCUMENTO
  // ========================================
  ordenCompraId         BigInt?     @unique                          // Opcional: OrdenCompra origen (null para saldos iniciales)
  empresaId             BigInt                                       // Empresa deudora
  proveedorId           BigInt                                       // Proveedor acreedor
  
  // ========================================
  // DOCUMENTO
  // ========================================
  numeroOrdenCompra     String      @db.VarChar(30)                  // Número de OC o código de saldo inicial
  fechaEmision          DateTime                                     // Fecha de emisión de la deuda
  fechaVencimiento      DateTime                                     // Fecha de vencimiento del pago
  
  // ========================================
  // MONTOS ALMACENADOS (estilo SAP FI)
  // ========================================
  montoTotal            Decimal     @db.Decimal(18, 2)               // Total de la deuda original
  montoPagado           Decimal     @default(0.00) @db.Decimal(18, 2) // Se actualiza con cada pago
  saldoPendiente        Decimal     @db.Decimal(18, 2)               // montoTotal - montoPagado
  
  // ========================================
  // DETRACCIÓN SPOT (SUNAT PERÚ) - TOTALES
  // ========================================
  tieneDetraccion           Boolean     @default(false)              // Aplica si producto/servicio está sujeto a detracción
  montoDetraccionTotal      Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado que TÚ detraes al proveedor
  porcentajeDetraccion      Decimal?    @db.Decimal(5, 2)            // % de detracción (4%, 10%, 12%, etc.)
  
  // ========================================
  // RETENCIÓN (SUNAT PERÚ) - TOTALES
  // ========================================
  tieneRetencion            Boolean     @default(false)              // Aplica si TÚ eres agente de retención
  montoRetencionTotal       Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado que TÚ retienes al proveedor
  porcentajeRetencion       Decimal?    @db.Decimal(5, 2)            // ✅ AGREGADO: % de retención (generalmente 3%)
  
  // ========================================
  // PERCEPCIÓN (SUNAT PERÚ) - TOTALES
  // ========================================
  tienePercepcion           Boolean     @default(false)              // Aplica si proveedor es agente de percepción
  montoPercepcionTotal      Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado que TÚ pagas adicional
  porcentajePercepcion      Decimal?    @db.Decimal(5, 2)            // % de percepción
  
  // ========================================
  // FLAGS ESPECIALES
  // ========================================
  esSaldoInicial            Boolean     @default(false)              // true = Saldo inicial de migración
  esGerencial               Boolean     @default(false)              // true = CxP Negra (Gerencial), false = CxP Blanca (Formal)
  
  // ========================================
  // MONEDA Y TIPO DE COMPRA
  // ========================================
  monedaId                  BigInt                                   // Moneda de la deuda (PEN, USD, EUR)
  esContado                 Boolean                                  // true = Compra al contado, false = Compra al crédito
  estadoId                  BigInt                                   // Estado de la CxP (PENDIENTE, PAGADA, VENCIDA, PARCIAL, ANULADA)
  observaciones             String?     @db.Text                     // Observaciones generales
  
  // ========================================
  // INTEGRACIÓN CONTABLE
  // ========================================
  fechaContable             DateTime    @default(now())              // ✅ AGREGADO: Fecha del período contable
  periodoContableId         BigInt?                                  // ✅ AGREGADO: Período contable (para control de cierre)
  
  // ========================================
  // AUDITORÍA
  // ========================================
  fechaCreacion         DateTime    @default(now())                  // Fecha de creación del registro
  fechaActualizacion    DateTime?   @updatedAt                       // Fecha de última actualización
  creadoPor             BigInt?                                      // Usuario que creó el registro
  actualizadoPor        BigInt?                                      // Usuario que actualizó el registro

  // ========================================
  // RELACIONES
  // ========================================
  ordenCompra               OrdenCompra?            @relation(fields: [ordenCompraId], references: [id])
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id])
  proveedor                 EntidadComercial        @relation(fields: [proveedorId], references: [id])
  moneda                    Moneda                  @relation(fields: [monedaId], references: [id])
  estado                    EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  periodoContable           PeriodoContable?        @relation(fields: [periodoContableId], references: [id])  // ✅ AGREGADO
  
  // ========================================
  // RELACIONES INVERSAS
  // ========================================
  pagos                     PagoCuentaPorPagar[]                     // Pagos realizados
  detallesFlujoCaja         DetalleFlujoCajaProyectado[]            // Proyección de flujo de caja
  asientosContables         AsientoContable[]  // Relación inversa - Asientos generados
  letrasCambio              LetraCambio[]
  retenciones               Retencion[]
  percepciones              Percepcion[]
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([empresaId, fechaVencimiento])
  @@index([proveedorId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([esContado])
  @@index([esSaldoInicial])
  @@index([saldoPendiente])
  @@index([esGerencial])
  @@index([ordenCompraId])
  @@index([periodoContableId])                                       // ✅ AGREGADO
  @@index([tieneDetraccion])
  @@index([tieneRetencion])
  @@index([tienePercepcion])
}

// ============================================
