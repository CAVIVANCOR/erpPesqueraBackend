  numeroOperacion       String?     @db.VarChar(50)                  // Número de operación bancaria
  bancoId               BigInt?                                      // Banco del pago
  cuentaBancariaId      BigInt?                                      // Cuenta bancaria origen (de la empresa)
  
  // ⭐ NUEVO: Vinculación con Préstamo Bancario
  prestamoBancarioId    BigInt?                                      // FK a PrestamoBancario (cuando medio = PRÉSTAMO BANCARIO)
  
  // ========================================
  // VINCULACIÓN CON CAJA
  // ========================================
  movimientoCajaId      BigInt?                                      // Movimiento de caja asociado
  observaciones         String?     @db.Text                         // Observaciones del pago
  
  // ========================================
  // INTEGRACIÓN CONTABLE
  // ========================================
  fechaContable         DateTime    @default(now())                  // ✅ AGREGADO: Fecha del período contable
  periodoContableId     BigInt?                                      // ✅ AGREGADO: Período contable (para control de cierre)
  
  // ========================================
