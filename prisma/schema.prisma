  // ========================================
  detallesConciliacion            DetalleConciliacionBancaria[]
  pagosCuentaPorCobrar            PagoCuentaPorCobrar[]
  pagosCuentaPorPagar             PagoCuentaPorPagar[]
  pagosLetra                      PagoLetraCambio[]
  retenciones                     Retencion[]

  // Nuevas relaciones con Tesorería Avanzada
  cuotasPrestamo                  CuotaPrestamo[]
  inversionesLiquidadas           InversionFinanciera[]
  movimientosInversion            MovimientoInversion[]
  prestamosDesembolso             PrestamoBancario[]    @relation("DesembolsoPrestamo")
  asientosContables               AsientoContable[]  // Relación inversa - Asientos generados
  // ========================================
  // 🆕 RELACIÓN PARA TRANSFERENCIAS (AGREGAR)
  // ========================================
  movimientoRelacionado     MovimientoCaja?           @relation("TransferenciaVinculada", fields: [movimientoRelacionadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movimientosPar            MovimientoCaja[]          @relation("TransferenciaVinculada")
 

  // ========================================
  // 🆕 ÍNDICES NUEVOS
  // ========================================
  @@index([esReversion])
  @@index([movimientoRevertidoId])
  @@index([asientosGenerados])
  @@index([incluirEnReporteFiscal])
  @@index([aprobadoPorId])
  @@index([rechazadoPorId])
    // ========================================
  // 🆕 ÍNDICES PARA TRANSFERENCIAS (AGREGAR)
  // ========================================
  @@index([esTransferencia])
  @@index([movimientoRelacionadoId])
}

