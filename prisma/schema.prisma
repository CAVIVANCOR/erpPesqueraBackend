  personalRechazador        Personal?                 @relation("MovimientoCajaRechazadorId", fields: [rechazadoPorId], references: [id])
  movimientoOriginal        MovimientoCaja?           @relation("MovimientoReversion", fields: [movimientoRevertidoId], references: [id])
  reversiones               MovimientoCaja[]          @relation("MovimientoReversion")
  saldos                    SaldoCuentaCorriente[]
  pagosDeudaPersonal        PagoDeudaPersonal[]  // 🆕 AGREGAR ESTA LÍNEA
  pagosDeudaTributaria      PagoDeudaTributaria[]  // 🆕 AGREGAR ESTA LÍNEA

  // ========================================
