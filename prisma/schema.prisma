// ============================================
// Retencion
// Comprobante de Retención emitido
// ============================================

model Retencion {
  id                    BigInt      @id @default(autoincrement())
  
  // Documento - Estructura estándar
  empresaId             BigInt
  tipoDocumentoId       BigInt                          // Tipo: Comprobante de Retención
  serieDocId            BigInt?
  numSerieDoc           String?     @db.VarChar(40)
  numCorreDoc           String?     @db.VarChar(40)
  numeroDocumento       String?     @db.VarChar(40)
  
  // Fechas
  fechaEmision          DateTime
  fechaPago             DateTime                        // Fecha del pago que origina la retención
  
  // Proveedor
  proveedorId           BigInt
  tipoDocProveedorId    BigInt
  numeroDocProveedor    String      @db.VarChar(20)
  razonSocialProveedor  String      @db.VarChar(255)
  
  // Tipo de retención
  tipoRetencionId       BigInt
  tasaRetencion         Decimal     @db.Decimal(5, 2)
  
  // Montos
  monedaId              BigInt
  importeTotal          Decimal     @db.Decimal(18, 2)  // Total del pago
  importeRetenido       Decimal     @db.Decimal(18, 2)  // Monto retenido
  importeNeto           Decimal     @db.Decimal(18, 2)  // Pagado al proveedor
  
  // Origen
  cuentaPorPagarId      BigInt?
  movimientoCajaId      BigInt?
  
  // Nubefact OSE
  nubefactEnviado       Boolean     @default(false)
  nubefactAceptado      Boolean?
  nubefactEnlacePDF     String?     @db.VarChar(500)
  nubefactEnlaceXML     String?     @db.VarChar(500)
  nubefactRespuesta     String?     @db.Text
  
  // Estado
  estadoId              BigInt                          // EMITIDA, ENVIADA_SUNAT, ACEPTADA, RECHAZADA
  
  // Declaración PDT 626
  periodoDeclaracion    String?     @db.VarChar(6)      // YYYYMM
  declarado             Boolean     @default(false)
  fechaDeclaracion      DateTime?
  
  observaciones         String?     @db.Text
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  
  // Relaciones
  empresa               Empresa                     @relation(fields: [empresaId], references: [id])
  tipoDocumento         TipoDocumento               @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc              SerieDoc?                   @relation(fields: [serieDocId], references: [id])
  proveedor             EntidadComercial            @relation(fields: [proveedorId], references: [id])
  tipoDocProveedor      TiposDocIdentidad           @relation(fields: [tipoDocProveedorId], references: [id])
  tipoRetencion         TipoRetencionPercepcion     @relation(fields: [tipoRetencionId], references: [id])
  moneda                Moneda                      @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion          @relation(fields: [estadoId], references: [id])
  cuentaPorPagar        CuentaPorPagar?             @relation(fields: [cuentaPorPagarId], references: [id])
  movimientoCaja        MovimientoCaja?             @relation(fields: [movimientoCajaId], references: [id])
  
  detalles              DetalleRetencion[]
  
  @@index([empresaId, fechaEmision])
  @@index([proveedorId])
  @@index([estadoId])
  @@index([periodoDeclaracion])
  @@index([declarado])
  @@index([nubefactEnviado])
}


// ============================================
// DetalleRetencion
