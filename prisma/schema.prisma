// ============================================
// Percepcion
// Comprobante de Percepción recibido
// ============================================

model Percepcion {
  id                    BigInt      @id @default(autoincrement())
  
  // Documento - Estructura estándar
  empresaId             BigInt
  tipoDocumentoId       BigInt
  serieDocId            BigInt?
  numSerieDoc           String?     @db.VarChar(40)
  numCorreDoc           String?     @db.VarChar(40)
  numeroDocumento       String?     @db.VarChar(40)
  
  // Fechas
  fechaEmision          DateTime
  fechaCobro            DateTime
  
  // Proveedor (quien aplica la percepción)
  proveedorId           BigInt
  tipoDocProveedorId    BigInt
  numeroDocProveedor    String      @db.VarChar(20)
  razonSocialProveedor  String      @db.VarChar(255)
  
  // Tipo de percepción
  tipoPercepcionId      BigInt
  tasaPercepcion        Decimal     @db.Decimal(5, 2)
  
  // Montos
  monedaId              BigInt
  importeTotal          Decimal     @db.Decimal(18, 2)  // Total de la compra
  importePercibido      Decimal     @db.Decimal(18, 2)  // Monto percibido
  importePagado         Decimal     @db.Decimal(18, 2)  // Total pagado (compra + percepción)
  
  // Origen
  ordenCompraId         BigInt?
  cuentaPorPagarId      BigInt?
  
  // Estado
  estadoId              BigInt                          // RECIBIDA, APLICADA, ANULADA
  
  // Aplicación como crédito
  aplicadaCredito       Boolean     @default(false)
  fechaAplicacion       DateTime?
  periodoAplicacion     String?     @db.VarChar(6)
  
  observaciones         String?     @db.Text
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  
  // Relaciones
  empresa               Empresa                     @relation(fields: [empresaId], references: [id])
  tipoDocumento         TipoDocumento               @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc              SerieDoc?                   @relation(fields: [serieDocId], references: [id])
  proveedor             EntidadComercial            @relation(fields: [proveedorId], references: [id])
  tipoDocProveedor      TiposDocIdentidad           @relation(fields: [tipoDocProveedorId], references: [id])
  tipoPercepcion        TipoRetencionPercepcion     @relation(fields: [tipoPercepcionId], references: [id])
  moneda                Moneda                      @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion          @relation(fields: [estadoId], references: [id])
  ordenCompra           OrdenCompra?                @relation(fields: [ordenCompraId], references: [id])
  cuentaPorPagar        CuentaPorPagar?             @relation(fields: [cuentaPorPagarId], references: [id])
  
  detalles              DetallePercepcion[]
  
  @@index([empresaId, fechaEmision])
  @@index([proveedorId])
  @@index([estadoId])
  @@index([aplicadaCredito])
  @@index([periodoAplicacion])
}

// ============================================
