// ============================================
// MÓDULO DE VENTAS - EXPORTACIÓN
// ============================================
// Gestiona el proceso completo de ventas de exportación:
// 1. Cotización con cálculo de costos y factor de exportación
// 2. Documentación requerida por país/producto
// 3. Entrega a rendir para gastos reales
// 4. PreFactura (Nota de Venta)
// ============================================

// ============================================
// 1. INCOTERM (Catálogo Maestro)
// ============================================
// Define los términos internacionales de comercio (FOB, CIF, DDP, etc.)
// y su relación con las responsabilidades de costos

model Incoterm {
  id                BigInt       @id @default(autoincrement())
  codigo            String       @unique @db.VarChar(10)              // "FOB", "CIF", "DDP"
  nombre            String       @db.VarChar(100)                     // "Free On Board"
  descripcion       String?      @db.Text                             // Descripción detallada
  activo            Boolean      @default(true)
  
  fechaCreacion     DateTime     @default(now())
  fechaActualizacion DateTime?   @updatedAt
  creadoPor         BigInt?
  actualizadoPor    BigInt?

  cotizaciones      CotizacionVentas[]
  preFacturas       PreFactura[]
  costosAplicables  CostoExportacionPorIncoterm[]                    // Costos que aplican según Incoterm
}

// ============================================
// 2. COSTOS DE EXPORTACIÓN POR INCOTERM
// ============================================
// Define qué costos aplican para cada Incoterm y quién es responsable
// Ejemplo: En FOB el vendedor paga flete local, en CIF también paga flete internacional

model CostoExportacionPorIncoterm {
  id                          BigInt      @id @default(autoincrement())
  incotermId                  BigInt
  productoId                  BigInt                                 
  esResponsabilidadVendedor   Boolean     @default(true)             
  activo                      Boolean     @default(true)             
  esObligatorio               Boolean     @default(true)
  orden                       Int?                                   
  requiereDocumento           Boolean     @default(false)
  documentoAsociadoId         BigInt?
  
  // Valores default SOLO si no depende de ruta
  proveedorDefaultId          BigInt?
  monedaDefaultId             BigInt?
  valorVentaDefault           Decimal?    @db.Decimal(18,2)
  
  // Indica si este costo varía por ruta
  variaSegunRuta              Boolean     @default(false)            // 🆕 NUEVO
  
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?
 
  proveedorDefault            EntidadComercial? @relation("ProveedorDefaultCostoIncoterm", fields: [proveedorDefaultId], references: [id])
  monedaDefault               Moneda? @relation("MonedaDefaultCostoIncoterm", fields: [monedaDefaultId], references: [id])
  incoterm                    Incoterm @relation(fields: [incotermId], references: [id])
  producto                    Producto @relation(fields: [productoId], references: [id])
  documentoAsociado           DocRequeridaVentas? @relation("CostoIncotermDocumento", fields: [documentoAsociadoId], references: [id])  
  
  // 🆕 Relación con tarifas por ruta
  tarifasPorRuta              TarifaCostoExportacionRuta[]
  
  @@unique([incotermId, productoId])
  @@index([incotermId])
  @@index([productoId])
}
 
// ============================================
// 🆕 NUEVA TABLA: Tarifas por Ruta
// ============================================
// Define CUÁNTO cuesta cada servicio según la ruta
model TarifaCostoExportacionRuta {
  id                          BigInt      @id @default(autoincrement())
  costoIncotermId             BigInt                                 // FK a CostoExportacionPorIncoterm
  
  // Definición de la ruta
  paisOrigenId                BigInt?                                // Opcional: si aplica por país
  puertoOrigenId              BigInt?                                // Puerto de partida
  paisDestinoId               BigInt?                                // Opcional: si aplica por país
  puertoDestinoId             BigInt?                                // Puerto de llegada
  
  // Tarifa específica para esta ruta
  proveedorId                 BigInt?                                // Proveedor específico para esta ruta
  monedaId                    BigInt                                 // Moneda de la tarifa
  valorVenta                  Decimal     @db.Decimal(18,2)          // Precio para esta ruta
  
  // Vigencia de la tarifa
  fechaVigenciaDesde          DateTime    @default(now())
  fechaVigenciaHasta          DateTime?                              // null = vigencia indefinida
  
  activo                      Boolean     @default(true)
  observaciones               String?     @db.Text
  
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?
 
  // Relaciones
  costoIncoterm               CostoExportacionPorIncoterm @relation(fields: [costoIncotermId], references: [id], onDelete: Cascade)
  paisOrigen                  Pais? @relation("PaisOrigenTarifa", fields: [paisOrigenId], references: [id])
  puertoOrigen                PuertoPesca? @relation("PuertoOrigenTarifa", fields: [puertoOrigenId], references: [id])
  paisDestino                 Pais? @relation("PaisDestinoTarifa", fields: [paisDestinoId], references: [id])
  puertoDestino               PuertoPesca? @relation("PuertoDestinoTarifa", fields: [puertoDestinoId], references: [id])
  proveedor                   EntidadComercial? @relation("ProveedorTarifaRuta", fields: [proveedorId], references: [id])
  moneda                      Moneda @relation("MonedaTarifaRuta", fields: [monedaId], references: [id])
  
  @@index([costoIncotermId])
  @@index([puertoOrigenId, puertoDestinoId])
  @@index([paisOrigenId, paisDestinoId])
  @@index([fechaVigenciaDesde, fechaVigenciaHasta])
}

// ============================================
// 3. COTIZACIÓN DE VENTAS (Cabecera)
// ============================================
// Documento principal para cotizar exportaciones
// Calcula factor de exportación y precio final con utilidad

model CotizacionVentas {
  id                          BigInt      @id @default(autoincrement())
  codigo                      String      @unique @db.VarChar(30)
  version                     Int         @default(1)                // Control de versiones
  cotizacionPadreId           BigInt?                                // Para versionado
  
  // Datos del documento
  empresaId                   BigInt
  tipoDocumentoId             BigInt                                 // Valor: 18 (Cotización Venta)
  serieDocId                  BigInt
  numeroDocumento             String?     @db.VarChar(40)
  numSerieDoc                 String?     @db.VarChar(40)
  numCorreDoc                 String?     @db.VarChar(40)
  fechaDocumento              DateTime    @default(now())
  fechaVencimiento            DateTime
  
  // Cliente
  clienteId                   BigInt
  contactoClienteId           BigInt?
  dirEntregaId                BigInt?
  dirFiscalId                 BigInt?
  
  // Responsables
  respVentasId                BigInt                                 // Responsable de ventas
  autorizaVentaId             BigInt                                 // Quien autoriza
  supervisorVentaCampoId      BigInt?
  respEmbarqueId              BigInt?
  respProduccionId            BigInt?
  respAlmacenId               BigInt?
  
  // Datos comerciales
  tipoProductoId              BigInt
  formaPagoId                 BigInt
  bancoId                     BigInt?
  monedaId                    BigInt
  tipoCambio                  Decimal     @db.Decimal(18, 6)
  
  // Datos de exportación
  esExportacion               Boolean     @default(false)
  paisDestinoId               BigInt?
  incotermsId                 BigInt?
  puertoCargaId               BigInt?
  puertoDescargaId            BigInt?
  
  // Logística
  agenteAduanasId             BigInt?
  operadorLogisticoId         BigInt?
  navieraId                   BigInt?
  tipoContenedorId            BigInt?
  cantidadContenedores        Int?
  pesoMaximoContenedor        Decimal?    @db.Decimal(18, 3)
  
  // Fechas logísticas
  fechaEntregaEstimada        DateTime
  fechaZarpeEstimada          DateTime?
  fechaArriboEstimada         DateTime?
  diasTransito                Int?
  
  // Impuestos
  porcentajeIGV               Decimal?    @db.Decimal(5, 2)
  esExoneradoAlIGV            Boolean     @default(false)
  
  // Cálculo de costos y utilidad
  metodoCalculoFactor         String      @db.VarChar(20) @default("PORCENTUAL")  // "PORCENTUAL" o "POR_PESO"
  factorExportacion           Decimal     @db.Decimal(18, 6)         // Factor calculado de costos exportación
  margenUtilidadPorcentaje    Decimal?    @db.Decimal(5, 2)          // % de utilidad deseada
  
  // Adelantos
  montoAdelantadoCliente      Decimal?    @db.Decimal(18, 2)
  porcentajeAdelanto          Decimal?    @db.Decimal(5, 2)
  
  // Estado y aprobación
  estadoId                    BigInt
  motivoRechazo               String?     @db.Text
  fechaAprobacion             DateTime?
  aprobadoPorId               BigInt?
  
  // Conversión a PreFactura
  prefacturaVentaId           BigInt?
  fechaConversionPreFactura   DateTime?
  usuarioConversionId         BigInt?
  
  // Campos SUNAT
  destinoProductoId           BigInt?
  formaTransaccionId          BigInt?
  modoDespachoRecepcionId     BigInt?
  tipoEstadoProductoId        BigInt?
  
  observaciones               String?     @db.Text
  observacionesInternas       String?     @db.Text
  urlCotizacionPdf            String?     @db.VarChar(500)
  urlDocumentacionRequeridaPdf String?     @db.VarChar(500)

  centroCostoId               BigInt?
  
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  // Relaciones
  empresa                     Empresa                  @relation(fields: [empresaId], references: [id])
  cliente                     EntidadComercial         @relation(fields: [clienteId], references: [id])
  tipoDocumento               TipoDocumento            @relation(fields: [tipoDocumentoId], references: [id])
  moneda                      Moneda                   @relation(fields: [monedaId], references: [id])
  formaPago                   FormaPago                @relation(fields: [formaPagoId], references: [id])
  incoterms                   Incoterm?                @relation(fields: [incotermsId], references: [id])
  serieDoc                    SerieDoc                 @relation(fields: [serieDocId], references: [id])
  estado                      EstadoMultiFuncion       @relation(fields: [estadoId], references: [id])
  
  tipoProducto                TipoProducto             @relation(fields: [tipoProductoId], references: [id])
  tipoEstadoProducto          TipoEstadoProducto?      @relation(fields: [tipoEstadoProductoId], references: [id])
  destinoProducto             DestinoProducto?         @relation(fields: [destinoProductoId], references: [id])
  formaTransaccion            FormaTransaccion?        @relation(fields: [formaTransaccionId], references: [id])
  modoDespachoRecepcion       ModoDespachoRecepcion?   @relation(fields: [modoDespachoRecepcionId], references: [id])
  tipoContenedor              TipoContenedor?          @relation(fields: [tipoContenedorId], references: [id])

  cotizacionPadre             CotizacionVentas?        @relation("VersionesCotizacion", fields: [cotizacionPadreId], references: [id])
  versiones                   CotizacionVentas[]       @relation("VersionesCotizacion")
  
  detallesProductos           DetCotizacionVentas[]
  costosExportacion           CostosExportacionCotizacion[]
  documentosRequeridos        DetDocsReqCotizaVentas[]
  entregaARendir              EntregaARendirPVentas?
    preFacturas           PreFactura[]

  
  @@index([empresaId, fechaDocumento])
  @@index([estadoId])
  @@index([clienteId])
  @@index([codigo])
}

model TipoContenedor {
  id                BigInt       @id @default(autoincrement())
  codigo            String       @unique @db.VarChar(10)              // "FOB", "CIF", "DDP"
  nombre            String       @db.VarChar(100)                     // "Free On Board"
  descripcion       String?      @db.Text                             // Descripción detallada
  activo            Boolean      @default(true)
  
  fechaCreacion     DateTime     @default(now())
  fechaActualizacion DateTime?   @updatedAt
  creadoPor         BigInt?
  actualizadoPor    BigInt?

  cotizaciones      CotizacionVentas[]
  preFacturas       PreFactura[]
}

// ============================================
// 4. DETALLE DE PRODUCTOS (Cotización)
// ============================================
// Productos cotizados con cálculo de precios
// precioUnitario = costoUnitario × factorExportacion
// precioUnitarioFinal = precioUnitario × (1 + margenUtilidad)

model DetCotizacionVentas {
  id                          BigInt      @id @default(autoincrement())
  cotizacionVentasId          BigInt
  item                        Int
  productoId                  BigInt
  descripcionAdicional        String?     @db.Text
  
  cantidad                    Decimal     @db.Decimal(18, 3)
  pesoNeto                    Decimal?    @db.Decimal(18, 3)         // Para método POR_PESO
  
  // Cálculo de precios
  costoUnitarioEstimado       Decimal?    @db.Decimal(18, 6)         // Costo base del producto
  factorExportacionAplicado   Decimal?    @db.Decimal(18, 6)         // Factor aplicado
  precioUnitario              Decimal     @db.Decimal(18, 6)         // = costo × factor

  // 🆕 AGREGAR: Trazabilidad de precio especial (PrecioEntidad)
  precioEntidadId             BigInt?                                 // FK a PrecioEntidad (nullable)
  precioEntidadOriginal       Decimal?    @db.Decimal(18, 6)         // Precio que se jaló de PrecioEntidad (histórico)
  precioFueEditado            Boolean     @default(false)             // true si usuario modificó el precio especial
  
  // 🆕 AGREGAR: Márgenes de utilidad (copiados del producto, editables en cotización)
  margenMinimoPermitido       Decimal?    @db.Decimal(5, 2)          // % mínimo de margen
  margenUtilidadObjetivo      Decimal?    @db.Decimal(5, 2)          // % objetivo de margen
  margenUtilidadReal          Decimal?    @db.Decimal(5, 2)          // % real calculado: ((precioFinal - precioUnitario) / precioFinal) × 100

  precioUnitarioFinal         Decimal     @db.Decimal(18, 6)         // = precioUnitario × (1 + margen)
  
  // Trazabilidad de producción
  loteProduccion              String?     @db.VarChar(50)
  fechaProduccion             DateTime?
  fechaVencimiento            DateTime?
  temperaturaAlmacenamiento   String?     @db.VarChar(50)
  
  movSalidaAlmacenId          BigInt?
  observaciones               String?     @db.Text
  centroCostoId               BigInt
  
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  cotizacionVentas            CotizacionVentas @relation(fields: [cotizacionVentasId], references: [id], onDelete: Cascade)
  producto                    Producto @relation(fields: [productoId], references: [id])
    // 🆕 AGREGAR: Relación con PrecioEntidad (nullable)
  precioEntidad               PrecioEntidad? @relation(fields: [precioEntidadId], references: [id])


  @@index([cotizacionVentasId])
  @@index([productoId])
  // 🆕 AGREGAR: Índice para búsquedas por precio especial
  @@index([precioEntidadId])
}

// ============================================
// 5. COSTOS DE EXPORTACIÓN (Detalle por Cotización)
// ============================================
// Costos estimados y reales de exportación
// Permite calcular factor y comparar estimado vs real

model CostosExportacionCotizacion {
  id                          BigInt      @id @default(autoincrement())
  cotizacionVentasId          BigInt
  productoId                  BigInt                                 // Producto de Familia "Gastos Exportación"  
  // ESTIMADO (al cotizar)
  montoEstimado               Decimal     @db.Decimal(18, 2)
  monedaId                    BigInt
  tipoCambioAplicado          Decimal?    @db.Decimal(18, 6)
  montoEstimadoMonedaBase     Decimal     @db.Decimal(18, 2)         // Convertido a moneda de cotización
  
  // REAL (después de exportar)
  montoReal                   Decimal?    @db.Decimal(18, 2)
  montoRealMonedaBase         Decimal?    @db.Decimal(18, 2)
  variacionMonto              Decimal?    @db.Decimal(18, 2)         // Real - Estimado
  variacionPorcentaje         Decimal?    @db.Decimal(5, 2)          // % de variación
  movimientoEntregaRendirId   BigInt?                                // Vincula con gasto real
  
  aplicaSegunIncoterm         Boolean     @default(true)
  proveedorId                 BigInt?
  requiereDocumento           Boolean     @default(false)
  documentoAsociadoId         BigInt?
  esObligatorio               Boolean     @default(true)
  orden                       Int
  
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  cotizacionVentas            CotizacionVentas @relation(fields: [cotizacionVentasId], references: [id], onDelete: Cascade)
  producto                    Producto @relation("CostoExportacionProducto", fields: [productoId], references: [id])
  moneda                      Moneda @relation(fields: [monedaId], references: [id])
  proveedor                   EntidadComercial? @relation("ProveedorCostoExport", fields: [proveedorId], references: [id])
  movimientoEntregaRendir     DetMovsEntregaRendirPVentas? @relation(fields: [movimientoEntregaRendirId], references: [id])
  documentoAsociado           DocRequeridaVentas? @relation("CostoExportacionDocumento", fields: [documentoAsociadoId], references: [id])

  @@index([cotizacionVentasId])
  @@index([productoId])
  @@index([movimientoEntregaRendirId])
}

// ============================================
// 6. DOCUMENTOS REQUERIDOS (Detalle por Cotización)
// ============================================
// Documentos específicos requeridos para esta cotización
// con seguimiento de estado y vencimientos

model DetDocsReqCotizaVentas {
  id                          BigInt      @id @default(autoincrement())
  cotizacionVentasId          BigInt
  docRequeridaVentasId        BigInt
  esObligatorio               Boolean     @default(true)
  numeroDocumento             String?     @db.VarChar(100)
  fechaEmision                DateTime?
  fechaVencimiento            DateTime?
  urlDocumento                String?     @db.VarChar(500)
  verificado                  Boolean     @default(false)
  fechaVerificacion           DateTime?
  verificadoPorId             BigInt?
  observacionesVerificacion   String?     @db.Text
  costoDocumento              Decimal?    @db.Decimal(18, 2)
  monedaId                    BigInt?
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  cotizacionVentas            CotizacionVentas @relation(fields: [cotizacionVentasId], references: [id], onDelete: Cascade)
  docRequeridaVentas          DocRequeridaVentas @relation(fields: [docRequeridaVentasId], references: [id])
  moneda                      Moneda? @relation("MonedaDetDocsReqCotizaVentas", fields: [monedaId], references: [id])

  @@index([cotizacionVentasId])
}

// ============================================
// 7. CATÁLOGO DE DOCUMENTOS REQUERIDOS
// ============================================
// Catálogo maestro de documentos para exportación
// Define qué documentos existen y sus características

model DocRequeridaVentas {
  id                          BigInt      @id @default(autoincrement())
  nombre                      String      @db.VarChar(255)           // "Certificado Sanitario SANIPES"
  descripcion                 String?     @db.Text
  
  // Reglas de aplicabilidad
  aplicaPorPais               Boolean     @default(false)            // ¿Varía según país destino?
  aplicaPorProducto           Boolean     @default(false)            // ¿Varía según tipo producto?
  aplicaPorIncoterm           Boolean     @default(false)            // ¿Varía según Incoterm?
  esObligatorioPorDefecto     Boolean     @default(true)
  
  // Vigencia
  tieneVencimiento            Boolean     @default(false)
  diasValidez                 Int?                                   // Días de validez del documento
  
  // Costo
  costoEstimado               Decimal?    @db.Decimal(18, 2)
  monedaId                    BigInt?
  
  activo                      Boolean     @default(true)
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  moneda                      Moneda? @relation(fields: [monedaId], references: [id])
  documentosRequeridos        DetDocsReqCotizaVentas[]
  requisitosPorPais           RequisitoDocPorPais[]
  costosCotizacionAsociados   CostosExportacionCotizacion[] @relation("CostoExportacionDocumento")
  costosIncotermAsociados     CostoExportacionPorIncoterm[] @relation("CostoIncotermDocumento")
}

// ============================================
// 8. REQUISITOS DE DOCUMENTOS POR PAÍS
// ============================================
// Define qué documentos son obligatorios para cada país/producto
// Ejemplo: China + Langostinos = Certificado Sanitario obligatorio

model RequisitoDocPorPais {
  id                          BigInt      @id @default(autoincrement())
  docRequeridaVentasId        BigInt
  paisId                      BigInt
  tipoProductoId              BigInt?                                // NULL = aplica a todos los productos
  esObligatorio               Boolean     @default(true)
  observaciones               String?     @db.Text
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  docRequeridaVentas          DocRequeridaVentas @relation(fields: [docRequeridaVentasId], references: [id])
  pais                        Pais @relation(fields: [paisId], references: [id])
  tipoProducto                TipoProducto? @relation(fields: [tipoProductoId], references: [id])
  
  @@unique([docRequeridaVentasId, paisId, tipoProductoId])
}

// ============================================
// 9. ENTREGA A RENDIR PROCESO DE VENTAS
// ============================================
// Control de dinero entregado para gastos de exportación
// Totales se calculan desde DetMovsEntregaRendirPVentas
model EntregaARendirPVentas {
  id                          BigInt      @id @default(autoincrement())
  cotizacionVentasId          BigInt      @unique
  respEntregaRendirId         BigInt                                 // Personal responsable
  entregaLiquidada            Boolean     @default(false)
  fechaLiquidacion            DateTime?
  centroCostoId               BigInt
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?
  urlLiquidacionPdf String?
  respLiquidacionId BigInt?

  cotizacionVentas            CotizacionVentas @relation(fields: [cotizacionVentasId], references: [id])
  movimientos                 DetMovsEntregaRendirPVentas[]
  respLiquidacion Personal? @relation("LiquidadorVentas", fields: [respLiquidacionId], references: [id])
  respEntregaRendir Personal @relation("ResponsableEntregaVentas", fields: [respEntregaRendirId], references: [id])
  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id])
  
  @@index([cotizacionVentasId])
  @@index([respEntregaRendirId])
  @@index([entregaLiquidada])
}

// ============================================
// 10. DETALLE MOVIMIENTOS ENTREGA A RENDIR
// ============================================
// Registro de gastos reales de exportación
// Se vincula con CostosExportacionCotizacion para comparar estimado vs real

model DetMovsEntregaRendirPVentas {
  id                          BigInt      @id @default(autoincrement())
  entregaARendirPVentasId     BigInt
  responsableId               BigInt
  fechaMovimiento             DateTime
  tipoMovimientoId            BigInt                                 // ENTREGA_INICIAL, GASTO, DEVOLUCION, AMPLIACION
  productoId                  BigInt?                                // Producto de Familia "Gastos Exportación"
  monto                       Decimal     @db.Decimal(18, 2)
  descripcion                 String?     @db.Text
  monedaId                    BigInt
  tipoCambio                  Decimal?    @db.Decimal(18, 6)
  entidadComercialId          BigInt?                                // Proveedor al que se pagó
  
  // Comprobante
  tipoDocumentoId             BigInt?
  numeroSerieComprobante      String?     @db.VarChar(20)
  numeroCorrelativoComprobante String?    @db.VarChar(20)
  urlComprobanteMovimiento    String?     @db.VarChar(500)
  
  // Validaciones
  operacionSinFactura         Boolean     @default(false)
  validadoTesoreria           Boolean     @default(false)
  fechaValidacionTesoreria    DateTime?
  validadoPorId               BigInt?
  
  // Integración con Caja
  operacionMovCajaId          BigInt?
  fechaOperacionMovCaja       DateTime?
  urlComprobanteOperacionMovCaja String?  @db.VarChar(500)
  moduloOrigenMovCajaId       BigInt?
  
  centroCostoId               BigInt
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime?   @updatedAt
  creadoPor                   BigInt?
  actualizadoPor              BigInt?

  entregaARendirPVentas       EntregaARendirPVentas @relation(fields: [entregaARendirPVentasId], references: [id], onDelete: Cascade)
  tipoMovimiento              TipoMovEntregaRendir @relation(fields: [tipoMovimientoId], references: [id])
  producto                    Producto? @relation("MovimientoGastoExportacion", fields: [productoId], references: [id])
  entidadComercial            EntidadComercial? @relation("ProveedorMovPVentas", fields: [entidadComercialId], references: [id])
  moneda                      Moneda @relation(fields: [monedaId], references: [id])
  tipoDocumento               TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  
  costosEstimadosVinculados   CostosExportacionCotizacion[]          // Relación inversa para vincular con estimados
  
  @@index([entregaARendirPVentasId])
  @@index([productoId])
}


// ============================================
// PreFactura - Nota de Venta Interna
// Origen de todos los comprobantes electrónicos (Factura/Boleta/NC/ND)
// ============================================

model PreFactura {
  id                          BigInt      @id @default(autoincrement())
  
  // Documento PreFactura
  codigo                      String      @unique @db.VarChar(30)          // Código único de PreFactura (ej: PF-2024-000001)
  empresaId                   BigInt                                       // Empresa emisora
  tipoDocumentoId             BigInt                                       // Tipo de documento interno
  serieDocId                  BigInt                                       // Serie del documento interno
  numeroDocumento             String?     @db.VarChar(40)                  // Número completo del documento (ej: "PF01-000123")
  numSerieDoc                 String?     @db.VarChar(40)                  // Serie (ej: "PF01")
  numCorreDoc                 String?     @db.VarChar(40)                  // Correlativo (ej: "000123")
  fechaDocumento              DateTime    @default(now())                  // Fecha de emisión de la PreFactura
  fechaVencimiento            DateTime?                                    // Fecha de vencimiento del pago
  
  // ========================================
  // ⭐ CAMPOS NUEVOS - DOCUMENTO FINAL (COMPROBANTE ELECTRÓNICO)
  // Define qué comprobante electrónico se generará desde esta PreFactura
  // ========================================
  tipoDocumentoFinalId        BigInt?                                      // ⭐ NUEVO: Tipo de comprobante a generar (01=Factura, 03=Boleta)
  serieDocFinalId             BigInt?                                      // ⭐ NUEVO: Serie del comprobante a generar
  numeroDocumentoFinal        String?     @db.VarChar(40)                  // ⭐ NUEVO: Número completo generado (ej: "F001-00000123")
  numSerieDocFinal            String?     @db.VarChar(40)                  // ⭐ NUEVO: Serie generada (ej: "F001")
  numCorreDocFinal            String?     @db.VarChar(40)                  // ⭐ NUEVO: Correlativo generado (ej: "00000123")
  facturado                   Boolean?    @default(false)                  // ⭐ NUEVO: true = Ya se generó comprobante o CxC
  fechaFacturacion            DateTime?                                    // ⭐ NUEVO: Fecha de generación del comprobante o CxC
  
  // ========================================
  // ⭐ CAMPOS NUEVOS - TIPO DE FACTURACIÓN Y PARTICIÓN
  // ========================================
  esGerencial                 Boolean?    @default(false)                  // ⭐ NUEVO: true = Facturación Negra (Gerencial/No SUNAT), false = Blanca (Formal/SUNAT)
  preFacturaOrigenId          BigInt?                                      // ⭐ NUEVO: ID de la PreFactura original si esta fue creada por partición
  esParticionada              Boolean     @default(false)                  // ⭐ NUEVO: true = Esta PreFactura fue partida en Blanca/Negra (se anula y crea 2 nuevas)
  
  // Cliente
  clienteId                   BigInt                                       // Cliente al que se emite la PreFactura
  contactoClienteId           BigInt?                                      // Contacto del cliente
  dirEntregaId                BigInt?                                      // Dirección de entrega
  dirFiscalId                 BigInt?                                      // Dirección fiscal
  
  // Responsables
  respVentasId                BigInt                                       // Responsable de ventas
  autorizaVentaId             BigInt?                                      // Quien autoriza la venta
  supervisorVentaCampoId      BigInt?                                      // Supervisor de venta en campo
  respEmbarqueId              BigInt?                                      // Responsable de embarque
  respProduccionId            BigInt?                                      // Responsable de producción
  respAlmacenId               BigInt?                                      // Responsable de almacén
  
  // Datos comerciales
  tipoProductoId              BigInt                                       // Tipo de producto (CHD, CHI, Conserva, etc.)
  formaPagoId                 BigInt                                       // Forma de pago (Contado, Crédito, etc.)
  bancoId                     BigInt?                                      // Banco (si aplica)
  monedaId                    BigInt                                       // Moneda (PEN, USD, EUR)
  tipoCambio                  Decimal     @db.Decimal(18, 6)               // Tipo de cambio del día
  
  // Montos (se calculan desde DetallePreFactura)
  subtotal                    Decimal     @db.Decimal(18, 2)               // Suma de (cantidad × precio) de todos los detalles
  totalDescuentos             Decimal?    @db.Decimal(18, 2)               // Total de descuentos aplicados
  totalIGV                    Decimal     @db.Decimal(18, 2)               // Total de IGV (18%)
  total                       Decimal     @db.Decimal(18, 2)               // Total final a pagar
  
  // Adelantos
  montoAdelantadoCliente      Decimal?    @db.Decimal(18, 2)               // Monto adelantado por el cliente
  porcentajeAdelanto          Decimal?    @db.Decimal(5, 2)                // Porcentaje de adelanto (0-100)
  
  // Estado y aprobación
  estadoId                    BigInt                                       // Estado de la PreFactura (ver estados abajo)
  motivoRechazo               String?     @db.Text                         // Motivo de rechazo si fue rechazada
  fechaAprobacion             DateTime?                                    // Fecha de aprobación
  aprobadoPorId               BigInt?                                      // Quién aprobó la PreFactura
  
  // Origen
  cotizacionVentaId           BigInt?                                      // Cotización de venta origen (si aplica)
  
  // Exportación (si aplica)
  incotermId                  BigInt?                                      // Incoterm (FOB, CIF, etc.)
  puertoEmbarqueId            BigInt?                                      // Puerto de embarque
  puertoDestinoId             BigInt?                                      // Puerto de destino
  paisDestinoId               BigInt?                                      // País de destino
  agenteAduanaId              BigInt?                                      // Agente de aduana
  numeroBuque                 String?     @db.VarChar(100)                 // Número de buque
  numeroBL                    String?     @db.VarChar(100)                 // Número de Bill of Lading
  numContenedor               String?     @db.VarChar(100)                 // Número de contenedor
  tipoContenedorId            BigInt?                                      // Tipo de contenedor (20', 40', etc.)
  
  // Impuestos
  exoneradoIgv                Boolean     @default(false)                  // true = Exonerado de IGV
  porcentajeIgv               Decimal?    @db.Decimal(5, 2)                // Porcentaje de IGV (normalmente 18%)
  
  // Factores exportación
  factorExportacion           Decimal?    @db.Decimal(18, 6)               // Factor de exportación estimado
  factorExportacionReal       Decimal?    @db.Decimal(18, 6)               // Factor de exportación real
  
  // Otros
  observaciones               String?     @db.Text                         // Observaciones generales
  urlPreFacturaPdf            String?     @db.VarChar(500)                 // URL del PDF de la PreFactura
  centroCostoId               BigInt?                                      // Centro de costo
  contratoServicioId          BigInt?                                      // Contrato de servicio relacionado
  movSalidaAlmacenId          BigInt?                                      // Movimiento de salida de almacén relacionado
  
  // Auditoría
  fechaCreacion               DateTime    @default(now())                  // Fecha de creación del registro
  fechaActualizacion          DateTime?   @updatedAt                       // Fecha de última actualización
  creadoPor                   BigInt?                                      // Usuario que creó el registro
  actualizadoPor              BigInt?                                      // Usuario que actualizó el registro
  
  // Relaciones
  empresa                     Empresa                 @relation(fields: [empresaId], references: [id])
  tipoDocumento               TipoDocumento           @relation(fields: [tipoDocumentoId], references: [id])
  serieDoc                    SerieDoc                @relation(fields: [serieDocId], references: [id])
  cliente                     EntidadComercial        @relation("ClientePreFactura", fields: [clienteId], references: [id])
  contactoCliente             ContactoEntidad?        @relation(fields: [contactoClienteId], references: [id])
  dirEntrega                  DireccionEntidad?       @relation("DirEntrega", fields: [dirEntregaId], references: [id])
  dirFiscal                   DireccionEntidad?       @relation("DirFiscal", fields: [dirFiscalId], references: [id])
  respVentas                  Personal                @relation("RespVentas", fields: [respVentasId], references: [id])
  autorizaVenta               Personal?               @relation("AutorizaVenta", fields: [autorizaVentaId], references: [id])
  tipoProducto                TipoProducto            @relation(fields: [tipoProductoId], references: [id])
  formaPago                   FormaPago               @relation(fields: [formaPagoId], references: [id])
  banco                       Banco?                  @relation(fields: [bancoId], references: [id])
  moneda                      Moneda?                 @relation(fields: [monedaId], references: [id])
  incoterm                    Incoterm?               @relation(fields: [incotermId], references: [id])
  tipoContenedor              TipoContenedor?         @relation(fields: [tipoContenedorId], references: [id])
  cotizacionVenta             CotizacionVentas?       @relation(fields: [cotizacionVentaId], references: [id])
  contratoServicio            ContratoServicio?       @relation("PreFacturaContrato", fields: [contratoServicioId], references: [id])
  movSalidaAlmacen            MovimientoAlmacen?      @relation("MovimientoAlmacenToPreFactura", fields: [movSalidaAlmacenId], references: [id])
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - FACTURACIÓN ELECTRÓNICA
  // ========================================
  tipoDocumentoFinal          TipoDocumento?          @relation("TipoDocumentoFinal", fields: [tipoDocumentoFinalId], references: [id])    // ⭐ NUEVO
  serieDocFinal               SerieDoc?               @relation("SerieDocFinal", fields: [serieDocFinalId], references: [id])              // ⭐ NUEVO
  comprobantesElectronicos    ComprobanteElectronico[]                                                                                     // ⭐ NUEVO: 1:N - Comprobantes generados
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - PARTICIÓN
  // ========================================
  preFacturaOrigen            PreFactura?             @relation("ParticionPreFactura", fields: [preFacturaOrigenId], references: [id])    // ⭐ NUEVO: PreFactura madre
  preFacturasHijas            PreFactura[]            @relation("ParticionPreFactura")                                                     // ⭐ NUEVO: PreFacturas hijas (Blanca y Negra)
  
  // ========================================
  // ⭐ RELACIONES NUEVAS - MÓDULO FINANCIERO
  // ========================================
  cuentaPorCobrar             CuentaPorCobrar?                                                                                             // ⭐ NUEVO: 1:1 - Cuenta por cobrar generada
  
  // Relaciones inversas
  detalles                    DetallePreFactura[]                                                                                          // Detalles de productos
  
  // Índices
  @@index([empresaId, fechaDocumento])
  @@index([clienteId])
  @@index([estadoId])
  @@index([cotizacionVentaId])
  @@index([facturado])                                                   // ⭐ NUEVO: Filtrar pendientes de facturar
  @@index([tipoDocumentoFinalId])                                        // ⭐ NUEVO: Filtrar por tipo de comprobante
  @@index([serieDocFinalId])                                             // ⭐ NUEVO: Búsquedas por serie
  @@index([esGerencial])                                                 // ⭐ NUEVO: Filtrar Gerenciales (Negras) vs Formales (Blancas)
  @@index([preFacturaOrigenId])                                          // ⭐ NUEVO: Trazabilidad de particiones
  @@index([esParticionada])                                              // ⭐ NUEVO: Filtrar PreFacturas particionadas
}


// ============================================
// 12. DETALLE DE PREFACTURA
// ============================================
// Productos incluidos en la PreFactura
