// ============================================
// ComprobanteElectronico
// Comprobantes electrónicos SUNAT (Factura, Boleta, NC, ND)
// Integrado con Nubefact OSE
// ============================================

model ComprobanteElectronico {
  id                        BigInt                  @id @default(autoincrement())
  
  // Origen obligatorio
  preFacturaId              BigInt                                       // PreFactura origen (obligatorio)
  
  // Empresa y sede
  empresaId                 BigInt                                       // Empresa emisora
  sedeId                    BigInt                                       // Sede emisora
  
  // Tipo y serie SUNAT
  tipoComprobanteId         BigInt                                       // Tipo: 01=Factura, 03=Boleta, 07=NC, 08=ND
  serieDocId                BigInt                                       // Serie del documento
  numeroSerie               String                  @db.VarChar(4)       // Serie (ej: "F001", "B001")
  numeroCorrelativo         Int                                          // Correlativo numérico
  numeroCompleto            String                  @db.VarChar(20)      // Número completo (ej: "F001-00000123")
  
  // Fechas
  fechaEmision              DateTime                @default(now())      // Fecha de emisión del comprobante
  horaEmision               String                  @db.VarChar(8)       // Hora de emisión (ej: "14:30:00")
  fechaVencimiento          DateTime?                                    // Fecha de vencimiento del pago
  
  // Cliente
  entidadComercialId        BigInt                                       // Cliente receptor
  tipoDocumentoClienteId    BigInt                                       // Tipo documento: 1=DNI, 6=RUC
  numeroDocumentoCliente    String                  @db.VarChar(20)      // Número de documento del cliente
  razonSocialCliente        String                  @db.VarChar(255)     // Razón social o nombre del cliente
  direccionCliente          String                  @db.Text             // Dirección del cliente
  emailCliente              String?                 @db.VarChar(100)     // Email del cliente
  
  // Moneda
  monedaId                  BigInt                                       // Moneda: PEN, USD, EUR
  tipoCambio                Decimal                 @db.Decimal(10, 4)   // Tipo de cambio del día
  
  // Condiciones de pago
  formaPagoId               BigInt                                       // Forma de pago: Contado, Crédito
  montoPendientePago        Decimal?                @db.Decimal(18, 2)   // Monto pendiente de pago
  
  // Datos adicionales
  ordenCompra               String?                 @db.VarChar(50)      // Orden de compra del cliente
  guiaRemision              String?                 @db.VarChar(50)      // Guía de remisión asociada
  
  // Detracción
  sujetoDetraccion          Boolean                 @default(false)      // true = Sujeto a detracción
  codigoDetraccion          String?                 @db.VarChar(10)      // Código de detracción SUNAT
  porcentajeDetraccion      Decimal?                @db.Decimal(5, 2)    // Porcentaje de detracción (0-100)
  montoDetraccion           Decimal?                @db.Decimal(18, 2)   // Monto de detracción calculado
  
  // Percepción
  sujetoPercepcion          Boolean                 @default(false)      // true = Sujeto a percepción
  codigoPercepcion          String?                 @db.VarChar(10)      // Código de percepción SUNAT
  porcentajePercepcion      Decimal?                @db.Decimal(5, 2)    // Porcentaje de percepción (0-100)
  montoPercepcion           Decimal?                @db.Decimal(18, 2)   // Monto de percepción calculado
  
  // Retención
  sujetoRetencion           Boolean                 @default(false)      // true = Sujeto a retención
  porcentajeRetencion       Decimal?                @db.Decimal(5, 2)    // Porcentaje de retención (0-100)
  montoRetencion            Decimal?                @db.Decimal(18, 2)   // Monto de retención calculado
  
  // NC/ND - Documentos relacionados
  tipoNotaId                BigInt?                                      // Tipo de nota (solo para NC/ND)
  motivoNotaCreditoDebitoId BigInt?                                      // ⭐ NUEVO: Motivo de NC/ND (reemplaza motivoNotaId)
  comprobanteModificaId     BigInt?                                      // FK al comprobante que modifica (solo para NC/ND)
  
  // Nubefact - Credenciales
  nubefactRuta              String?                 @db.VarChar(100)     // Ruta de Nubefact (demo/producción)
  nubefactToken             String?                 @db.VarChar(200)     // Token de autenticación Nubefact
  
  // Nubefact - Respuesta
  nubefactAceptadoPorSunat  Boolean?                                     // true = SUNAT aceptó el comprobante
  nubefactSunatTransaction  Int?                    @default(1)          // Transacción SUNAT
  nubefactEnlacePDF         String?                 @db.VarChar(500)     // URL del PDF en Nubefact
  nubefactEnlaceXML         String?                 @db.VarChar(500)     // URL del XML en Nubefact
  nubefactEnlaceCDR         String?                 @db.VarChar(500)     // URL del CDR en Nubefact
  nubefactSunatDescription  String?                 @db.Text             // Descripción de respuesta SUNAT
  nubefactSunatNote         String?                 @db.Text             // Nota de respuesta SUNAT
  nubefactSunatResponsecode String?                 @db.VarChar(10)      // Código de respuesta SUNAT
  nubefactSunatSoapError    String?                 @db.Text             // Error SOAP si hubo
  nubefactCadenaParaQr      String?                 @db.Text             // Cadena para generar QR
  nubefactHashCpe           String?                 @db.VarChar(100)     // Hash del CPE
  nubefactQr                String?                 @db.Text             // Código QR en base64
  
  // Archivos locales
  rutaLocalPDF              String?                 @db.VarChar(500)     // Ruta local del PDF
  rutaLocalXML              String?                 @db.VarChar(500)     // Ruta local del XML
  rutaLocalCDR              String?                 @db.VarChar(500)     // Ruta local del CDR
  
  // Estado OSE
  estadoOSEId               BigInt                                       // Estado OSE: 50=PENDIENTE, 51=ENVIADO, 52=ACEPTADO, 53=RECHAZADO, 54=ERROR
  fechaEnvioOSE             DateTime?                                    // Fecha de envío a OSE
  fechaRespuestaOSE         DateTime?                                    // Fecha de respuesta de OSE
  
  // Estado SUNAT
  estadoSUNATId             BigInt                                       // Estado SUNAT: 60=ACTIVO, 61=ANULADO, 62=BAJA, 63=BAJA_ACEPTADA
  fechaBaja                 DateTime?                                    // Fecha de baja del comprobante
  motivoBaja                String?                 @db.Text             // Motivo de baja
  ticketBaja                String?                 @db.VarChar(50)      // Ticket de baja SUNAT
  
  // Envío email
  enviadoEmail              Boolean                 @default(false)      // true = Email enviado al cliente
  fechaEnvioEmail           DateTime?                                    // Fecha de envío de email
  
  observaciones             String?                 @db.Text             // Observaciones generales
  
  // Auditoría
  fechaCreacion             DateTime                @default(now())      // Fecha de creación del registro
  fechaActualizacion        DateTime?               @updatedAt           // Fecha de última actualización
  creadoPor                 BigInt?                                      // Usuario que creó el registro
  actualizadoPor            BigInt?                                      // Usuario que actualizó el registro
  
  // Relaciones
  preFactura                PreFactura              @relation(fields: [preFacturaId], references: [id])
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id])
  sede                      SedesEmpresa            @relation(fields: [sedeId], references: [id])
  tipoComprobante           TipoDocumento           @relation(fields: [tipoComprobanteId], references: [id])
  serieDoc                  SerieDoc                @relation(fields: [serieDocId], references: [id])
  entidadComercial          EntidadComercial        @relation(fields: [entidadComercialId], references: [id])
  tipoDocumentoCliente      TiposDocIdentidad       @relation(fields: [tipoDocumentoClienteId], references: [id])
  moneda                    Moneda                  @relation(fields: [monedaId], references: [id])
  formaPago                 FormaPago               @relation(fields: [formaPagoId], references: [id])
  motivoNotaCreditoDebito   MotivoNotaCreditoDebito? @relation("MotivoNCNDComprobante", fields: [motivoNotaCreditoDebitoId], references: [id])
  comprobanteModifica       ComprobanteElectronico? @relation("NotasModificacion", fields: [comprobanteModificaId], references: [id])
  
  // ========================================
  // ⭐ RELACIÓN NUEVA - CUENTAS POR COBRAR
  // ========================================
  cuentasPorCobrar          CuentaPorCobrar[]                            // ⭐ NUEVO: CxC Blancas generadas desde este comprobante
  
    // Relaciones inversas
  notasRelacionadas         ComprobanteElectronico[] @relation("NotasModificacion") // NC/ND que modifican este comprobante
  detalles                  DetalleComprobante[]                         // Detalles de productos
  cuotas                    CuotaPagoComprobante[]                       // Cuotas de pago
  enviosOSE                 EnvioOSE[]                                   // Envíos a OSE

  // Índices
  @@index([preFacturaId])
  @@index([empresaId])
  @@index([entidadComercialId])
  @@index([fechaEmision])
  @@index([estadoOSEId])
  @@index([estadoSUNATId])
  @@index([tipoComprobanteId])
  @@index([numeroCompleto])
  @@index([comprobanteModificaId])
}


// ============================================
// DetalleComprobante
// Líneas del Comprobante Electrónico
// ============================================

model DetalleComprobante {
  id                        BigInt                  @id @default(autoincrement())
  comprobanteElectronicoId  BigInt
  numeroLinea               Int
  
  // Producto/Servicio
  productoId                BigInt?
  codigoProducto            String?                 @db.VarChar(50)
  codigoProductoSunat       String?                 @db.VarChar(50)
  descripcion               String                  @db.Text
  
  // Unidad de medida
  unidadMedidaId            BigInt
  codigoUnidadSUNAT         String                  @db.VarChar(10)      // "NIU", "KGM"
  nombreUnidad              String?                 @db.VarChar(50)
  
  // Cantidades y precios
  cantidad                  Decimal                 @db.Decimal(18, 4)
  valorUnitario             Decimal                 @db.Decimal(18, 6)   // Sin IGV
  precioUnitario            Decimal                 @db.Decimal(18, 6)   // Con IGV
  
  // Valores
  subtotal                  Decimal                 @db.Decimal(18, 2)
  porcentajeDescuento       Decimal?                @db.Decimal(5, 2)
  descuento                 Decimal?                @db.Decimal(18, 2)
  
  // Tributos
  tipoAfectacionIGVId       BigInt
  igv                       Decimal                 @db.Decimal(18, 2)
  porcentajeIgv             Decimal                 @db.Decimal(5, 2)
  isc                       Decimal?                @db.Decimal(18, 2)
  
  // Total línea
  total                     Decimal                 @db.Decimal(18, 2)
  
  anticipo                  Boolean?                @default(false)
  
  comprobanteElectronico    ComprobanteElectronico  @relation(fields: [comprobanteElectronicoId], references: [id], onDelete: Cascade)
  producto                  Producto?               @relation(fields: [productoId], references: [id])
  unidadMedida              UnidadMedida            @relation(fields: [unidadMedidaId], references: [id])
  tipoAfectacionIGV         TipoAfectacionIGV       @relation(fields: [tipoAfectacionIGVId], references: [id])
  
  @@index([comprobanteElectronicoId])
  @@index([productoId])
  @@index([tipoAfectacionIGVId])
}



// ============================================
// CuotaPagoComprobante
// Cuotas de Pago (Crédito)
// ============================================

model CuotaPagoComprobante {
  id                        BigInt                  @id @default(autoincrement())
  comprobanteElectronicoId  BigInt
  numeroCuota               Int
  fechaVencimiento          DateTime
  montoCuota                Decimal                 @db.Decimal(18, 2)
  pagado                    Boolean                 @default(false)
  fechaPago                 DateTime?
  montoPagado               Decimal?                @db.Decimal(18, 2)
  
  comprobanteElectronico    ComprobanteElectronico  @relation(fields: [comprobanteElectronicoId], references: [id], onDelete: Cascade)
  
  @@index([comprobanteElectronicoId])
  @@index([fechaVencimiento])
  @@index([pagado])
}




// ============================================
// EnvioOSE
// Control de Envíos a Nubefact (Auditoría)
// ============================================

model EnvioOSE {
  id                        BigInt                  @id @default(autoincrement())
  comprobanteElectronicoId  BigInt
  numeroIntento             Int                     @default(1)
  fechaEnvio                DateTime                @default(now())
  payloadJSON               Json
  respuestaJSON             Json?
  aceptadoPorSunat          Boolean?
  codigoRespuesta           String?                 @db.VarChar(10)
  mensajeRespuesta          String?                 @db.Text
  estadoEnvio               String                  @db.VarChar(20)      // "ENVIADO", "ACEPTADO", "RECHAZADO", "ERROR"
  tieneError                Boolean                 @default(false)
  codigoError               String?                 @db.VarChar(50)
  mensajeError              String?                 @db.Text
  
  comprobanteElectronico    ComprobanteElectronico  @relation(fields: [comprobanteElectronicoId], references: [id])
  
  @@index([comprobanteElectronicoId])
  @@index([fechaEnvio])
  @@index([estadoEnvio])
  @@index([aceptadoPorSunat])
}


// ============================================
// CuentaPorCobrar
// Registro de deudas de clientes
// Puede originarse de PreFactura o ser saldo inicial
// ============================================

model CuentaPorCobrar {
  id                        BigInt      @id @default(autoincrement())
  
  // ========================================
  // ORIGEN DEL DOCUMENTO
  // ========================================
  preFacturaId              BigInt?     @unique                          // Opcional: PreFactura origen (null para saldos iniciales)
  empresaId                 BigInt                                       // Empresa acreedora
  clienteId                 BigInt                                       // Cliente deudor
  
  // ========================================
  // DOCUMENTO
  // ========================================
  numeroPreFactura          String      @db.VarChar(30)                  // Número de PreFactura o código de saldo inicial
  fechaEmision              DateTime                                     // Fecha de emisión de la deuda
  fechaVencimiento          DateTime                                     // Fecha de vencimiento del pago
  
  // ========================================
  // MONTOS ALMACENADOS (estilo SAP FI)
  // ========================================
  montoTotal                Decimal     @db.Decimal(18, 2)               // Total de la deuda original
  montoPagado               Decimal     @default(0.00) @db.Decimal(18, 2) // Se actualiza con cada pago
  saldoPendiente            Decimal     @db.Decimal(18, 2)               // montoTotal - montoPagado (se recalcula con cada pago)
  
  // ========================================
  // DETRACCIÓN SPOT (SUNAT PERÚ) - TOTALES
  // ========================================
  tieneDetraccion           Boolean     @default(false)                  // Aplica si producto está sujeto a detracción
  montoDetraccionTotal      Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado de detracciones
  porcentajeDetraccion      Decimal?    @db.Decimal(5, 2)                // % de detracción (4%, 10%, 12%, etc.)
  
  // ========================================
  // RETENCIÓN (SUNAT PERÚ) - TOTALES
  // ========================================
  tieneRetencion            Boolean     @default(false)                  // Aplica si cliente es agente de retención
  montoRetencionTotal       Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado de retenciones
  porcentajeRetencion       Decimal?    @db.Decimal(5, 2)                // ✅ AGREGADO: % de retención (generalmente 3%)
  
  // ========================================
  // PERCEPCIÓN (SUNAT PERÚ) - TOTALES
  // ========================================
  tienePercepcion           Boolean     @default(false)                  // Aplica si empresa es agente de percepción
  montoPercepcionTotal      Decimal     @default(0) @db.Decimal(18, 2)  // 🔄 RENOMBRADO: Total acumulado de percepciones
  porcentajePercepcion      Decimal?    @db.Decimal(5, 2)                // % de percepción
  
  // ========================================
  // FLAGS ESPECIALES
  // ========================================
  esSaldoInicial            Boolean     @default(false)                  // true = Saldo inicial de migración (sin PreFactura)
  esGerencial               Boolean     @default(false)                  // true = CxC Negra (Gerencial/No SUNAT), false = CxC Blanca (Formal/SUNAT)
  comprobanteElectronicoId  BigInt?                                      // Solo para CxC Blanca (tiene comprobante SUNAT asociado)
  
  // ========================================
  // MONEDA Y TIPO DE VENTA
  // ========================================
  monedaId                  BigInt                                       // Moneda de la deuda (PEN, USD, EUR)
  esContado                 Boolean                                      // true = Venta al contado, false = Venta al crédito
  estadoId                  BigInt                                       // Estado de la CxC (PENDIENTE, PAGADA, VENCIDA, PARCIAL, ANULADA)
  observaciones             String?     @db.Text                         // Observaciones generales

  // ========================================
  // INTEGRACIÓN CONTABLE
  // ========================================
  fechaContable             DateTime    @default(now())                  // ✅ AGREGADO: Fecha del período contable
  periodoContableId         BigInt?                                      // ✅ AGREGADO: Período contable (para control de cierre)
  
  // ========================================
  // AUDITORÍA
  // ========================================
  fechaCreacion         DateTime    @default(now())                  // Fecha de creación del registro
  fechaActualizacion    DateTime?   @updatedAt                       // Fecha de última actualización
  creadoPor             BigInt?                                      // Usuario que creó el registro
  actualizadoPor        BigInt?                                      // Usuario que actualizó el registro

  // ========================================
  // RELACIONES
  // ========================================
  preFactura                PreFactura?             @relation(fields: [preFacturaId], references: [id])
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id])
  cliente                   EntidadComercial        @relation(fields: [clienteId], references: [id])
  moneda                    Moneda                  @relation(fields: [monedaId], references: [id])
  estado                    EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  comprobanteElectronico    ComprobanteElectronico? @relation(fields: [comprobanteElectronicoId], references: [id])
  periodoContable           PeriodoContable?        @relation(fields: [periodoContableId], references: [id])  // ✅ AGREGADO
  
  // ========================================
  // RELACIONES INVERSAS
  // ========================================
  pagos                     PagoCuentaPorCobrar[]                        // Pagos recibidos
  detallesFlujoCaja         DetalleFlujoCajaProyectado[]                 // Proyección de flujo de caja
  letrasCambio              LetraCambio[]                                // Letras de cambio generadas
  asientosContables         AsientoContable[]                           // Relación inversa - Asientos generados

  // ========================================
  // ÍNDICES
  // ========================================
  @@index([empresaId, fechaVencimiento])
  @@index([clienteId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([esContado])
  @@index([esSaldoInicial])
  @@index([saldoPendiente])
  @@index([esGerencial])
  @@index([comprobanteElectronicoId])
  @@index([preFacturaId])
