// ============================================
// MODELO 2.5: Línea de Crédito
// ============================================

model LineaCredito {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  empresaId             BigInt
  bancoId               BigInt
  numeroLinea           String                  @db.VarChar(50)      // Número de línea de crédito
  
  // ========================================
  // TIPO DE LÍNEA
  // ========================================
  tipoLinea             TipoLineaCredito                             // REVOLVENTE | CARTA_CREDITO | GARANTIA_BANCARIA
  
  // ========================================
  // MONTOS
  // ========================================
  montoAprobado         Decimal                 @db.Decimal(18, 2)   // Monto total aprobado
  monedaId              BigInt
  
  // ========================================
  // CONDICIONES FINANCIERAS
  // ========================================
  tasaInteres           Decimal                 @db.Decimal(7, 4)    // Tasa de interés anual
  comisionMantenimiento Decimal?                @db.Decimal(18, 2)   // Comisión mensual
  comisionUtilizacion   Decimal?                @db.Decimal(7, 4)    // % sobre monto utilizado
  
  // ========================================
  // VIGENCIA
  // ========================================
  fechaAprobacion       DateTime                                     // Fecha de aprobación
  fechaVencimiento      DateTime                                     // Fecha de vencimiento
  
  // ========================================
  // SALDOS (Actualizados automáticamente)
  // ========================================
  montoUtilizado        Decimal                 @default(0.00) @db.Decimal(18, 2)  // Monto actualmente utilizado
  montoDisponible       Decimal                 @db.Decimal(18, 2)   // Monto disponible (aprobado - utilizado)
  
  estadoId              BigInt
  
  observaciones         String?                 @db.Text
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  banco                 Banco                   @relation(fields: [bancoId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  personalCreador       Personal?               @relation("LineaCreditoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("LineaCreditoActualizador", fields: [actualizadoPor], references: [id])
  
  prestamos             PrestamoBancario[]      // Préstamos que consumen esta línea
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([empresaId, numeroLinea])
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
}


// ============================================
// MODELO 2.7: Inversión Financiera
// ============================================

model InversionFinanciera {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  empresaId             BigInt
  bancoId               BigInt?                                      // Banco (si aplica)
  numeroInversion       String                  @db.VarChar(50)      // Número de inversión
  
  // ========================================
  // TIPO DE INVERSIÓN
  // ========================================
  tipoInversion         TipoInversion                                // PLAZO_FIJO | FONDO_MUTUO | BONOS | ACCIONES
  
  // ========================================
  // DESCRIPCIÓN
  // ========================================
  descripcion           String                  @db.VarChar(200)     // Descripción de la inversión
  
  // ========================================
  // FECHAS
  // ========================================
  fechaInversion        DateTime                                     // Fecha de inversión
  fechaVencimiento      DateTime?                                    // Fecha de vencimiento (si aplica)
  
  // ========================================
  // MONTOS
  // ========================================
  montoInvertido        Decimal                 @db.Decimal(18, 2)   // Monto inicial invertido
  monedaId              BigInt
  
  // ========================================
  // RENTABILIDAD
  // ========================================
  tasaRendimiento       Decimal?                @db.Decimal(7, 4)    // Tasa de rendimiento anual
  valorActual           Decimal                 @db.Decimal(18, 2)   // Valor actual de la inversión
  rendimientoAcumulado  Decimal                 @default(0.00) @db.Decimal(18, 2)  // Rendimiento acumulado
  
  // ========================================
  // ESTADO (EstadoMultiFuncion)
  // Valores posibles:
  // 90 = VIGENTE (inversión activa)
  // 91 = VENCIDA (plazo cumplido, pendiente de cobro)
  // 92 = LIQUIDADA (cobrada/vendida)
  // 93 = CANCELADA (cancelada antes de vencimiento)
  // ========================================
  estadoId              BigInt
  
  // ========================================
  // LIQUIDACIÓN
  // ========================================
  fechaLiquidacion      DateTime?                                    // Fecha de liquidación
  montoLiquidado        Decimal?                @db.Decimal(18, 2)   // Monto total liquidado
  movimientoCajaId      BigInt?                                      // Movimiento de liquidación
  asientoContableId     BigInt?                                      // Asiento de liquidación
  
  // ========================================
  // OBSERVACIONES
  // ========================================
  observaciones         String?                 @db.Text
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  banco                 Banco?                  @relation(fields: [bancoId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  asientoContable       AsientoContable?        @relation(fields: [asientoContableId], references: [id])
  personalCreador       Personal?               @relation("InversionCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("InversionActualizador", fields: [actualizadoPor], references: [id])
  
  movimientos           MovimientoInversion[]
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([empresaId, numeroInversion])
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([tipoInversion])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
}


// ============================================
// MODELO 2.8: Movimiento de Inversión
// ============================================

model MovimientoInversion {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // RELACIÓN CON INVERSIÓN
  // ========================================
  inversionFinancieraId BigInt
  
  // ========================================
  // TIPO DE MOVIMIENTO
  // ========================================
  tipoMovimiento        TipoMovimientoInversion                      // INVERSION | RENDIMIENTO | RETIRO | AJUSTE
  
  // ========================================
  // FECHA Y MONTO
  // ========================================
  fechaMovimiento       DateTime                                     // Fecha del movimiento
  monto                 Decimal                 @db.Decimal(18, 2)   // Monto del movimiento
  
  // ========================================
  // DESCRIPCIÓN
  // ========================================
  descripcion           String                  @db.Text             // Descripción del movimiento
  
  // ========================================
  // INTEGRACIÓN
  // ========================================
  movimientoCajaId      BigInt?                                      // Movimiento de caja asociado
  asientoContableId     BigInt?                                      // Asiento contable generado
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  
