  montoRetencion            Decimal     @default(0) @db.Decimal(18, 2)  // ✅ AGREGADO
  porcentajeRetencion       Decimal?    @db.Decimal(5, 2)            // ✅ AGREGADO
  numeroComprobanteRetencion String?    @db.VarChar(50)              // ✅ AGREGADO: Comprobante de retención
  fechaRetencion            DateTime?                                // ✅ AGREGADO: Fecha de retención
  
  // ========================================
