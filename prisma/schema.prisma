// ============================================
// LineaPresupuesto
// Línea de presupuesto por cuenta contable
// ============================================

model LineaPresupuesto {
  id                    BigInt      @id @default(autoincrement())
  presupuestoAnualId    BigInt
  
  // Cuenta contable
  cuentaContableId      BigInt
  
  // Centro de costo (opcional)
  centroCostoId         BigInt?
  
  // Montos mensuales
  montoEnero            Decimal     @default(0) @db.Decimal(18, 2)
  montoFebrero          Decimal     @default(0) @db.Decimal(18, 2)
  montoMarzo            Decimal     @default(0) @db.Decimal(18, 2)
  montoAbril            Decimal     @default(0) @db.Decimal(18, 2)
  montoMayo             Decimal     @default(0) @db.Decimal(18, 2)
  montoJunio            Decimal     @default(0) @db.Decimal(18, 2)
  montoJulio            Decimal     @default(0) @db.Decimal(18, 2)
  montoAgosto           Decimal     @default(0) @db.Decimal(18, 2)
  montoSetiembre        Decimal     @default(0) @db.Decimal(18, 2)
  montoOctubre          Decimal     @default(0) @db.Decimal(18, 2)
  montoNoviembre        Decimal     @default(0) @db.Decimal(18, 2)
  montoDiciembre        Decimal     @default(0) @db.Decimal(18, 2)
  
  observaciones         String?     @db.Text
  
  presupuestoAnual      PresupuestoAnual    @relation(fields: [presupuestoAnualId], references: [id], onDelete: Cascade)
  cuentaContable        PlanCuentasContable         @relation(fields: [cuentaContableId], references: [id])
  centroCosto           CentroCosto?        @relation(fields: [centroCostoId], references: [id])
  
  @@unique([presupuestoAnualId, cuentaContableId, centroCostoId])
  @@index([presupuestoAnualId])
  @@index([cuentaContableId])
  @@index([centroCostoId])
}

// ============================================
// EjecucionPresupuestal
// Vista consolidada de ejecución mensual
// Se calcula desde AsientoContable
// ============================================

model EjecucionPresupuestal {
  id                    BigInt      @id @default(autoincrement())
  
  empresaId             BigInt
  ejercicio             Int
  mes                   Int                             // 1-12
  cuentaContableId      BigInt
  centroCostoId         BigInt?
  
  // Montos
  montoPresupuestado    Decimal     @db.Decimal(18, 2)
  montoEjecutado        Decimal     @db.Decimal(18, 2)
  montoDiferencia       Decimal     @db.Decimal(18, 2)  // Presupuestado - Ejecutado
  porcentajeEjecucion   Decimal     @db.Decimal(5, 2)   // (Ejecutado / Presupuestado) * 100
  
  // Alertas
  sobregiro             Boolean     @default(false)     // true si ejecutado > presupuestado
  
  // Auditoría
  fechaCalculo          DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  
  empresa               Empresa         @relation(fields: [empresaId], references: [id])
  cuentaContable        PlanCuentasContable     @relation(fields: [cuentaContableId], references: [id])
  centroCosto           CentroCosto?    @relation(fields: [centroCostoId], references: [id])
  
  @@unique([empresaId, ejercicio, mes, cuentaContableId, centroCostoId])
  @@index([empresaId, ejercicio, mes])
  @@index([cuentaContableId])
  @@index([sobregiro])
}

model ConfiguracionCuentaContable {
  id                      BigInt    @id @default(autoincrement())
  empresaId               BigInt
  tipoMovimientoId        BigInt
  tipoReferenciaId        BigInt?
  
  // ✅ CORRECTO: Foreign Keys
  cuentaContableDebeId    BigInt
  cuentaContableHaberId   BigInt
  
  descripcionPlantilla    String?   @db.VarChar(200)
  activo                  Boolean?  @default(true)
  
  creadoEn                DateTime? @default(now())
  actualizadoEn           DateTime? @updatedAt
  creadoPorId             BigInt?
  actualizadoPorId        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa                 Empresa                      @relation("ConfiguracionCuentaContableEmpresa", fields: [empresaId], references: [id])
  tipoMovimiento          TipoMovEntregaRendir         @relation("ConfiguracionCuentaContableTipoMov", fields: [tipoMovimientoId], references: [id])
  tipoReferencia          TipoReferenciaMovimientoCaja? @relation("ConfiguracionCuentaContableTipoRef", fields: [tipoReferenciaId], references: [id])
  personalCreador         Personal?                    @relation("ConfiguracionCuentaContableCreadorId", fields: [creadoPorId], references: [id])
  personalActualizador    Personal?                    @relation("ConfiguracionCuentaContableActualizadorId", fields: [actualizadoPorId], references: [id])
  
  // ⭐ NUEVAS RELACIONES A PLAN DE CUENTAS
  cuentaDebe              PlanCuentasContable          @relation("CuentaDebe", fields: [cuentaContableDebeId], references: [id])
  cuentaHaber             PlanCuentasContable          @relation("CuentaHaber", fields: [cuentaContableHaberId], references: [id])
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([empresaId])
  @@index([tipoMovimientoId, tipoReferenciaId])
  @@index([cuentaContableDebeId])
  @@index([cuentaContableHaberId])
  @@unique([empresaId, tipoMovimientoId, tipoReferenciaId], name: "unique_config_cuenta")
}

// ============================================
// MÓDULO FINANCIERO - TESORERÍA AVANZADA
// MODELO 2.1: Préstamo Bancario
// ============================================

model PrestamoBancario {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  empresaId             BigInt
  bancoId               BigInt
  cuentaCorrienteId     BigInt?                                      // Cuenta donde se desembolsa/paga
  
    // ========================================
  // RELACIÓN CON LÍNEA DE CRÉDITO (NUEVO)
  // ========================================
  lineaCreditoId        BigInt?                 // FK a LineaCredito (nullable para préstamos directos)
    // ========================================
  // INTEGRACIÓN FINANCIERA (migrado de UtilizacionLineaCredito)
  // ========================================
  movimientoCajaDesembolsoId  BigInt?           // Movimiento de caja del desembolso
  asientoContableId           BigInt?           // Asiento contable del préstamo
  
    // ========================================
  // CAMPOS ESPECÍFICOS PARA GARANTÍAS/CARTAS (NUEVOS)
  // ========================================
  beneficiario          String?                 @db.VarChar(200)     // Para Garantías y Cartas de Crédito
  fechaEmision          DateTime?                                    // Para Garantías y Cartas de Crédito
  fechaExpiracion       DateTime?                                    // Para Garantías y Cartas de Crédito
  numeroGarantia        String?                 @db.VarChar(50)      // Para Garantías Bancarias
  numeroCartaCredito    String?                 @db.VarChar(50)      // Para Cartas de Crédito
  
  // ========================================
  // PARA LÍNEAS REVOLVENTES (NUEVO)
  // ========================================
  esRevolvente          Boolean                 @default(false)      // true si es línea revolvente
  permitePagoParcial    Boolean                 @default(false)      // true si permite pagos parciales


  // ========================================
  // NUMERACIÓN Y CONTRATO
  // ========================================
  numeroPrestamo        String                  @db.VarChar(50)      // Número interno del préstamo
  numeroContrato        String?                 @db.VarChar(50)      // Número de contrato del banco
  
  // ========================================
  // FECHAS CLAVE
  // ========================================
  fechaContrato         DateTime                                     // Fecha de firma del contrato
  fechaDesembolso       DateTime                                     // Fecha de desembolso real
  fechaVencimiento      DateTime                                     // Fecha de vencimiento final
  
  // ========================================
  // MONTOS PRINCIPALES
  // ========================================
  montoAprobado         Decimal                 @db.Decimal(18, 2)   // Monto aprobado por el banco
  montoDesembolsado     Decimal                 @db.Decimal(18, 2)   // Monto realmente desembolsado
  monedaId              BigInt
  
  // ========================================
  // CONDICIONES FINANCIERAS
  // ========================================
  tasaInteresAnual      Decimal                 @db.Decimal(7, 4)    // Tasa de interés anual (ej: 12.5000)
  tasaInteresEfectiva   Decimal?                @db.Decimal(7, 4)    // TEA (Tasa Efectiva Anual)
  tasaMoratoria         Decimal?                @db.Decimal(7, 4)    // Tasa de mora por atraso
  comisionInicial       Decimal?                @db.Decimal(18, 2)   // Comisión de apertura
  comisionMantenimiento Decimal?                @db.Decimal(18, 2)   // Comisión mensual de mantenimiento
  seguroDesgravamen     Decimal?                @db.Decimal(18, 2)   // Seguro de desgravamen mensual
  
  // ========================================
  // PLAZO Y ESTRUCTURA DE PAGOS
  // ========================================
  plazoMeses            Int                                          // Plazo total en meses
  numeroCuotas          Int                                          // Número total de cuotas
  frecuenciaPago        FrecuenciaPago                               // MENSUAL | TRIMESTRAL | SEMESTRAL | ANUAL
  numeroDias            Int?                                         // Nuevo: solo cuando frecuenciaPago = DIAS
  diaPago               Int?                                         // Día del mes para pago (1-31)
  periodoGracia         Int?                                         // Meses de gracia (solo intereses)
  
  // ========================================
  // TIPO Y CLASIFICACIÓN
  // ========================================
  tipoPrestamoId          BigInt                                 // CAPITAL_TRABAJO | ACTIVO_FIJO | HIPOTECARIO | VEHICULAR
  tipoAmortizacion      TipoAmortizacion                             // FRANCES | ALEMAN | AMERICANO
  destinoFondos         String?                 @db.Text             // Descripción del destino de los fondos
  refNroProformaVentaExportacion  String?       @db.VarChar(100)   // REFERENCIA A PROFORMA DE VENTA PARA COMERCIO EXTERIOR (GARANTIA)

  // ========================================
  // GARANTÍAS
  // ========================================
  tipoGarantia          TipoGarantia?                                // HIPOTECARIA | PRENDARIA | FIANZA | SIN_GARANTIA
  descripcionGarantia   String?                 @db.Text             // Descripción detallada de la garantía
  valorGarantia         Decimal?                @db.Decimal(18, 2)   // Valor tasado de la garantía
  
  // ========================================
  // SALDOS ACTUALES (Actualizados automáticamente)
  // ========================================
  saldoCapital          Decimal                 @db.Decimal(18, 2)   // Saldo pendiente de capital
  saldoInteres          Decimal                 @db.Decimal(18, 2)   // Intereses devengados pendientes
  capitalPagado         Decimal                 @default(0.00) @db.Decimal(18, 2)  // Capital ya pagado
  interesPagado         Decimal                 @default(0.00) @db.Decimal(18, 2)  // Intereses ya pagados
  
  estadoId              BigInt
  
  // ========================================
  // REFINANCIAMIENTO
  // ========================================
  esRefinanciamiento    Boolean                 @default(false)      // true si refinancia otro préstamo
  prestamoRefinanciadoId BigInt?                                     // ID del préstamo que refinancia
  
  observaciones         String?                 @db.Text
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  urlDocumentoPDF       String?                 @db.VarChar(500)
  urlDocAdicionalPDF    String?                 @db.VarChar(500)
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  banco                 Banco                   @relation(fields: [bancoId], references: [id])
  cuentaCorriente       CuentaCorriente?        @relation(fields: [cuentaCorrienteId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  personalCreador       Personal?               @relation("PrestamoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("PrestamoActualizador", fields: [actualizadoPor], references: [id])
  prestamoRefinanciado  PrestamoBancario?       @relation("RefinanciamientoPrestamo", fields: [prestamoRefinanciadoId], references: [id])
  prestamosRefinanciadores PrestamoBancario[]   @relation("RefinanciamientoPrestamo")
    // NUEVA RELACIÓN:
  lineaCredito          LineaCredito?           @relation(fields: [lineaCreditoId], references: [id])
    // AGREGAR ESTAS RELACIONES:
  movimientoCajaDesembolso  MovimientoCaja?   @relation("DesembolsoPrestamo", fields: [movimientoCajaDesembolsoId], references: [id])
  asientoContable           AsientoContable?  @relation("AsientoPrestamo", fields: [asientoContableId], references: [id])
  tipoPrestamo          TipoPrestamo            @relation("PrestamoBancarioTipoPrestamo", fields: [tipoPrestamoId], references: [id])

  cuotas                CuotaPrestamo[]
  desembolsos           DesembolsoPrestamo[]
  garantias             GarantiaPrestamo[]

  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([empresaId, numeroPrestamo])
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
  @@index([cuentaCorrienteId])
    // AGREGAR ESTOS ÍNDICES:
  @@index([lineaCreditoId])
  @@index([movimientoCajaDesembolsoId])
  @@index([asientoContableId])
  @@index([tipoPrestamoId])
  @@index([refNroProformaVentaExportacion])
}


// ============================================
// MODELO 2.2: Cuota de Préstamo
// ============================================

model CuotaPrestamo {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // RELACIÓN CON PRÉSTAMO
  // ========================================
  prestamoBancarioId    BigInt
  
  // ========================================
  // IDENTIFICACIÓN DE CUOTA
  // ========================================
  numeroCuota           Int                                          // 1, 2, 3, ..., n
  fechaVencimiento      DateTime                                     // Fecha de vencimiento de la cuota
  
  // ========================================
  // COMPOSICIÓN DE LA CUOTA
  // ========================================
  montoCapital          Decimal                 @db.Decimal(18, 2)   // Amortización de capital
  montoInteres          Decimal                 @db.Decimal(18, 2)   // Interés del período
  montoComision         Decimal?                @db.Decimal(18, 2)   // Comisión de mantenimiento
  montoSeguro           Decimal?                @db.Decimal(18, 2)   // Seguro de desgravamen
  montoTotal            Decimal                 @db.Decimal(18, 2)   // Total de la cuota
  
  // ========================================
  // SALDOS ANTES Y DESPUÉS DE LA CUOTA
  // ========================================
  saldoCapitalAntes     Decimal                 @db.Decimal(18, 2)   // Saldo de capital antes de pagar
  saldoCapitalDespues   Decimal                 @db.Decimal(18, 2)   // Saldo de capital después de pagar
  
  // ========================================
  // INFORMACIÓN DE PAGO
  // ========================================
  fechaPago             DateTime?                                    // Fecha real de pago
  montoPagado           Decimal?                @db.Decimal(18, 2)   // Monto realmente pagado
  montoMora             Decimal?                @db.Decimal(18, 2)   // Monto de mora por atraso
  movimientoCajaId      BigInt?                                      // Relación con MovimientoCaja
  asientoContableId     BigInt?                                      // Asiento contable generado
  
  // ========================================
  // ESTADO DE PAGO
  // ========================================
  estadoPago            EstadoPagoCuota                              // PENDIENTE | PAGADO | VENCIDO | PARCIAL
  diasMora              Int?                                         // Días de atraso
  
  // ========================================
  // OBSERVACIONES
  // ========================================
  observaciones         String?                 @db.Text
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  actualizadoEn         DateTime                @updatedAt
  
  // ========================================
  // RELACIONES
  // ========================================
  prestamo              PrestamoBancario        @relation(fields: [prestamoBancarioId], references: [id], onDelete: Cascade)
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  asientoContable       AsientoContable?        @relation(fields: [asientoContableId], references: [id])
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([prestamoBancarioId, numeroCuota])
  @@index([prestamoBancarioId])
  @@index([fechaVencimiento])
  @@index([estadoPago])
  @@index([fechaPago])
}


// ============================================
