// ============================================
// LineaPresupuesto
// Línea de presupuesto por cuenta contable
// ============================================

model LineaPresupuesto {
  id                    BigInt      @id @default(autoincrement())
  presupuestoAnualId    BigInt
  
  // Cuenta contable
  cuentaContableId      BigInt
  
  // Centro de costo (opcional)
  centroCostoId         BigInt?
  
  // Montos mensuales
  montoEnero            Decimal     @default(0) @db.Decimal(18, 2)
  montoFebrero          Decimal     @default(0) @db.Decimal(18, 2)
  montoMarzo            Decimal     @default(0) @db.Decimal(18, 2)
  montoAbril            Decimal     @default(0) @db.Decimal(18, 2)
  montoMayo             Decimal     @default(0) @db.Decimal(18, 2)
  montoJunio            Decimal     @default(0) @db.Decimal(18, 2)
  montoJulio            Decimal     @default(0) @db.Decimal(18, 2)
  montoAgosto           Decimal     @default(0) @db.Decimal(18, 2)
  montoSetiembre        Decimal     @default(0) @db.Decimal(18, 2)
  montoOctubre          Decimal     @default(0) @db.Decimal(18, 2)
  montoNoviembre        Decimal     @default(0) @db.Decimal(18, 2)
  montoDiciembre        Decimal     @default(0) @db.Decimal(18, 2)
  
  observaciones         String?     @db.Text
  
  presupuestoAnual      PresupuestoAnual    @relation(fields: [presupuestoAnualId], references: [id], onDelete: Cascade)
  cuentaContable        PlanCuentasContable         @relation(fields: [cuentaContableId], references: [id])
  centroCosto           CentroCosto?        @relation(fields: [centroCostoId], references: [id])
  
  @@unique([presupuestoAnualId, cuentaContableId, centroCostoId])
  @@index([presupuestoAnualId])
  @@index([cuentaContableId])
  @@index([centroCostoId])
}

// ============================================
// EjecucionPresupuestal
// Vista consolidada de ejecución mensual
// Se calcula desde AsientoContable
// ============================================

model EjecucionPresupuestal {
  id                    BigInt      @id @default(autoincrement())
  
  empresaId             BigInt
  ejercicio             Int
  mes                   Int                             // 1-12
  cuentaContableId      BigInt
  centroCostoId         BigInt?
  
  // Montos
  montoPresupuestado    Decimal     @db.Decimal(18, 2)
  montoEjecutado        Decimal     @db.Decimal(18, 2)
  montoDiferencia       Decimal     @db.Decimal(18, 2)  // Presupuestado - Ejecutado
  porcentajeEjecucion   Decimal     @db.Decimal(5, 2)   // (Ejecutado / Presupuestado) * 100
  
  // Alertas
  sobregiro             Boolean     @default(false)     // true si ejecutado > presupuestado
  
  // Auditoría
  fechaCalculo          DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  
  empresa               Empresa         @relation(fields: [empresaId], references: [id])
  cuentaContable        PlanCuentasContable     @relation(fields: [cuentaContableId], references: [id])
  centroCosto           CentroCosto?    @relation(fields: [centroCostoId], references: [id])
  
  @@unique([empresaId, ejercicio, mes, cuentaContableId, centroCostoId])
  @@index([empresaId, ejercicio, mes])
  @@index([cuentaContableId])
  @@index([sobregiro])
}

model ConfiguracionCuentaContable {
  id                      BigInt    @id @default(autoincrement())
  empresaId               BigInt
  tipoMovimientoId        BigInt
  
  // ✅ CORRECTO: Foreign Keys
  cuentaContableDebeId    BigInt
  cuentaContableHaberId   BigInt
  medioPagoId             BigInt?

  
  descripcionPlantilla    String?   @db.VarChar(200)
  activo                  Boolean?  @default(true)
  
  creadoEn                DateTime? @default(now())
  actualizadoEn           DateTime? @updatedAt
  creadoPorId             BigInt?
  actualizadoPorId        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa                 Empresa                      @relation("ConfiguracionCuentaContableEmpresa", fields: [empresaId], references: [id])
  tipoMovimiento          TipoMovEntregaRendir         @relation("ConfiguracionCuentaContableTipoMov", fields: [tipoMovimientoId], references: [id])
  personalCreador         Personal?                    @relation("ConfiguracionCuentaContableCreadorId", fields: [creadoPorId], references: [id])
  personalActualizador    Personal?                    @relation("ConfiguracionCuentaContableActualizadorId", fields: [actualizadoPorId], references: [id])
  medioPago               MedioPago?  @relation(fields: [medioPagoId], references: [id])

  // ⭐ NUEVAS RELACIONES A PLAN DE CUENTAS
  cuentaDebe              PlanCuentasContable          @relation("CuentaDebe", fields: [cuentaContableDebeId], references: [id])
  cuentaHaber             PlanCuentasContable          @relation("CuentaHaber", fields: [cuentaContableHaberId], references: [id])
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([empresaId])
  @@index([tipoMovimientoId, medioPagoId])
  @@index([cuentaContableDebeId])
  @@index([cuentaContableHaberId])
  @@unique([empresaId, tipoMovimientoId, medioPagoId], name: "unique_config_cuenta")
}

// ============================================
// MÓDULO FINANCIERO - TESORERÍA AVANZADA
// MODELO 2.1: Préstamo Bancario
// ============================================

model PrestamoBancario {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  empresaId             BigInt
  bancoId               BigInt
  cuentaCorrienteId     BigInt?                                      // Cuenta donde se desembolsa/paga
  
    // ========================================
  // RELACIÓN CON LÍNEA DE CRÉDITO (NUEVO)
  // ========================================
  lineaCreditoId        BigInt?                 // FK a LineaCredito (nullable para préstamos directos)
  sublineaCreditoId     BigInt?                 // 🆕 NUEVO: FK a SublineaCredito

    // ========================================
  // INTEGRACIÓN FINANCIERA (migrado de UtilizacionLineaCredito)
  // ========================================
  movimientoCajaDesembolsoId  BigInt?           // Movimiento de caja del desembolso
  
    // ========================================
  // CAMPOS ESPECÍFICOS PARA GARANTÍAS/CARTAS (NUEVOS)
  // ========================================
  beneficiario          String?                 @db.VarChar(200)     // Para Garantías y Cartas de Crédito
  fechaEmision          DateTime?                                    // Para Garantías y Cartas de Crédito
  fechaExpiracion       DateTime?                                    // Para Garantías y Cartas de Crédito
  numeroGarantia        String?                 @db.VarChar(50)      // Para Garantías Bancarias
  numeroCartaCredito    String?                 @db.VarChar(50)      // Para Cartas de Crédito
  
  // ========================================
  // PARA LÍNEAS REVOLVENTES (NUEVO)
  // ========================================
  esRevolvente          Boolean                 @default(false)      // true si es línea revolvente
  permitePagoParcial    Boolean                 @default(false)      // true si permite pagos parciales


  // ========================================
  // NUMERACIÓN Y CONTRATO
  // ========================================
  numeroPrestamo        String                  @db.VarChar(50)      // Número interno del préstamo
  numeroContrato        String?                 @db.VarChar(50)      // Número de contrato del banco
  
  // ========================================
  // FECHAS CLAVE
  // ========================================
  fechaContrato         DateTime                                     // Fecha de firma del contrato
  fechaDesembolso       DateTime                                     // Fecha de desembolso real
  fechaVencimiento      DateTime                                     // Fecha de vencimiento final
  tipoCambioAplicado    Decimal?                 @db.Decimal(7, 4)    // Tipo de cambio aplicado
  
  // ========================================
  // MONTOS PRINCIPALES
  // ========================================
  montoAprobado         Decimal                 @db.Decimal(18, 2)   // Monto aprobado por el banco
  montoDesembolsado     Decimal                 @db.Decimal(18, 2)   // Monto realmente desembolsado
  monedaId              BigInt
  
  // ========================================
  // CONDICIONES FINANCIERAS
  // ========================================
  tasaInteresAnual      Decimal                 @db.Decimal(10, 6)    // TNA - Tasa Nominal Anual (contractual, ej: 12.5000)
  tasaInteresEfectiva   Decimal?                @db.Decimal(10, 6)    // TCEA - Tasa Costo Efectivo Anual (para cálculos, incluye capitalización)
  tasaMoratoria         Decimal?                @db.Decimal(10, 6)    // Tasa de mora por atraso
  comisionInicial       Decimal?                @db.Decimal(18, 6)   // Comisión de apertura
  comisionMantenimiento Decimal?                @db.Decimal(18, 6)   // Comisión mensual de mantenimiento
  seguroDesgravamen     Decimal?                @db.Decimal(18, 6)   // Seguro de desgravamen mensual
  
  // ========================================
  // PLAZO Y ESTRUCTURA DE PAGOS
  // ========================================
  plazoMeses            Int                                          // Plazo total en meses
  numeroCuotas          Int                                          // Número total de cuotas
  frecuenciaPago        FrecuenciaPago                               // MENSUAL | TRIMESTRAL | SEMESTRAL | ANUAL
  numeroDias            Int?                                         // Nuevo: solo cuando frecuenciaPago = DIAS
  diaPago               Int?                                         // Día del mes para pago (1-31)
  periodoGracia         Int?                                         // Meses de gracia (solo intereses)
  
  // ========================================
  // TIPO Y CLASIFICACIÓN
  // ========================================
  tipoPrestamoId          BigInt                                 // CAPITAL_TRABAJO | ACTIVO_FIJO | HIPOTECARIO | VEHICULAR
  tipoAmortizacion      TipoAmortizacion                             // FRANCES | ALEMAN | AMERICANO
  destinoFondos         String?                 @db.Text             // Descripción del destino de los fondos
  refNroProformaVentaExportacion  String?       @db.VarChar(100)   // REFERENCIA A PROFORMA DE VENTA PARA COMERCIO EXTERIOR (GARANTIA)

  // ========================================
  // GARANTÍAS
  // ========================================
  tipoGarantia          TipoGarantia?                                // HIPOTECARIA | PRENDARIA | FIANZA | SIN_GARANTIA
  descripcionGarantia   String?                 @db.Text             // Descripción detallada de la garantía
  valorGarantia         Decimal?                @db.Decimal(18, 2)   // Valor tasado de la garantía
  
  // ========================================
  // SALDOS ACTUALES (Actualizados automáticamente)
  // ========================================
  saldoCapital          Decimal                 @db.Decimal(18, 2)   // Saldo pendiente de capital
  saldoInteres          Decimal                 @db.Decimal(18, 2)   // Intereses devengados pendientes
  capitalPagado         Decimal                 @default(0.00) @db.Decimal(18, 2)  // Capital ya pagado
  interesPagado         Decimal                 @default(0.00) @db.Decimal(18, 2)  // Intereses ya pagados
  
  estadoId              BigInt
  
  // ========================================
  // REFINANCIAMIENTO
  // ========================================
  esRefinanciamiento    Boolean                 @default(false)      // true si refinancia otro préstamo
  prestamoRefinanciadoId BigInt?                                     // ID del préstamo que refinancia
  
  observaciones         String?                 @db.Text
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  urlDocumentoPDF       String?                 @db.VarChar(500)
  urlDocAdicionalPDF    String?                 @db.VarChar(500)
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa                     Empresa                 @relation(fields: [empresaId], references: [id])
  banco                       Banco                   @relation(fields: [bancoId], references: [id])
  cuentaCorriente             CuentaCorriente?        @relation(fields: [cuentaCorrienteId], references: [id])
  moneda                      Moneda                  @relation(fields: [monedaId], references: [id])
  estado                      EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  personalCreador             Personal?               @relation("PrestamoCreador", fields: [creadoPor], references: [id])
  personalActualizador        Personal?               @relation("PrestamoActualizador", fields: [actualizadoPor], references: [id])
  prestamoRefinanciado        PrestamoBancario?       @relation("RefinanciamientoPrestamo", fields: [prestamoRefinanciadoId], references: [id])
  prestamosRefinanciadores    PrestamoBancario[]   @relation("RefinanciamientoPrestamo")
    // NUEVA RELACIÓN:
  lineaCredito                LineaCredito?           @relation(fields: [lineaCreditoId], references: [id])
  sublineaCredito             SublineaCredito?        @relation(fields: [sublineaCreditoId], references: [id])  // 🆕 NUEVO

    // AGREGAR ESTAS RELACIONES:
  movimientoCajaDesembolso    MovimientoCaja?   @relation("DesembolsoPrestamo", fields: [movimientoCajaDesembolsoId], references: [id])
  tipoPrestamo                TipoPrestamo            @relation("PrestamoBancarioTipoPrestamo", fields: [tipoPrestamoId], references: [id])

  cuotas                CuotaPrestamo[]
  garantias             GarantiaPrestamo[]
  pagosCuentaPorPagar   PagoCuentaPorPagar[]
  asientosContables     AsientoContable[]

  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([empresaId, numeroPrestamo])
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
  @@index([cuentaCorrienteId])
    // AGREGAR ESTOS ÍNDICES:
  @@index([lineaCreditoId])
  @@index([sublineaCreditoId])          // 🆕 NUEVO índice
  @@index([movimientoCajaDesembolsoId])
  @@index([tipoPrestamoId])
  @@index([refNroProformaVentaExportacion])
}


// ============================================
// MODELO 2.2: Cuota de Préstamo
// ============================================

model CuotaPrestamo {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // RELACIÓN CON PRÉSTAMO
  // ========================================
  prestamoBancarioId    BigInt
  
  // ========================================
  // IDENTIFICACIÓN DE CUOTA
  // ========================================
  numeroCuota           Int                                          // 1, 2, 3, ..., n
  fechaVencimiento      DateTime                                     // Fecha de vencimiento de la cuota
  
  // ========================================
  // COMPOSICIÓN DE LA CUOTA
  // ========================================
  montoCapital          Decimal                 @db.Decimal(18, 2)   // Amortización de capital
  montoInteres          Decimal                 @db.Decimal(18, 2)   // Interés del período
  montoComision         Decimal?                @db.Decimal(18, 2)   // Comisión de mantenimiento
  montoSeguro           Decimal?                @db.Decimal(18, 2)   // Seguro de desgravamen
  montoTotal            Decimal                 @db.Decimal(18, 2)   // Total de la cuota
  
  // ========================================
  // SALDOS ANTES Y DESPUÉS DE LA CUOTA
  // ========================================
  saldoCapitalAntes     Decimal                 @db.Decimal(18, 2)   // Saldo de capital antes de pagar
  saldoCapitalDespues   Decimal                 @db.Decimal(18, 2)   // Saldo de capital después de pagar
  
  // ========================================
  // INFORMACIÓN DE PAGO
  // ========================================
  fechaPago             DateTime?                                    // Fecha real de pago
  montoPagado           Decimal?                @db.Decimal(18, 2)   // Monto realmente pagado
  montoMora             Decimal?                @db.Decimal(18, 2)   // Monto de mora por atraso
  movimientoCajaId      BigInt?                                      // Relación con MovimientoCaja
  refOperacionEspecializadaMovCaja  BigInt?
  estadoPago            EstadoPagoCuota                              // PENDIENTE | PAGADO | VENCIDO | PARCIAL
  diasMora              Int?                                         // Días de atraso
  observaciones         String?                 @db.Text
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  prestamo              PrestamoBancario?       @relation(fields: [prestamoBancarioId], references: [id], onDelete: Cascade)
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  asientosContables     AsientoContable[]  // Relación inversa - Asientos generados

  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([prestamoBancarioId, numeroCuota])
  @@index([prestamoBancarioId])
  @@index([fechaVencimiento])
  @@index([estadoPago])
  @@index([fechaPago])
}



// ============================================
// MODELO 2.4: Garantía de Préstamo
// ============================================

model GarantiaPrestamo {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // RELACIÓN CON PRÉSTAMO
  // ========================================
  prestamoBancarioId    BigInt
  
  // ========================================
  // TIPO DE GARANTÍA
  // ========================================
  tipoGarantia          TipoGarantia                                 // HIPOTECARIA | PRENDARIA | FIANZA
  
  // ========================================
  // DESCRIPCIÓN
  // ========================================
  descripcion           String                  @db.Text             // Descripción detallada del bien
  valorTasacion         Decimal                 @db.Decimal(18, 2)   // Valor de tasación
  
  // ========================================
  // DATOS ESPECÍFICOS HIPOTECA
  // ========================================
  direccionInmueble     String?                 @db.VarChar(500)     // Dirección del inmueble
  partidaRegistral      String?                 @db.VarChar(100)     // Partida registral
  
  // ========================================
  // DATOS ESPECÍFICOS PRENDA
  // ========================================
  descripcionBien       String?                 @db.Text             // Descripción del bien prendado
  numeroSerie           String?                 @db.VarChar(100)     // Número de serie (vehículo, maquinaria)
  
  // ========================================
  // DATOS ESPECÍFICOS FIANZA
  // ========================================
  nombreFiador          String?                 @db.VarChar(200)     // Nombre del fiador
  documentoFiador       String?                 @db.VarChar(20)      // DNI/RUC del fiador
  
  // ========================================
  // ESTADO
  // ========================================
  activo                Boolean                 @default(true)       // true = vigente, false = liberada
  fechaLiberacion       DateTime?                                    // Fecha de liberación de garantía
  
  // ========================================
  // OBSERVACIONES
  // ========================================
  observaciones         String?                 @db.Text
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  actualizadoEn         DateTime                @updatedAt
  
  // ========================================
  // RELACIONES
  // ========================================
  prestamo              PrestamoBancario        @relation(fields: [prestamoBancarioId], references: [id], onDelete: Cascade)
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([prestamoBancarioId])
  @@index([tipoGarantia])
  @@index([activo])
}


// ============================================
// MODELO 2.5: Línea de Crédito
// ============================================

model LineaCredito {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACIÓN
  // ========================================
  empresaId             BigInt
  bancoId               BigInt
  // ========================================
  // MONTOS
  // ========================================
  montoAprobado         Decimal                 @db.Decimal(18, 2)   // Monto total aprobado
  monedaId              BigInt
  
  // ========================================
  // CONDICIONES FINANCIERAS
  // ========================================
  tasaInteres           Decimal                 @db.Decimal(7, 4)    // Tasa de interés anual base
  
  // ========================================
  // VIGENCIA
  // ========================================
  fechaAprobacion       DateTime                                     // Fecha de aprobación
  fechaVencimiento      DateTime                                     // Fecha de vencimiento
  
  // ========================================
  // SALDOS (Actualizados automáticamente)
  // ========================================
  montoUtilizado        Decimal                 @default(0.00) @db.Decimal(18, 2)  // Monto actualmente utilizado
  montoDisponible       Decimal                 @db.Decimal(18, 2)   // Monto disponible (aprobado - utilizado)
  
  estadoId              BigInt
  
  observaciones         String?                 @db.Text
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  
  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  banco                 Banco                   @relation(fields: [bancoId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  personalCreador       Personal?               @relation("LineaCreditoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("LineaCreditoActualizador", fields: [actualizadoPor], references: [id])
  
  prestamos             PrestamoBancario[]      // Préstamos que consumen esta línea
  sublineas             SublineaCredito[]       // 🆕 NUEVO: Sublíneas por tipo de préstamo
  
  // ========================================
  // ÍNDICES
  // ========================================
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
}

// ============================================
// MODELO 2.6: Sublínea de Crédito
// Subdivide una LineaCredito por TipoPrestamo
// Ejemplo: COMEX U$300k, Factoring U$375k, etc.
// ============================================

model SublineaCredito {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // RELACIÓN CON LÍNEA MAESTRA
  // ========================================
  lineaCreditoId        BigInt                  // 🆕 FK a LineaCredito
  
  // ========================================
  // TIPO DE SUBLÍNEA
  // ========================================
  tipoPrestamoId        BigInt                  // 🆕 FK a TipoPrestamo (COMEX, Factoring, Warrant, etc.)
  descripcion           String?                 @db.VarChar(200)     // 🆕 Descripción adicional opcional
  
  // ========================================
  // MONTOS ASIGNADOS
  // ========================================
  montoAsignado         Decimal                 @db.Decimal(18, 2)   // 🆕 Monto asignado a esta sublínea
  montoUtilizado        Decimal                 @default(0.00) @db.Decimal(18, 2)  // 🆕 Monto utilizado
  montoDisponible       Decimal                 @db.Decimal(18, 2)   // 🆕 Disponible = Asignado - Utilizado
  
  // ========================================
  // ESTADO
  // ========================================
  activo                Boolean                 @default(true)       // 🆕 Si la sublínea está activa
  observaciones         String?                 @db.Text             // 🆕 Observaciones
  excluirDeCalculo      Boolean                 @default(false)      // 🆕 Excluir esta sublínea del cálculo de totales

  // ========================================
  // AUDITORÍA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  lineaCredito          LineaCredito            @relation(fields: [lineaCreditoId], references: [id])
  tipoPrestamo          TipoPrestamo            @relation(fields: [tipoPrestamoId], references: [id])
  personalCreador       Personal?               @relation("SublineaCreditoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("SublineaCreditoActualizador", fields: [actualizadoPor], references: [id])
  
  prestamos             PrestamoBancario[]      // 🆕 Préstamos que consumen esta sublínea
  sobregiros          SobregiroAutorizado[]

  // ========================================
  // ÍNDICES Y CONSTRAINTS
  // ========================================
  @@unique([lineaCreditoId, tipoPrestamoId], name: "unique_sublinea_tipo")  // 🆕 Una sublínea por tipo en cada línea
  @@index([lineaCreditoId])
  @@index([tipoPrestamoId])
  @@index([activo])
}

model SobregiroAutorizado {
  id                      BigInt    @id @default(autoincrement())
  sublineaCreditoId       BigInt
  montoAutorizado         Decimal   @db.Decimal(18, 2)
  fechaSolicitud          DateTime  @default(now())
  fechaAprobacion         DateTime?
  autorizadoPorBanco      String?
  numeroAutorizacionBanco String?
  motivoSolicitud         String?   @db.Text
  creadoPor               BigInt?
  actualizadoPor          BigInt?
  creadoEn                DateTime  @default(now())
  actualizadoEn           DateTime  @updatedAt
  activo                  Boolean   @default(true)
  
  // Relaciones
  sublineaCredito         SublineaCredito @relation(fields: [sublineaCreditoId], references: [id])
  
  // Índices
  @@index([sublineaCreditoId])
  @@index([activo])
}

// ============================================
// MODELO 2.7: Inversión Financiera
// ============================================

model InversionFinanciera {
  id                    BigInt                  @id @default(autoincrement())
  empresaId             BigInt
  bancoId               BigInt?                                      // Banco (si aplica)
  numeroInversion       String                  @db.VarChar(50)      // Número de inversión
  tipoInversion         TipoInversion                                // PLAZO_FIJO | FONDO_MUTUO | BONOS | ACCIONES
  descripcion           String                  @db.VarChar(200)     // Descripción de la inversión
  fechaInversion        DateTime                                     // Fecha de inversión
  fechaVencimiento      DateTime?                                    // Fecha de vencimiento (si aplica)
  montoInvertido        Decimal                 @db.Decimal(18, 2)   // Monto inicial invertido
  monedaId              BigInt
  tasaRendimiento       Decimal?                @db.Decimal(7, 4)    // Tasa de rendimiento anual
  valorActual           Decimal                 @db.Decimal(18, 2)   // Valor actual de la inversión
  rendimientoAcumulado  Decimal                 @default(0.00) @db.Decimal(18, 2)  // Rendimiento acumulado
  estadoId              BigInt
  fechaLiquidacion      DateTime?                                    // Fecha de liquidación
  montoLiquidado        Decimal?                @db.Decimal(18, 2)   // Monto total liquidado
  movimientoCajaId      BigInt?                                      // Movimiento de liquidación
  observaciones         String?                 @db.Text
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  empresa               Empresa                 @relation(fields: [empresaId], references: [id])
  banco                 Banco?                  @relation(fields: [bancoId], references: [id])
  moneda                Moneda                  @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion      @relation(fields: [estadoId], references: [id])
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  personalCreador       Personal?               @relation("InversionCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("InversionActualizador", fields: [actualizadoPor], references: [id])
  movimientos           MovimientoInversion[]
  asientosContables     AsientoContable[]  // Relación inversa - Asientos generados

  // ========================================
  // ÍNDICES
  // ========================================
  @@unique([empresaId, numeroInversion])
  @@index([empresaId])
  @@index([bancoId])
  @@index([estadoId])
  @@index([tipoInversion])
  @@index([fechaVencimiento])
  @@index([empresaId, estadoId])
}


// ============================================
// MODELO 2.8: Movimiento de Inversión
// ============================================

model MovimientoInversion {
  id                    BigInt                  @id @default(autoincrement())
  inversionFinancieraId BigInt
  tipoMovimiento        TipoMovimientoInversion                      // INVERSION | RENDIMIENTO | RETIRO | AJUSTE
  fechaMovimiento       DateTime                                     // Fecha del movimiento
  monto                 Decimal                 @db.Decimal(18, 2)   // Monto del movimiento
  descripcion           String                  @db.Text             // Descripción del movimiento
  movimientoCajaId      BigInt?                                      // Movimiento de caja asociado
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  urlDocumentoPDF       String?                 @db.VarChar(500)    // URL del documento adicional

  inversion             InversionFinanciera     @relation(fields: [inversionFinancieraId], references: [id], onDelete: Cascade)
  movimientoCaja        MovimientoCaja?         @relation(fields: [movimientoCajaId], references: [id])
  personalCreador       Personal?               @relation(fields: [creadoPor], references: [id])
  asientosContables     AsientoContable[]       // Relación inversa - Asientos generados

  @@index([inversionFinancieraId])
  @@index([fechaMovimiento])
  @@index([tipoMovimiento])
}

// ============================================
// MODELO: TIPO DE PRESTAMO
// ============================================

model TipoPrestamo {
  id                    BigInt                  @id @default(autoincrement())
  
  // ========================================
  // IDENTIFICACION
  // ========================================
  descripcion           String                  @db.VarChar(200)             // DESCRIPCION DEL TIPO DE PRESTAMO
  descripcionCorta      String?                 @db.VarChar(100)             // DESCRIPCION CORTA PARA INTERFAZ DE USUARIO
  
  // ========================================
  // CARACTERISTICAS
  // ========================================
  requiereGarantia      Boolean                 @default(false)              // SI REQUIERE GARANTIA OBLIGATORIA
  esComercioExterior    Boolean                 @default(false)              // SI ES PARA COMERCIO EXTERIOR (COMEX)
  esLeasing             Boolean                 @default(false)              // SI ES TIPO LEASING
  esFactoring           Boolean                 @default(false)              // SI ES FACTORING
  permiteRefinanciar    Boolean                 @default(true)               // SI PERMITE SER REFINANCIADO
  
  // ========================================
  // CONFIGURACION INTERFAZ DE USUARIO
  // ========================================
  severityColor         String?                 @db.VarChar(20)              // COLOR PARA TAG EN INTERFAZ DE USUARIO (INFO, SUCCESS, WARNING, ETCETERA)
  
  // ========================================
  // ESTADO
  // ========================================
  activo                Boolean                 @default(true)               // SI ESTA ACTIVO PARA USAR
  
  // ========================================
  // AUDITORIA
  // ========================================
  creadoEn              DateTime                @default(now())
  creadoPor             BigInt?
  actualizadoEn         DateTime                @updatedAt
  actualizadoPor        BigInt?
  
  // ========================================
  // RELACIONES
  // ========================================
  personalCreador       Personal?               @relation("TipoPrestamoCreador", fields: [creadoPor], references: [id])
  personalActualizador  Personal?               @relation("TipoPrestamoActualizador", fields: [actualizadoPor], references: [id])
  
  prestamos             PrestamoBancario[]      @relation("PrestamoBancarioTipoPrestamo")
  sublineas             SublineaCredito[]       // 🆕 NUEVO: Sublíneas que usan este tipo

  // ========================================
  // INDICES
  // ========================================
  @@index([activo])
  @@index([esComercioExterior])
}


model UnidadNegocio {
  id                BigInt    @id @default(autoincrement())
  nombre            String    @db.VarChar(100)
  icono             String?   @db.VarChar(50)
  color             String?   @db.VarChar(20)
  activo            Boolean   @default(true)
  orden             Int       @default(0)
  fechaCreacion     DateTime  @default(now())
  fechaModificacion DateTime  @updatedAt
  centroCostoId     BigInt?   // 🆕 NUEVO: Centro de costo asociado a esta unidad de negocio

  
   // 🆕 AGREGAR ESTAS 8 RELACIONES INVERSAS:
  cotizacionesVentas       CotizacionVentas[]
  preFacturas              PreFactura[]
  requerimientosCompra     RequerimientoCompra[]
  ordenesCompra            OrdenCompra[]
  movimientosAlmacen       MovimientoAlmacen[]
  novedadesPescaConsumo    NovedadPescaConsumo[]
  temporadasPesca          TemporadaPesca[]
  contratosServicio        ContratoServicio[]
  centroCosto       CentroCosto? @relation(fields: [centroCostoId], references: [id])

  @@index([activo])
  @@index([centroCostoId]) // 🆕 Índice para el nuevo campo

}



// ============================================
// ENUMS PARA TESORERÍA AVANZADA
// ============================================

enum FrecuenciaPago {
  DIAS                  // Pagos diarios
  MENSUAL              // Pagos mensuales
  BIMESTRAL            // Cada 2 meses
  TRIMESTRAL           // Cada 3 meses
  CUATRIMESTRAL        // Cada 4 meses
  SEMESTRAL            // Cada 6 meses
  ANUAL                // Anual
}

enum TipoAmortizacion {
  FRANCES              // Cuotas fijas (más común)
  ALEMAN               // Amortización constante
  AMERICANO            // Solo intereses, capital al final
}

enum TipoGarantia {
  HIPOTECARIA          // Garantía hipotecaria
  PRENDARIA            // Garantía prendaria (vehículos, maquinaria)
  FIANZA               // Fianza personal o solidaria
  SIN_GARANTIA         // Sin garantía específica
}

enum EstadoPagoCuota {
  PENDIENTE            // Cuota pendiente de pago
  PAGADO               // Cuota pagada completamente
  VENCIDO              // Cuota vencida no pagada
  PARCIAL              // Cuota pagada parcialmente
}

enum TipoLineaCredito {
  REVOLVENTE           // Línea revolvente (se puede usar y devolver)
  CARTA_CREDITO        // Carta de crédito (comercio exterior)
  GARANTIA_BANCARIA    // Garantía bancaria
  SOBREGIRO            // Sobregiro bancario
}

enum TipoInversion {
  PLAZO_FIJO           // Depósito a plazo fijo
  FONDO_MUTUO          // Fondo mutuo
  BONOS                // Bonos corporativos o soberanos
  ACCIONES             // Acciones en bolsa
  CTS                  // CTS empresarial
}

enum TipoMovimientoInversion {
  INVERSION            // Inversión inicial o adicional
  RENDIMIENTO          // Rendimiento generado
  RETIRO               // Retiro parcial
  AJUSTE               // Ajuste de valor
  LIQUIDACION          // Liquidación total
}

enum TipoTasa {
  EFECTIVA_ANUAL       // Tasa efectiva anual (TEA)
  NOMINAL_ANUAL        // Tasa nominal anual (TNA)
  EFECTIVA_MENSUAL     // Tasa efectiva mensual (TEM)
  NOMINAL_MENSUAL      // Tasa nominal mensual (TNM)
  EFECTIVA_DIARIA      // Tasa efectiva diaria (TED)
}

enum PeriodicidadRendimiento {
  VENCIMIENTO          // Pago al vencimiento
  DIARIA               // Capitalizacion diaria
  SEMANAL              // Capitalizacion semanal
  QUINCENAL            // Capitalizacion quincenal
  MENSUAL              // Capitalizacion mensual
  BIMESTRAL            // Capitalizacion bimestral
  TRIMESTRAL           // Capitalizacion trimestral
  CUATRIMESTRAL        // Capitalizacion cuatrimestral
  SEMESTRAL            // Capitalizacion semestral
  ANUAL                // Capitalizacion anual
}

enum TipoDesembolso {
  TOTAL                // Desembolso total del prestamo
  PARCIAL              // Desembolso parcial
  PROGRAMADO           // Desembolso segun cronograma
}

enum TipoGarantiaReal {
  INMUEBLE             // Garantia inmobiliaria
  VEHICULO             // Garantia vehicular
  MAQUINARIA           // Garantia de maquinaria
  INVENTARIO           // Garantia de inventario
  CUENTAS_COBRAR       // Garantia de cuentas por cobrar
  DEPOSITO_PLAZO       // Garantia de deposito a plazo
  VALORES              // Garantia de valores mobiliarios
  OTROS                // Otras garantias reales
}

enum EstadoGarantia {
  VIGENTE              // Garantia vigente
  LIBERADA             // Garantia liberada
  EJECUTADA            // Garantia ejecutada
  VENCIDA              // Garantia vencida
  RENOVADA             // Garantia renovada
}

enum TipoCobro {
  CUOTA_NORMAL         // Cobro de cuota normal
  PREPAGO_PARCIAL      // Prepago parcial del prestamo
  PREPAGO_TOTAL        // Prepago total del prestamo
  MORA                 // Cobro de mora
  COMISION             // Cobro de comision
  SEGURO               // Cobro de seguro
}

enum MetodoPago {
  EFECTIVO             // Pago en efectivo
  TRANSFERENCIA        // Transferencia bancaria
  CHEQUE               // Pago con cheque
  DEBITO_AUTOMATICO    // Debito automatico
  TARJETA_CREDITO      // Tarjeta de credito
  TARJETA_DEBITO       // Tarjeta de debito
}

enum EstadoDesembolso {
  PENDIENTE            // Desembolso pendiente
  PROCESADO            // Desembolso procesado
  CONFIRMADO           // Desembolso confirmado
  RECHAZADO            // Desembolso rechazado
  ANULADO              // Desembolso anulado
}

enum TipoRenovacion {
  AUTOMATICA           // Renovacion automatica
  MANUAL               // Renovacion manual
  SIN_RENOVACION       // Sin renovacion
}