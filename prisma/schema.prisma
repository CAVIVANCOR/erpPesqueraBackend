  monedaPagoId          BigInt                                       // 🔄 RENOMBRADO: Moneda en que se paga (PEN, USD, EUR)
  tipoCambio            Decimal     @db.Decimal(10, 4)              // Tipo de cambio del día de pago
  
  // ========================================
  // APLICACIÓN A LA DEUDA (conversión)
  // ========================================
