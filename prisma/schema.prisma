// ============================================
// PresupuestoAnual
// Presupuesto maestro anual
// ============================================

model PresupuestoAnual {
  id                    BigInt      @id @default(autoincrement())
  
  empresaId             BigInt
  ejercicio             Int                             // 2024, 2025
  nombre                String      @db.VarChar(100)    // "Presupuesto 2024"
  descripcion           String?     @db.Text
  
  // Moneda base
  monedaId              BigInt
  
  // Estado
  estadoId              BigInt                          // BORRADOR, APROBADO, CERRADO
  
  // Aprobación
  aprobadoPor           BigInt?
  fechaAprobacion       DateTime?
  
  observaciones         String?     @db.Text
  
  // Auditoría
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  creadoPor             BigInt?
  
  // Relaciones
  empresa               Empresa             @relation(fields: [empresaId], references: [id])
  moneda                Moneda              @relation(fields: [monedaId], references: [id])
  estado                EstadoMultiFuncion  @relation(fields: [estadoId], references: [id])
  aprobador             Personal?           @relation(fields: [aprobadoPor], references: [id])
  
  lineas                LineaPresupuesto[]
  
  @@unique([empresaId, ejercicio])
  @@index([empresaId, ejercicio])
  @@index([estadoId])
