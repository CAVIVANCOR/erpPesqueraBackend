// ============================================
// ConciliacionBancaria
// Conciliación mensual de cuentas bancarias
// Compara MovimientoCaja vs Estado de Cuenta Banco
// ============================================

model ConciliacionBancaria {
  id                    BigInt      @id @default(autoincrement())
  empresaId             BigInt
  cuentaCorrienteId     BigInt
  periodo               String      @db.VarChar(7)      // YYYY-MM
  fechaConciliacion     DateTime    @default(now())
  
  saldoInicialLibros    Decimal     @db.Decimal(18, 2)
  saldoFinalLibros      Decimal     @db.Decimal(18, 2)
  saldoInicialBanco     Decimal     @db.Decimal(18, 2)
  saldoFinalBanco       Decimal     @db.Decimal(18, 2)
  
  estadoId              BigInt      // PROCESO, CONCILIADO, CERRADO
  conciliadoPor         BigInt?
  observaciones         String?     @db.Text
  
  creadoEn              DateTime    @default(now())
  actualizadoEn         DateTime    @updatedAt
  
