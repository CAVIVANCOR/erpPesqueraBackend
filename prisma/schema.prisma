  flujoCajaProyectadoId BigInt
  fecha                 DateTime
  tipoMovimiento        String      @db.VarChar(10)     // INGRESO, EGRESO
  concepto              String      @db.VarChar(200)
  monto                 Decimal     @db.Decimal(18, 2)
