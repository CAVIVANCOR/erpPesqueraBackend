  puedeCrear         Boolean          @default(false)
  puedeEditar        Boolean          @default(false)
  puedeEliminar      Boolean          @default(false)
  puedeReactivarDocs Boolean          @default(false)
  puedeAprobarDocs   Boolean          @default(false)
  puedeRechazarDocs  Boolean          @default(false)
  
  // ========================================
  // PERMISOS ESPECÍFICOS CONTABILIDAD (NUEVO)
  // ========================================
  accesoLibroFiscal     Boolean       @default(false)      // ✅ NOT NULL con default
  accesoLibroGerencial  Boolean       @default(false)      // ✅ NOT NULL con default
  
