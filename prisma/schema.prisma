  // ========================================
  // tieneDetraccion              Boolean     @default(false)                 ELIMINADO
  // montoDetraccion              Decimal     @default(0) @db.Decimal(18, 2)  ELIMINADO
  // porcentajeDetraccion         Decimal?    @db.Decimal(5, 2)               ELIMINADO
  // numeroConstanciaDetraccion   String?     @db.VarChar(50)                 ELIMINADO
